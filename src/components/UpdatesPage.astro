---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PlaceholderArt from './PlaceholderArt.astro';
import Arrow from './Arrow.astro';
import { UPDATES, UPDATES_COPY } from '../lib/updates';
import { getPhone } from '../lib/phones';
import { localePath, type Locale } from '../lib/locales';
import { t } from '../lib/ui-strings';
const { locale } = Astro.props as { locale: Locale };
const copy = UPDATES_COPY[locale];
const strings = t(locale);
const entries = await Promise.all(UPDATES.map(async entry => ({ ...entry, phones:await Promise.all(entry.phones.map(async slug => { const phone=await getPhone(locale,slug); if(!phone)throw new Error('Missing update phone '+slug); return {slug,data:phone.data}; })) })));
const dateLabel = (date:string) => new Intl.DateTimeFormat(locale === 'uk' ? 'uk-UA' : locale === 'ru' ? 'ru-RU' : 'en-GB', {dateStyle:'long',timeZone:'UTC'}).format(new Date(date+'T12:00:00Z'));
---
<Layout locale={locale} path="/updates/" title={copy.title+' — '+strings.siteName} description={copy.intro}>
  <Breadcrumbs locale={locale} items={[{label:strings.breadcrumbs.home,path:'/'},{label:copy.title}]} />
  <header class="mb-8 max-w-3xl border-b border-neutral-800 pb-6"><p class="editorial-kicker text-orange-500">{copy.edition}</p><h1 class="page-title mt-3">{copy.title}</h1><p class="mt-4 text-lg leading-relaxed text-neutral-300">{copy.intro}</p><p class="mt-3 text-sm text-neutral-500">{copy.note}</p></header>
  {entries.map(entry=><section class="update-entry mb-10 border-t border-neutral-700 pt-6" aria-label={dateLabel(entry.date)}>
    <time datetime={entry.date} class="text-lg font-bold tabular-nums text-orange-500">{dateLabel(entry.date)}</time>
    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_2fr]">
      <div><h2 class="text-xl font-bold">{copy.changes}</h2><ul class="mt-4 grid gap-4 text-sm leading-relaxed text-neutral-300">{entry.changes[locale].map(change=><li class="border-l-2 border-orange-500 pl-3">{change}</li>)}</ul></div>
      <div><h2 class="mb-4 text-xl font-bold">{copy.additions} <span class="text-neutral-500">· {entry.phones.length}</span></h2>
      <ul class="grid gap-3 sm:grid-cols-2">{entry.phones.map(phone=><li><a class="update-phone flex h-full min-w-0 items-center gap-3 rounded-sm border border-neutral-800 bg-neutral-900/40 p-3" href={localePath(locale,'/phones/'+phone.slug+'/')}>
        <div class="relative flex h-20 w-16 shrink-0 items-center justify-center">{phone.data.image ? <><img src={phone.data.image} alt="" data-image-fallback loading="lazy" class="h-full w-full object-contain" /><div data-image-fallback-placeholder class="absolute inset-0 hidden items-center justify-center"><PlaceholderArt class="h-full w-full text-neutral-600" /></div></> : <PlaceholderArt class="h-full w-full text-neutral-600" />}</div>
        <div class="min-w-0"><p class="text-xs text-neutral-500">{phone.data.brand} · {phone.data.year}</p><h3 class="mt-1 font-bold">{phone.data.model}</h3><p class="mt-1 text-xs leading-relaxed text-neutral-400">{phone.data.milestone}</p></div><Arrow class="ml-auto shrink-0 text-orange-500" />
      </a></li>)}</ul></div>
    </div>
  </section>)}
</Layout>
