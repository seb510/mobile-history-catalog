---
import { ACCOUNT_COPY, COLLECTION_COPY } from '../lib/ownership-copy';
import { localePath, type Locale } from '../lib/locales';

const { locale, mobile = false } = Astro.props as { locale: Locale; mobile?: boolean };
const label = COLLECTION_COPY[locale].signIn;
const signedIn = ACCOUNT_COPY[locale].signedIn;
---

<a data-collection-sign-in hidden class:list={['account-shortcut', mobile && 'account-shortcut-mobile']} href={`/api/collection/login?lang=${locale}`} aria-label={label} title={label}>
  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4M4 12h11m-4-4 4 4-4 4"/></svg>
  <span>Google</span>
</a>
<a data-collection-account-link hidden class:list={['account-shortcut', mobile && 'account-shortcut-mobile']} href={localePath(locale, '/favorites/#collection-account-title')} aria-label={signedIn} title={signedIn}>
  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-4-7m-7 6 3 3 8-8"/></svg>
  <span>Google</span>
</a>

<style>
  .account-shortcut {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    min-height: 2.25rem;
    padding-inline: .375rem;
    border: 1px solid var(--color-neutral-800);
    border-radius: .25rem;
    color: var(--color-orange-500);
    font-size: .75rem;
    font-weight: 650;
    white-space: nowrap;
  }
  .account-shortcut[hidden] { display: none; }
  .account-shortcut-mobile { min-height: 2.75rem; padding-inline: .5rem; }
  @media (hover: hover) and (pointer: fine) {
    .account-shortcut:hover { border-color: var(--color-orange-500); }
  }
</style>
