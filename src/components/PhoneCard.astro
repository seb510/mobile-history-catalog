---
import { PHONE_VIDEOS, PHONE_VIDEO_LABELS } from '../lib/phone-videos';
import PlaceholderArt from './PlaceholderArt.astro';
import type { CollectionEntry } from 'astro:content';
import { localePath, type Locale } from '../lib/locales';
import { slugOf, isRecentlyAdded } from '../lib/phones';
import { buildSpecGroups } from '../lib/specs';
import { t } from '../lib/ui-strings';

interface Props {
  phone: CollectionEntry<'phones'>;
  locale: Locale;
  /** Optional corner tag, e.g. "126 млн шт." for the homepage's best-sellers section. */
  badge?: string;
  compact?: boolean;
  showcase?: boolean;
}
const { phone, locale, badge, compact = false, showcase = false } = Astro.props;
const { data } = phone;
const strings = t(locale);
const slug = slugOf(phone);
const isNew = isRecentlyAdded(data.dateAdded);
const showcaseRows = showcase ? buildSpecGroups(data, strings).flatMap(group => group.rows).filter(([label]) => new Set<string>([strings.specs.formFactor, strings.specs.display, strings.specs.weight]).has(label)) : [];
const showcaseAction = {uk:'Роздивитися модель',ru:'Рассмотреть модель',en:'Explore the model'}[locale];
const searchKey = `${data.brand} ${data.model}`.toLowerCase();
---

<div class="relative flex min-w-0 flex-1 self-stretch">
<a
  href={localePath(locale, `/phones/${slug}/`)}
  data-phone-card
  data-slug={slug}
  data-brand={data.brand}
  data-year={data.year}
  data-form={data.formFactor}
  data-video={PHONE_VIDEOS[slug] ? "true" : undefined}
  data-search={searchKey}
  class:list={['editorial-card group flex min-w-0 flex-1 flex-col overflow-hidden rounded-sm border border-neutral-800 bg-neutral-900 motion-ui', compact && 'catalog-card']}
>
  <div class="phone-card-art relative flex aspect-[4/3] shrink-0 items-center justify-center overflow-hidden border-b border-neutral-800 bg-neutral-800 p-5">
    {data.image ? (
      <>
        <img data-image-fallback src={data.image} alt={`${data.brand} ${data.model}`} class="relative h-full w-full object-contain" loading="lazy" decoding="async" />
        <div data-image-fallback-placeholder class="absolute inset-0 hidden flex items-center justify-center p-3">
          <PlaceholderArt class="h-full w-full text-neutral-600" />
        </div>
      </>
    ) : (
      <PlaceholderArt class="h-full w-full text-neutral-600" />
    )}
    {PHONE_VIDEOS[slug] && <span class="phone-video-badge absolute bottom-2 right-2 inline-flex items-center gap-1 rounded-sm border border-neutral-600 bg-neutral-950 px-2 py-1 text-[0.65rem] font-semibold text-neutral-200" title={PHONE_VIDEO_LABELS[locale].available}><svg aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="16" height="14" rx="2"/><path d="m8 7 5 3-5 3Z"/></svg><span aria-hidden="true">{PHONE_VIDEO_LABELS[locale].badge}</span><span class="sr-only">{PHONE_VIDEO_LABELS[locale].available}</span></span>}
    {badge ? (
      <span class="absolute left-2 top-2 rounded bg-orange-500 px-1.5 py-0.5 text-xs font-semibold text-neutral-950">
        {badge}
      </span>
    ) : isNew && (
      <span class="absolute left-2 top-2 rounded bg-orange-500 px-1.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-neutral-950">
        {strings.newBadge}
      </span>
    )}
  </div>
  <div class="card-copy flex min-h-32 flex-1 flex-col gap-1 p-4 sm:p-5">
    <p class="editorial-kicker flex items-baseline justify-between gap-2 text-neutral-500"><span>{data.brand}</span><span class="tabular-nums">{data.year}</span></p>
    <p class="card-title mt-1 text-xl font-extrabold leading-tight tracking-tight">{data.model}</p>
    {data.milestone && (
      <p class="mt-1 line-clamp-2 border-l-2 border-orange-500/60 pl-2 text-sm text-neutral-400">{data.milestone}</p>
    )}
    {showcase && <>
      <dl class="mt-4 grid gap-3 border-t border-neutral-700 pt-4 sm:grid-cols-3">{showcaseRows.map(([label,value])=><div class="min-w-0"><dt class="text-xs text-neutral-500">{label}</dt><dd class="mt-1 text-sm font-semibold leading-relaxed text-neutral-200">{value}</dd></div>)}</dl>
      <span class="mt-4 inline-flex min-h-11 items-center gap-3 text-sm font-semibold text-orange-500">{showcaseAction}<span aria-hidden="true">→</span></span>
    </>}
    {!compact && data.priceUsdAtLaunch != null && data.priceSourceUrl && (
      <p class="mt-auto flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 border-t border-neutral-800 pt-3 text-xs text-neutral-400">
        <span>{strings.specs.priceUsdAtLaunch}{data.priceContext && <span class="mt-1 block text-xs font-normal">{data.priceContext}</span>}</span>
        <span class="text-sm font-semibold tabular-nums text-neutral-200">${data.priceUsdAtLaunch} USD</span>
      </p>
    )}
  </div>
</a>
  <button
    type="button"
    data-favorite-toggle
    data-slug={slug}
    data-label-add={strings.favorites.add}
    data-label-remove={strings.favorites.remove}
    aria-pressed="false"
    aria-label={strings.favorites.add}
    class="favorite-toggle favorite-toggle-icon absolute right-2 top-2 z-10 flex h-11 w-11 items-center justify-center rounded-full border border-neutral-700 bg-neutral-950/80 text-neutral-200 backdrop-blur-sm motion-ui hover-desktop:border-orange-500 hover-desktop:text-orange-500"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 2.5h8a2 2 0 0 1 2 2v15a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-15a2 2 0 0 1 2-2Z M10 5h4 M10 12l2 2 4-4 M11 18h2" />
    </svg>
  </button>
</div>
