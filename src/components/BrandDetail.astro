---
import Arrow from './Arrow.astro';
import EvolutionIcon from './EvolutionIcon.astro';
import BrandMark from './BrandMark.astro';
import PhoneCard from './PhoneCard.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getPhonesForLocale } from '../lib/phones';
import { CATALOG_POSITION, t } from '../lib/ui-strings';
import { localePath, type Locale } from '../lib/locales';
import { slugOf } from '../lib/phones';
import BrandComparison from './BrandComparison.astro';
import { BRAND_NOTES, BRAND_OFFICIAL_SITES, BRAND_PAGE } from '../lib/brand-editorial';
import PhoneStartupAudio from './PhoneStartupAudio.astro';
import { PHONE_STARTUP_SOUNDS } from '../lib/phone-sounds';
import EvolutionScene from './EvolutionScene.astro';
import { evolutionCopy, evolutionStops, type EvolutionFrame } from '../lib/evolution';

interface Props {
  brand: CollectionEntry<'brands'>;
  locale: Locale;
}
const { brand, locale } = Astro.props;
const { data } = brand;
const strings = t(locale);
const editorial = BRAND_PAGE[locale];
const officialSite = BRAND_OFFICIAL_SITES[data.name];
const { Content } = await render(brand);
const startupSound = PHONE_STARTUP_SOUNDS[data.name];
if (startupSound && !officialSite) throw new Error(`Startup audio requires an official brand or successor link: ${data.name}`);

const phones = (await getPhonesForLocale(locale)).filter((p) => p.data.brand === data.name).sort((a, b) => a.data.year - b.data.year);
const phonesByYear = Map.groupBy(phones, (phone) => phone.data.year);
const yearIndex = CATALOG_POSITION[locale];
const brandEvolution: EvolutionFrame[] = phones.map((entry) => {
  const phone = entry.data;
  const slug = slugOf(entry);
  const curated = evolutionStops.find((stop) => stop.slug === slug)?.copy[locale];
  return { slug, phone, label: curated?.[0], description: curated?.[1] ?? phone.milestone ?? phone.os ?? (phone.formFactor ? strings.formFactors[phone.formFactor] : undefined) };
});
const first = phones[0];
const last = phones.at(-1);
const yearRange = first && last ? first.data.year === last.data.year ? String(first.data.year) : `${first.data.year}–${last.data.year}` : '—';
const forms = [...new Set(phones.flatMap(phone => phone.data.formFactor ? [phone.data.formFactor] : []))];
const phoneCountText = (count: number) => {
  const forms = strings.brands.phoneCount;
  if (locale === 'en') return count === 1 ? forms.one : forms.many;
  const lastTwo = count % 100;
  const last = count % 10;
  if (last === 1 && lastTwo !== 11) return forms.one;
  if (last >= 2 && last <= 4 && (lastTwo < 12 || lastTwo > 14)) return 'few' in forms ? forms.few : forms.many;
  return forms.many;
};
---

<div>
  <header class="brand-header grid gap-6 border-b border-neutral-800 pb-7 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-center lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-10">
    <div>
      <BrandMark name={data.name} logo={data.logo} class="min-h-24 w-full max-w-xs px-6 py-6" />
      {data.logoCredit && (
        <p class="mt-2 max-w-xs text-xs leading-relaxed text-neutral-500">
          {data.logoSourceUrl ? (
            <a href={data.logoSourceUrl} class="text-orange-500 underline decoration-current/45 underline-offset-2 transition-colors motion-ui hover-desktop:text-orange-400" target="_blank" rel="noopener noreferrer nofollow">
              {data.logoCredit}
            </a>
          ) : (
            data.logoCredit
          )}
        </p>
      )}
    </div>

    <div>
      <p class="editorial-kicker mb-2 text-orange-500">{strings.nav.brands}</p>
      <h1 class="page-title">{data.name}</h1>
      <div class="mt-5 grid grid-cols-3 gap-2">
        {data.founded != null && (
          <div class="brand-fact min-w-0 border-l-2 border-orange-500/70 bg-neutral-900/50 px-3 py-2">
            <p class="text-xs tracking-wide text-neutral-500 uppercase">{strings.brands.founded}</p>
            <p class="mt-1 font-semibold text-neutral-100">{data.founded}</p>
          </div>
        )}
        {data.country && (
          <div class="brand-fact min-w-0 border-l-2 border-neutral-700 bg-neutral-900/50 px-3 py-2">
            <p class="text-xs tracking-wide text-neutral-500 uppercase">{strings.brands.country}</p>
            <p class="mt-1 font-semibold text-neutral-100">{data.country}</p>
          </div>
        )}
        <div class="brand-fact min-w-0 border-l-2 border-neutral-700 bg-neutral-900/50 px-3 py-2">
          <p class="text-xs tracking-wide text-neutral-500 uppercase">{strings.nav.catalog}</p>
          <p class="mt-1 font-semibold text-neutral-100">{phones.length} {phoneCountText(phones.length)}</p>
        </div>
      </div>
      {officialSite && <div class="mt-4">
        <p class="text-xs tracking-wide text-neutral-500 uppercase">
          {officialSite.kind === 'licensee' ? editorial.officialLicensee : officialSite.kind === 'successor' ? editorial.officialSuccessor : editorial.officialSite}
        </p>
        <a
          class="mt-1 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-orange-500 underline decoration-current/45 underline-offset-4 transition-colors motion-ui hover-desktop:text-orange-400"
          href={officialSite.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {officialSite.name[locale]}<Arrow direction="up-right" />
        </a>
        <p class="max-w-2xl text-xs leading-relaxed text-neutral-500">{officialSite.note[locale]}</p>
      </div>}
    </div>
  </header>

  {startupSound && (
    <div class="mt-4">
      <PhoneStartupAudio locale={locale} brand={data.name} sound={startupSound} />
    </div>
  )}

  <div class="brand-overview mt-7 grid gap-6 lg:gap-8">
    <article class="min-w-0" aria-labelledby="brand-about">
      <h2 id="brand-about" class="mb-4 text-xl font-bold">{editorial.about}</h2>
      <div class="brand-about-copy prose prose-invert max-w-none prose-p:text-neutral-300"><Content /></div>
    </article>
    <aside class:list={['brand-archive-panel', phones.length === 1 && 'brand-archive-single']} aria-labelledby="brand-archive">
      <div class="brand-archive-summary">
        <div class="min-w-0">
          <h2 id="brand-archive" class="text-lg font-bold">{editorial.selection}</h2>
          <p class="mt-1 max-w-prose text-sm leading-relaxed text-neutral-300">{BRAND_NOTES[locale][data.name]}</p>
        </div>
        {first && <a class="brand-archive-all control-button text-sm font-semibold" href="#brand-collection">{editorial.all}<Arrow direction="down" /></a>}
      </div>
      <div class="brand-archive-years">
        <dl class="brand-archive-range">
          <dt class="text-xs text-neutral-500">{editorial.range}</dt>
          <dd class="mt-1 text-2xl font-bold tabular-nums">{yearRange}</dd>
        </dl>
        {first && <div class="brand-archive-models">
          <a class="brand-archive-link" href={localePath(locale, `/phones/${slugOf(first)}/`)}><span class="text-xs font-normal text-neutral-500">{editorial.first}</span><span>{first.data.model} <span class="font-normal text-neutral-400">· {first.data.year}</span></span></a>
          {last && slugOf(last) !== slugOf(first) && <a class="brand-archive-link" href={localePath(locale, `/phones/${slugOf(last)}/`)}><span class="text-xs font-normal text-neutral-500">{editorial.last}</span><span>{last.data.model} <span class="font-normal text-neutral-400">· {last.data.year}</span></span></a>}
        </div>}
      </div>
      {forms.length > 0 && <div class="brand-archive-forms">
        <h3 class="text-xs text-neutral-500">{editorial.forms}</h3>
        <ul class="flex flex-wrap gap-2">
          {forms.map(form => <li><a class="form-chip inline-flex min-h-11 items-center rounded-sm border border-neutral-700 px-2 py-1 text-xs motion-ui hover-desktop:border-orange-500 hover-desktop:text-orange-500" href={localePath(locale, `/catalog/?brand=${encodeURIComponent(data.name)}&form=${form}`)}>{strings.formFactors[form]}</a></li>)}
        </ul>
      </div>}
    </aside>
  </div>

  <BrandComparison name={data.name} phones={phones} locale={locale} />

  {phones.length > 0 && (
    <section id="brand-collection" class="mt-8 scroll-mt-24 border-t border-neutral-800 pt-6" aria-labelledby="brand-collection-title">
      <div class="grid items-center gap-4 sm:grid-cols-[minmax(0,1fr)_auto]">
        <div>
          <p class="editorial-kicker mb-2 text-orange-500">{editorial.collection}</p>
          <h2 id="brand-collection-title" class="border-l-2 border-orange-500 pl-3 text-xl font-bold sm:text-2xl">{strings.brands.allPhones}</h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-neutral-400">{phones.length === 1 ? BRAND_NOTES[locale][data.name] : editorial.collectionIntro}</p>
        </div>
        <button class="evolution-trigger primary-cta motion-ui" type="button" hidden aria-haspopup="dialog" aria-controls="brand-evolution">
          {evolutionCopy[locale].brandTitle}
          <EvolutionIcon />
        </button>
      </div>
      <div class="mt-6">
        {phonesByYear.size > 1 && (
          <details class="catalog-year-index">
            <summary>
              <span>{yearIndex.years}</span>
              <span class="ml-auto text-xs tabular-nums text-neutral-500">{yearRange}</span>
              <span class="year-index-toggle" aria-hidden="true"><Arrow kind="chevron" direction="down" class="year-index-chevron" size={18} /></span>
            </summary>
            <nav aria-label={yearIndex.jump}>
              {[...phonesByYear.keys()].map((year) => <a href={`#year-${year}`}>{year}</a>)}
            </nav>
          </details>
        )}
        <ul class:list={["brand-phone-grid grid grid-cols-2 gap-x-4 gap-y-2", phones.length > 2 ? "lg:grid-cols-4" : "lg:grid-cols-2", phones.length === 1 && "brand-phone-single"]}>
          {[...phonesByYear].flatMap(([year, yearPhones]) => yearPhones.map((phone, index) => (
            <li id={index === 0 ? `year-${year}` : undefined} class="brand-phone-cell min-w-0 scroll-mt-32">
              {index === 0 && (
                <span class="brand-year-marker">{year}</span>
              )}
              <div class="brand-phone-card-wrap flex min-w-0">
                <PhoneCard phone={phone} locale={locale} showcase={phones.length === 1} compact={phones.length > 1} />
              </div>
            </li>
          )))}
        </ul>
      </div>
      <EvolutionScene brand={data.name} locale={locale} stops={brandEvolution} />
    </section>
  )}
</div>

<style>
  .brand-about-copy { max-width: 78ch; }
  :global(html:not([data-design="modern"])) .brand-archive-single { display:none; }
  .brand-archive-panel {
    --archive-rule: var(--color-neutral-700);
    display: grid;
    gap: 1rem;
    min-width: 0;
    padding: clamp(1rem, 2.1vw, 1.5rem);
    border: 1px solid var(--color-neutral-800);
    background: var(--color-neutral-900);
  }
  :global(html[data-design="modern"]) .brand-archive-panel { --archive-rule: var(--modern-line); }
  .brand-archive-summary, .brand-archive-forms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .625rem 1rem;
  }
  .brand-archive-summary { justify-content: space-between; }
  .brand-archive-all { flex: none; color: var(--color-orange-500); }
  .brand-archive-years {
    display: grid;
    gap: .75rem 1.25rem;
    align-items: center;
    border-block-start: 1px solid var(--archive-rule);
    padding-block-start: 1rem;
  }
  .brand-archive-models { display: grid; gap: .5rem; }
  .brand-archive-link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .25rem;
    min-width: 0;
    padding: .625rem .75rem;
    border: 1px solid var(--archive-rule);
    overflow-wrap: anywhere;
    font-size: .875rem;
    font-weight: 600;
  }
  :global(html[data-design="modern"]) .brand-archive-link {
    border-radius: var(--modern-control);
    background: var(--modern-soft);
  }
  .brand-archive-forms { border-block-start: 1px solid var(--archive-rule); padding-block-start: .875rem; }
  a:focus-visible { outline: 2px solid var(--color-orange-500); outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) { .brand-archive-link:hover { color: var(--color-orange-500); } }
  @media (hover: hover) and (pointer: fine) { .brand-archive-all:hover { color:var(--color-orange-400); } }
  .brand-phone-single { grid-template-columns: minmax(0,1fr); }
  .brand-phone-cell { position: relative; display: grid; grid-row: span 2; grid-template-rows: subgrid; }
  .brand-phone-cell[id]::before {
    content: '';
    position: absolute;
    inset-block: 0 .5rem;
    inset-inline-start: -.5625rem;
    border-inline-start: 2px solid var(--color-orange-500);
  }
  .brand-year-marker {
    display: flex;
    align-items: center;
    min-block-size: 2rem;
    padding-inline: .625rem;
    border-block-end: 2px solid var(--color-orange-500);
    background: color-mix(in srgb, var(--color-orange-500) 15%, var(--color-neutral-900));
    color: var(--color-neutral-100);
    font-size: 1.25rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  :global(html[data-design="modern"]) .brand-year-marker {
    border-start-start-radius: var(--modern-control);
    border-start-end-radius: var(--modern-control);
  }
  .brand-phone-cell:nth-child(2n + 1)::before { display: none; }
  @media (min-width: 1024px) {
    .brand-phone-grid.lg\:grid-cols-4 .brand-phone-cell[id]:nth-child(4n + 3)::before { display: block; }
  }
  .brand-phone-card-wrap { grid-row: 2; margin-block-end: .5rem; }
  @media (min-width: 1024px) { .brand-phone-single { grid-template-columns: 1fr; } .brand-phone-single :global([data-phone-card]) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); } .brand-phone-single :global(.phone-card-art) { max-height: 19rem; border-bottom: 0; border-right: 1px solid var(--color-neutral-800); } .brand-phone-single :global(.card-copy) { justify-content: center; } }
  @media (min-width:640px) {
    .brand-archive-models { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }
  }
  @media (min-width:768px) {
    .brand-archive-years:has(.brand-archive-models) { grid-template-columns: minmax(9rem, .55fr) minmax(0, 2fr); }
  }
  @media (max-width:639px) {
    .brand-header { gap:1.25rem; }
    .brand-overview { gap:1.5rem; }
  }
</style>
