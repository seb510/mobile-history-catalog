---
import Arrow from './Arrow.astro';
import BrandMark from './BrandMark.astro';
import PhoneCard from './PhoneCard.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getPhonesForLocale } from '../lib/phones';
import { t } from '../lib/ui-strings';
import { localePath, type Locale } from '../lib/locales';
import { slugOf } from '../lib/phones';
import BrandMilestones from './BrandMilestones.astro';
import { BRAND_NOTES, BRAND_OFFICIAL_SITES, BRAND_PAGE } from '../lib/brand-editorial';
import PhoneStartupAudio from './PhoneStartupAudio.astro';
import { PHONE_STARTUP_SOUNDS } from '../lib/phone-sounds';

interface Props {
  brand: CollectionEntry<'brands'>;
  locale: Locale;
}
const { brand, locale } = Astro.props;
const { data } = brand;
const strings = t(locale);
const editorial = BRAND_PAGE[locale];
const officialSite = BRAND_OFFICIAL_SITES[data.name];
const { Content } = await render(brand);
const startupSound = PHONE_STARTUP_SOUNDS[data.name];
if (startupSound && !officialSite) throw new Error(`Startup audio requires an official brand or successor link: ${data.name}`);

const phones = (await getPhonesForLocale(locale)).filter((p) => p.data.brand === data.name).sort((a, b) => a.data.year - b.data.year);
const first = phones[0];
const last = phones.at(-1);
const yearRange = first && last ? first.data.year === last.data.year ? String(first.data.year) : `${first.data.year}–${last.data.year}` : '—';
const forms = [...new Set(phones.flatMap(phone => phone.data.formFactor ? [phone.data.formFactor] : []))];
const phoneCountText = (count: number) => {
  const forms = strings.brands.phoneCount;
  if (locale === 'en') return count === 1 ? forms.one : forms.many;
  const lastTwo = count % 100;
  const last = count % 10;
  if (last === 1 && lastTwo !== 11) return forms.one;
  if (last >= 2 && last <= 4 && (lastTwo < 12 || lastTwo > 14)) return 'few' in forms ? forms.few : forms.many;
  return forms.many;
};
---

<div>
  <header class="brand-header grid gap-6 border-b border-neutral-800 pb-7 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-center lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-10">
    <div>
      <BrandMark name={data.name} logo={data.logo} class="min-h-24 w-full max-w-xs px-6 py-6" />
      {data.logoCredit && (
        <p class="mt-2 max-w-xs text-xs leading-relaxed text-neutral-500">
          {data.logoSourceUrl ? (
            <a href={data.logoSourceUrl} class="text-orange-500 underline decoration-current/45 underline-offset-2 transition-colors motion-ui hover-desktop:text-orange-400" target="_blank" rel="noopener noreferrer nofollow">
              {data.logoCredit}
            </a>
          ) : (
            data.logoCredit
          )}
        </p>
      )}
    </div>

    <div>
      <p class="editorial-kicker mb-2 text-orange-500">{strings.nav.brands}</p>
      <h1 class="page-title">{data.name}</h1>
      <div class="mt-5 grid grid-cols-3 gap-2">
        {data.founded != null && (
          <div class="min-w-0 border-l-2 border-orange-500/70 bg-neutral-900/50 px-3 py-2">
            <p class="text-xs tracking-wide text-neutral-500 uppercase">{strings.brands.founded}</p>
            <p class="mt-1 font-semibold text-neutral-100">{data.founded}</p>
          </div>
        )}
        {data.country && (
          <div class="min-w-0 border-l-2 border-neutral-700 bg-neutral-900/50 px-3 py-2">
            <p class="text-xs tracking-wide text-neutral-500 uppercase">{strings.brands.country}</p>
            <p class="mt-1 font-semibold text-neutral-100">{data.country}</p>
          </div>
        )}
        <div class="min-w-0 border-l-2 border-neutral-700 bg-neutral-900/50 px-3 py-2">
          <p class="text-xs tracking-wide text-neutral-500 uppercase">{strings.nav.catalog}</p>
          <p class="mt-1 font-semibold text-neutral-100">{phones.length} {phoneCountText(phones.length)}</p>
        </div>
      </div>
      {officialSite && <div class="mt-4">
        <p class="text-xs tracking-wide text-neutral-500 uppercase">
          {officialSite.kind === 'licensee' ? editorial.officialLicensee : officialSite.kind === 'successor' ? editorial.officialSuccessor : editorial.officialSite}
        </p>
        <a
          class="mt-1 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-orange-500 underline decoration-current/45 underline-offset-4 transition-colors motion-ui hover-desktop:text-orange-400"
          href={officialSite.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {officialSite.name[locale]}<Arrow direction="up-right" />
        </a>
        <p class="max-w-2xl text-xs leading-relaxed text-neutral-500">{officialSite.note[locale]}</p>
      </div>}
    </div>
  </header>

  {startupSound && (
    <div class="mt-4">
      <PhoneStartupAudio locale={locale} brand={data.name} sound={startupSound} />
    </div>
  )}

  <div class="brand-overview mt-7 grid gap-6 lg:gap-8">
    <article class="min-w-0" aria-labelledby="brand-about">
      <h2 id="brand-about" class="mb-4 text-xl font-bold">{editorial.about}</h2>
      <div class="brand-about-copy prose prose-invert max-w-none prose-p:text-neutral-300"><Content /></div>
    </article>
    {phones.length !== 1 && <aside class="brand-archive-panel" aria-labelledby="brand-archive">
      <div class="brand-archive-summary">
        <h2 id="brand-archive" class="editorial-kicker text-orange-500">{editorial.selection}</h2>
        <p class="mt-2 text-sm leading-relaxed text-neutral-300">{BRAND_NOTES[locale][data.name]}</p>
        <a class="brand-archive-all" href="#brand-collection">{editorial.all}<Arrow direction="down" /></a>
      </div>
      <div class="brand-archive-years">
        <dl>
          <dt class="text-xs text-neutral-500">{editorial.range}</dt>
          <dd class="mt-1 text-2xl font-bold tabular-nums">{yearRange}</dd>
        </dl>
        <div class="brand-archive-models">
          {first && <a class="brand-archive-link" href={localePath(locale, `/phones/${slugOf(first)}/`)}><span class="text-xs font-normal text-neutral-500">{editorial.first}</span><span>{first.data.model} <span class="font-normal text-neutral-400">· {first.data.year}</span></span></a>}
          {last && first && slugOf(last) !== slugOf(first) && <a class="brand-archive-link" href={localePath(locale, `/phones/${slugOf(last)}/`)}><span class="text-xs font-normal text-neutral-500">{editorial.last}</span><span>{last.data.model} <span class="font-normal text-neutral-400">· {last.data.year}</span></span></a>}
        </div>
      </div>
      {forms.length > 0 && <div class="brand-archive-forms">
        <h3 class="text-xs text-neutral-500">{editorial.forms}</h3>
        <ul class="mt-2 flex flex-wrap gap-2">
          {forms.map(form => <li><a class="inline-flex min-h-11 items-center border border-neutral-700 px-2 py-1 text-xs motion-ui hover-desktop:border-orange-500 hover-desktop:text-orange-500" href={localePath(locale, `/catalog/?brand=${encodeURIComponent(data.name)}&form=${form}`)}>{strings.formFactors[form]}</a></li>)}
        </ul>
      </div>}
    </aside>}
  </div>

  <BrandMilestones name={data.name} phones={phones} locale={locale} />

  {phones.length > 0 && (
    <div id="brand-collection" class="mt-12 scroll-mt-24 border-t border-neutral-800 pt-8">
      <p class="editorial-kicker mb-2 text-orange-500">{editorial.collection}</p>
      <h2 class="border-l-2 border-orange-500 pl-3 text-xl font-bold sm:text-2xl">{strings.brands.allPhones}</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-neutral-400">{phones.length === 1 ? BRAND_NOTES[locale][data.name] : editorial.collectionIntro}</p>
      <ul class:list={["brand-phone-grid mt-6 grid grid-cols-2 items-stretch gap-4 lg:auto-rows-fr", phones.length > 2 ? "lg:grid-cols-4" : "lg:grid-cols-2", phones.length === 1 && "brand-phone-single"]}>
        {phones.map((phone) => (
          <li class="flex min-w-0">
            <PhoneCard phone={phone} locale={locale} showcase={phones.length === 1} />
          </li>
        ))}
      </ul>
    </div>
  )}
</div>

<style>
  .brand-about-copy { max-width: 78ch; }
  .brand-archive-panel { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,1.3fr) minmax(0,1.1fr); align-items:stretch; gap:1.25rem; padding:1.125rem 1.25rem; border:1px solid var(--color-neutral-800); background:var(--color-neutral-900); }
  .brand-archive-summary,.brand-archive-years,.brand-archive-forms { min-width:0; align-self:start; }
  .brand-archive-summary { padding-right:1.25rem; border-right:1px solid var(--color-neutral-700); }
  .brand-archive-years { padding-right:1.25rem; border-right:1px solid var(--color-neutral-700); }
  .brand-archive-models { display:grid; gap:.5rem; margin-top:.65rem; }
  .brand-archive-link { display:grid; min-width:0; grid-template-columns:minmax(0,.82fr) minmax(0,1fr); align-items:baseline; gap:.625rem; padding-top:.5rem; border-top:1px solid var(--color-neutral-700); font-size:.8125rem; font-weight:600; }
  .brand-archive-link > span { min-width:0; }
  .brand-archive-forms { min-width:0; }
  .brand-archive-all { display:inline-flex; min-height:2.75rem; align-items:center; gap:.75rem; margin-top:.5rem; color:var(--color-orange-500); font-size:.875rem; font-weight:600; }
  :global(html[data-design="modern"]) .brand-archive-panel { border-color:var(--modern-line); border-radius:14px; background:var(--modern-surface); }
  a:focus-visible { outline: 2px solid var(--color-orange-500); outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) { .brand-archive-link:hover { color: var(--color-orange-500); } }
  @media (hover: hover) and (pointer: fine) { .brand-archive-all:hover { color:var(--color-orange-400); } }
  .brand-phone-single { grid-template-columns: minmax(0,1fr); }
  @media (min-width: 1024px) { .brand-phone-single { grid-template-columns: 1fr; } .brand-phone-single :global([data-phone-card]) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); } .brand-phone-single :global(.phone-card-art) { max-height: 19rem; border-bottom: 0; border-right: 1px solid var(--color-neutral-800); } .brand-phone-single :global(.card-copy) { justify-content: center; } }
  @media (min-width:640px) and (max-width:1023px) { .brand-archive-panel { grid-template-columns:repeat(2,minmax(0,1fr)); } .brand-archive-summary { padding-right:0; border-right:0; } .brand-archive-years { border-right:0; padding-right:0; } .brand-archive-forms { grid-column:1 / -1; padding-top:.875rem; border-top:1px solid var(--color-neutral-700); } }
  @media (max-width:639px) { .brand-header { gap:1.25rem; } .brand-overview { gap:1.5rem; } .brand-archive-panel { grid-template-columns:minmax(0,1fr); gap:1rem; padding:1rem; } .brand-archive-summary { padding-right:0; border-right:0; } .brand-archive-years { padding:.875rem 0; border-right:0; border-top:1px solid var(--color-neutral-700); } .brand-archive-link { grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); } .brand-archive-forms { padding-top:.875rem; border-top:1px solid var(--color-neutral-700); } }
</style>
