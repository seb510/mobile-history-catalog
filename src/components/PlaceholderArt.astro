---
// Themed stand-in for phones without a sourced photo yet. It expands the site's timeline mark
// into a quiet scene with dated milestones, a soft glow, and a few background points.
interface Props {
  class?: string;
}
const { class: className = 'h-full w-full' } = Astro.props;
---

<svg viewBox="0 0 200 150" class={className} role="img" aria-hidden="true">
  <defs>
    <radialGradient id="glow" cx="50%" cy="50%" r="60%">
      <stop offset="0%" stop-color="currentColor" stop-opacity="0.2" />
      <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
    </radialGradient>
  </defs>
  <circle cx="100" cy="75" r="60" fill="url(#glow)" />
  <circle cx="42" cy="42" r="2" fill="currentColor" opacity="0.3" />
  <circle cx="33" cy="100" r="1.6" fill="currentColor" opacity="0.25" />
  <circle cx="166" cy="104" r="2" fill="currentColor" opacity="0.3" />
  <circle cx="158" cy="38" r="1.6" fill="currentColor" opacity="0.25" />

  <path d="M75 28v94" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.5" />
  <circle cx="75" cy="43" r="6" fill="currentColor" opacity="0.75" />
  <circle cx="75" cy="75" r="6" fill="currentColor" opacity="0.75" />
  <circle cx="75" cy="107" r="6" fill="currentColor" opacity="0.75" />
  <path d="M90 43h45M90 75h34M90 107h54" stroke="currentColor" stroke-width="4" stroke-linecap="round" opacity="0.7" />
</svg>
