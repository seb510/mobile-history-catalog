---
// Themed stand-in for phones without a sourced photo yet: the same pulse/signal-line language as
// LogoMark, scaled into a scene — a soft glow, concentric signal rings, and scattered timeline
// dots — rather than a bare empty box. Uses currentColor so it follows the surrounding text
// color (and therefore the light/dark theme) instead of baking in fixed colors like the logo.
interface Props {
  class?: string;
}
const { class: className = 'h-full w-full' } = Astro.props;
---

<svg viewBox="0 0 200 150" class={className} role="img" aria-hidden="true">
  <defs>
    <radialGradient id="glow" cx="50%" cy="50%" r="60%">
      <stop offset="0%" stop-color="currentColor" stop-opacity="0.2" />
      <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
    </radialGradient>
  </defs>
  <circle cx="100" cy="75" r="60" fill="url(#glow)" />
  <circle cx="100" cy="75" r="42" stroke="currentColor" stroke-width="1" fill="none" opacity="0.15" />
  <circle cx="100" cy="75" r="28" stroke="currentColor" stroke-width="1" fill="none" opacity="0.2" />

  <circle cx="42" cy="42" r="2" fill="currentColor" opacity="0.3" />
  <circle cx="33" cy="100" r="1.6" fill="currentColor" opacity="0.25" />
  <circle cx="166" cy="104" r="2" fill="currentColor" opacity="0.3" />
  <circle cx="158" cy="38" r="1.6" fill="currentColor" opacity="0.25" />

  <path
    d="M56 75h16l8-19 11 36 9-26 7 9h18"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
    opacity="0.85"
  />
  <circle cx="56" cy="75" r="2.5" fill="currentColor" opacity="0.6" />
  <circle cx="126" cy="75" r="2.5" fill="currentColor" opacity="0.4" />
</svg>
