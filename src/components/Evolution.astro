---
import EvolutionScene from './EvolutionScene.astro';
import { evolutionStops, type EvolutionFrame } from '../lib/evolution';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/locales';
import { slugOf } from '../lib/phones';
import { evolutionYears } from '../lib/evolution-years';

interface Props { locale: Locale; phones: CollectionEntry<'phones'>[] }
const { locale, phones } = Astro.props;
const curated = new Map(evolutionStops.map(({ slug, copy }) => [slug, copy[locale]]));
const bySlug = new Map(phones.map(entry => [slugOf(entry), entry]));
const stops: EvolutionFrame[] = Object.entries(evolutionYears).map(([year, event]) => {
  const entry = event && bySlug.get(event.slug);
  if (!entry || entry.data.year !== Number(year) || !entry.data.image) throw new Error(`Missing evolution illustration for ${year}`);
  const slug = slugOf(entry);
  const [label, description] = curated.get(slug) ?? [];
  return { slug, phone: entry.data, label, description };
});
---

<EvolutionScene locale={locale} stops={stops} phones={phones} />
