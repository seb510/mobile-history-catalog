---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { PRIVACY_COPY } from '../lib/privacy-copy';
import { t } from '../lib/ui-strings';
import { localePath, type Locale } from '../lib/locales';
const { locale, kind } = Astro.props as { locale: Locale; kind: 'privacy' | 'cookies' };
const copy = PRIVACY_COPY[locale];
const title = copy[kind];
---
<Layout locale={locale} path={`/${kind}/`} title={`${title} — ${t(locale).siteName}`} description={kind === 'cookies' ? copy.cookieIntro : copy.sections[1][1]}>
  <Breadcrumbs locale={locale} items={[{label: t(locale).breadcrumbs.home, path:'/'}, {label:title}]} />
  <header class="border-b border-neutral-800 pb-6"><p class="editorial-kicker text-orange-500">{copy.updated}</p><h1 class="page-title mt-3">{title}</h1></header>
  {kind === 'privacy' ? <div class="mt-8 max-w-3xl space-y-7">{copy.sections.map(([heading, text]) => <section><h2 class="text-xl font-bold">{heading}</h2><p class="mt-3 leading-relaxed text-neutral-300">{text}</p></section>)}</div> : <div class="mt-8"><p class="max-w-3xl leading-relaxed text-neutral-300">{copy.cookieIntro}</p><div class="mt-6 overflow-x-auto"><table class="w-full min-w-[36rem] border-collapse text-sm lg:text-base"><thead><tr>{copy.headers.map(label=><th class="border border-neutral-700 bg-neutral-900 p-3 text-left">{label}</th>)}</tr></thead><tbody>{copy.rows.map(row=><tr>{row.map(cell=><td class="border border-neutral-700 p-3 align-top">{cell}</td>)}</tr>)}</tbody></table></div><p class="mt-6 max-w-3xl leading-relaxed text-neutral-300">{copy.manage}</p></div>}
  <a class="mt-6 inline-block text-orange-500 underline underline-offset-4" href="mailto:sebistian@ukr.net">sebistian@ukr.net</a>
  <div class="mt-8 flex flex-wrap items-center gap-5"><button type="button" data-privacy-open class="control-button">{copy.settings}</button><a class="text-orange-500 underline underline-offset-4" href={localePath(locale, kind === 'privacy' ? '/cookies/' : '/privacy/')}>{kind === 'privacy' ? copy.cookies : copy.privacy}</a></div>
</Layout>
