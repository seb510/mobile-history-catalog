---
import type { Locale } from '../lib/locales';
const { locale } = Astro.props as { locale: Locale };
const c = locale === 'uk'
  ? { transit: 'У дорозі між телефонами', screen: 'На екрані у вагоні', sent: 'Я вже в потязі', reply: 'Зустріну на вокзалі', notification: 'Повідомлення', side: 'Поглянути збоку', back: 'До листування', front: 'Прямо', edge: 'Збоку', angle: 'Кут огляду сповіщення', locked: 'Наскрізне шифрування', proofAlt: 'Реальне фото Galaxy S26 Ultra: Privacy Display вимкнено (зліва) і ввімкнено (справа)', proofCaption: 'Так це виглядає на справжньому екрані:', proofCredit: 'Kyu3a, CC BY-SA 4.0, Wikimedia Commons' }
  : { transit: 'Between two phones', screen: 'On screen aboard the train', sent: 'I’m on the train', reply: 'I’ll meet you at the station', notification: 'Message', side: 'View from the side', back: 'Back to chat', front: 'Front', edge: 'Side', angle: 'Notification viewing angle', locked: 'End-to-end encryption', proofAlt: 'Real photo of the Galaxy S26 Ultra: Privacy Display off (left) and on (right)', proofCaption: 'This is what it looks like on a real screen:', proofCredit: 'Kyu3a, CC BY-SA 4.0, Wikimedia Commons' };
const proofSource = 'https://commons.wikimedia.org/wiki/File:Galaxy_S26_Ultra_Privacy_display_On%E3%83%BBOFF.jpg';
---
<section class="privacy" data-privacy>
  <header><span>2026</span><strong data-title>{c.transit}</strong></header>
  <div class="stage">
    <div class="pair" data-chat>
      <div class="device android"><b>Android</b><span class="bubble">{c.sent}</span></div>
      <div class="route" role="img" aria-label={c.locked}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M7 10V8a5 5 0 0 1 10 0v2"/><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M12 14v3"/></svg>
        <small>RCS</small>
      </div>
      <div class="device iphone"><b>iPhone</b><span class="bubble received">{c.sent}</span></div>
    </div>
    <div class="display" data-display hidden>
      <div class="device android"><b>Galaxy S26 Ultra</b><div class="notice"><small>{c.notification}</small><strong>{c.reply}</strong></div></div>
      <figure class="proof">
        <img src="/images/phones/samsung-galaxy-s26-ultra-privacy-display.webp" alt={c.proofAlt} loading="lazy" decoding="async" />
        <figcaption>{c.proofCaption} <a href={proofSource} target="_blank" rel="noopener noreferrer">{c.proofCredit}</a></figcaption>
      </figure>
    </div>
  </div>
  <footer>
    <label hidden data-control><span>{c.front}</span><input type="range" min="0" max="100" value="0" aria-label={c.angle}/><span>{c.edge}</span></label>
    <button type="button" data-toggle data-side={c.side} data-back={c.back} data-chat-title={c.transit} data-display-title={c.screen} aria-expanded="false">{c.side}</button>
  </footer>
</section>
<script>
  for (const scene of document.querySelectorAll<HTMLElement>('[data-privacy]')) {
    const button = scene.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const slider = scene.querySelector<HTMLInputElement>('input')!;
    const chat = scene.querySelector<HTMLElement>('[data-chat]')!;
    const display = scene.querySelector<HTMLElement>('[data-display]')!;
    const controls = scene.querySelector<HTMLElement>('[data-control]')!;
    const title = scene.querySelector<HTMLElement>('[data-title]')!;
    button.addEventListener('click', () => {
      const showDisplay = display.hidden;
      display.hidden = controls.hidden = !showDisplay;
      chat.hidden = showDisplay;
      title.textContent = (showDisplay ? button.dataset.displayTitle : button.dataset.chatTitle)!;
      button.textContent = (showDisplay ? button.dataset.back : button.dataset.side)!;
      button.setAttribute('aria-expanded', String(showDisplay));
      slider.value = '0';
      display.style.setProperty('--visibility', '1');
      if (showDisplay) slider.focus({ preventScroll: true });
    });
    slider.addEventListener('input', () => display.style.setProperty('--visibility', String(1 - slider.valueAsNumber / 100)));
  }
</script>
<style>
  .privacy { grid-area: artwork; align-self: stretch; display: grid; grid-template-rows: auto minmax(0,1fr) auto; min-height: 0; padding: clamp(.6rem,2vw,1.5rem); color: #ecfffa; background: radial-gradient(ellipse at 50% 42%,#204944,#102827 75%); border: 1px solid #426761; border-radius: .8rem; }
  header, footer, label, .route { display: flex; align-items: center; gap: .65rem; }
  header { font-size: clamp(.8rem,1.6vw,1.15rem); }
  header span, .route { color: #96edd7; }
  .stage { container-type: size; position: relative; min-height: 0; }
  .pair { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .display {
    position: absolute; inset: 0; overflow-y: auto; overscroll-behavior: contain;
    display: flex; flex-direction: column; align-items: center; justify-content: safe center;
    gap: clamp(.5rem, 2cqh, 1rem); padding-block: .35rem;
  }
  .device { position: relative; display: flex; flex-direction: column; align-items: stretch; justify-content: center; width: min(36cqw,44cqh); height: min(71cqw,89cqh); padding: .45rem; border: 3px solid #647c7c; border-radius: clamp(.55rem,2cqw,1.3rem); background: linear-gradient(155deg,#264a50,#132627); box-shadow: 0 .35rem .8rem #06161566; font-size: clamp(.68rem,3cqw,1.05rem); flex-shrink: 0; }
  .device::before { content: ''; position: absolute; top: 4%; left: 50%; translate: -50%; width: .35em; height: .35em; border-radius: 1em; background: #050e12; }
  .iphone { background: linear-gradient(150deg,#34485f,#1a2537); }
  .iphone::before { width: 22%; }
  .device b { margin-bottom: .45em; text-align: center; font-size: .85em; }
  .bubble, .notice { padding: .5em; border-radius: .7em; color: #10392e; background: #b7eed9; line-height: 1.25; }
  .received { color: #182d49; background: #dce9f9; }
  .route { flex-direction: column; justify-content: center; width: 14%; gap: .15rem; }
  .route small, .notice small { font-size: .68rem; }
  .display .device { width: min(42cqw,38cqh); height: min(63cqw,58cqh); background: linear-gradient(155deg,#47567a,#242838 65%,#153b38); }
  .notice { display: grid; gap: .2em; background: #edf4fd; color: #1a2b3e; opacity: var(--visibility,1); }
  .proof { flex-shrink: 0; display: grid; justify-items: center; gap: .4rem; max-width: min(88cqw, 24rem); text-align: center; }
  .proof img { width: 100%; max-height: min(40cqh, 11rem); object-fit: contain; border-radius: .5rem; background: #0b1f1d; }
  .proof figcaption { font-size: .72rem; line-height: 1.35; color: #bfe9de; }
  .proof figcaption a { color: #96edd7; text-decoration: underline; text-underline-offset: .15em; }
  footer { justify-content: space-between; flex-wrap: wrap; gap: .25rem .5rem; }
  button { margin-inline-start: auto; min-height: 44px; padding-inline: .75rem; border-radius: .4rem; background: #b7eed9; color: #132e28; font-weight: 650; font-size: .84rem; }
  label { flex: 1; font-size: .75rem; }
  input { width: 100%; min-width: 3rem; height: 44px; accent-color: #92ead1; touch-action: none; }
  .privacy [hidden] { display: none; }
</style>
