---
// Brand mark: a rounded orange badge with a vertical timeline and three dated milestones.
// The simple geometry stays legible at favicon size and is original to this project.
interface Props {
  class?: string;
}
const { class: className = 'h-8 w-8' } = Astro.props;
const gradId = `logo-grad-${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox="0 0 64 64" class={className} role="img" aria-hidden="true">
  <defs>
    <linearGradient id={gradId} x1="0" y1="0" x2="64" y2="64">
      <stop offset="0" stop-color="#fb923c" />
      <stop offset="1" stop-color="#c2410c" />
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="18" fill={`url(#${gradId})`} />
  <path d="M20 13v38" stroke="#fff7ed" stroke-width="3" stroke-linecap="round" opacity="0.65" />
  <circle cx="20" cy="17" r="4.5" fill="#fff7ed" />
  <circle cx="20" cy="32" r="4.5" fill="#fff7ed" />
  <circle cx="20" cy="47" r="4.5" fill="#fff7ed" />
  <path d="M30 18h18M30 32h12M30 46h20" stroke="#fff7ed" stroke-width="3.5" stroke-linecap="round" />
</svg>
