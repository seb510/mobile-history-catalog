---
// Original generic keypad handset; synchronized with favicon and placeholders.
interface Props { class?: string }
const { class: className = 'h-8 w-8' } = Astro.props;
---
<svg viewBox="0 0 64 64" class={className} aria-hidden="true">
  <rect width="64" height="64" rx="14" fill="#193341" />
  <rect x="16" y="8" width="32" height="48" rx="8" fill="#f2f7f6" />
  <rect x="22" y="16" width="20" height="20" rx="2" fill="#f3a773" />
  <g fill="#193341">
    <rect x="24" y="38" width="4" height="4" />
    <rect x="30" y="38" width="4" height="4" />
    <rect x="36" y="38" width="4" height="4" />
    <rect x="24" y="44" width="4" height="4" />
    <rect x="30" y="44" width="4" height="4" />
    <rect x="36" y="44" width="4" height="4" />
    <rect x="24" y="50" width="4" height="4" />
    <rect x="30" y="50" width="4" height="4" />
    <rect x="36" y="50" width="4" height="4" />
  </g>
</svg>
