---
// Brand mark: a rounded "app icon" badge with a pulse/signal-line glyph — reads as both a
// heartbeat (the phone industry's pulse over time) and a timeline waveform. Fully abstract and
// colors are baked into the SVG rather than inherited via currentColor, like any other fixed
// logotype — not a likeness of any real handset or existing brand mark.
interface Props {
  class?: string;
}
const { class: className = 'h-8 w-8' } = Astro.props;
const gradId = `logo-grad-${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox="0 0 64 64" class={className} role="img" aria-hidden="true">
  <defs>
    <linearGradient id={gradId} x1="0" y1="0" x2="64" y2="64">
      <stop offset="0" stop-color="#fb923c" />
      <stop offset="1" stop-color="#c2410c" />
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="18" fill={`url(#${gradId})`} />
  <path
    d="M12 33h8l5-13 7 25 6-17 5 9h9"
    stroke="#fff7ed"
    stroke-width="4.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  />
</svg>
