---
// Original mark: a phone silhouette with an ascending bar-chart inside, standing in for
// "phone + history/timeline". Deliberately abstract/geometric — not a likeness of any real
// handset or existing brand mark, to keep it clear of trademark/copyright concerns.
interface Props {
  class?: string;
}
const { class: className = 'h-8 w-8' } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role="img"
  aria-hidden="true"
>
  <rect x="9" y="3" width="30" height="42" rx="7" stroke="currentColor" stroke-width="3" />
  <rect x="21" y="7.3" width="6" height="2.4" rx="1.2" fill="currentColor" />
  <rect x="15" y="27" width="5" height="10" rx="1.5" fill="currentColor" />
  <rect x="21.5" y="20" width="5" height="17" rx="1.5" fill="currentColor" />
  <rect x="28" y="24" width="5" height="13" rx="1.5" fill="currentColor" />
</svg>
