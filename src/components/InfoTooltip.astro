---
interface Props {
  text: string;
  label: string;
}
const { text, label } = Astro.props;
---
<span class="info-tooltip" data-info-tooltip>
  <button
    type="button"
    class="info-tooltip-trigger"
    aria-label={label}
    hidden
    data-info-trigger
  >
    <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <circle cx="10" cy="10" r="8" />
      <path d="M10 9.2v4.4" />
      <circle cx="10" cy="6.3" r="1" fill="currentColor" stroke="none" />
    </svg>
  </button>
  <span role="tooltip" class="info-tooltip-bubble" data-info-bubble>{text}</span>
</span>

<script>
  const GAP = 8;
  const MARGIN = 10;
  type Tooltip = { trigger: HTMLButtonElement; bubble: HTMLElement };
  let current: Tooltip | null = null;
  let pinned = false;
  let hideTimer: number | undefined;

  function positionBubble(trigger: HTMLElement, bubble: HTMLElement) {
    const triggerRect = trigger.getBoundingClientRect();
    const bubbleRect = bubble.getBoundingClientRect();
    const openUp = triggerRect.top > bubbleRect.height + GAP + MARGIN;
    const top = (openUp
      ? Math.max(MARGIN, triggerRect.top - bubbleRect.height - GAP)
      : Math.max(MARGIN, Math.min(document.documentElement.clientHeight - bubbleRect.height - MARGIN, triggerRect.bottom + GAP)));
    let left = triggerRect.left + triggerRect.width / 2 - bubbleRect.width / 2;
    left = Math.max(MARGIN, Math.min(left, document.documentElement.clientWidth - bubbleRect.width - MARGIN));
    bubble.style.top = `${top}px`;
    bubble.style.left = `${left}px`;
  }

  function close() {
    window.clearTimeout(hideTimer);
    if (!current) return;
    current.bubble.removeAttribute('data-open');
    current = null;
    pinned = false;
  }

  function open(tooltip: Tooltip) {
    window.clearTimeout(hideTimer);
    if (current === tooltip) return;
    close();
    const { trigger, bubble } = tooltip;
    // Keep the cached reference after moving the bubble outside the clipped card.
    if (bubble.parentElement !== document.body) document.body.append(bubble);
    positionBubble(trigger, bubble);
    bubble.setAttribute('data-open', 'true');
    current = tooltip;
  }

  let nextId = 0;
  const bind = (parent: ParentNode) => parent.querySelectorAll<HTMLElement>('[data-info-tooltip]').forEach(root => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-info-trigger]');
    const bubble = root.querySelector<HTMLElement>('[data-info-bubble]');
    if (!trigger || !bubble || trigger.hasAttribute('aria-describedby')) return;
    const tooltip = { trigger, bubble };
    bubble.id = `info-tooltip-${++nextId}`;
    trigger.setAttribute('aria-describedby', bubble.id);
    trigger.hidden = false;

    const leave = () => {
      if (current !== tooltip) return;
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => {
        if (current === tooltip && !pinned && !trigger.matches(':hover, :focus-visible') && !bubble.matches(':hover')) close();
      }, 150);
    };
    trigger.addEventListener('click', () => {
      if (current === tooltip && pinned) close();
      else {
        open(tooltip);
        pinned = true;
      }
    });
    trigger.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') open(tooltip); });
    trigger.addEventListener('pointerleave', (event) => { if (event.pointerType === 'mouse') leave(); });
    bubble.addEventListener('pointerenter', () => { if (current === tooltip) window.clearTimeout(hideTimer); });
    bubble.addEventListener('pointerleave', leave);
    trigger.addEventListener('focus', () => { if (trigger.matches(':focus-visible')) open(tooltip); });
    trigger.addEventListener('blur', () => {
      if (current !== tooltip) return;
      pinned = false;
      leave();
    });
  });

  bind(document);
  document.addEventListener('cabinet-card-mounted', event => bind(event.target as HTMLElement));

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    if (current && !(target instanceof Element && target.closest('[data-info-tooltip]')) && !current.bubble.contains(target)) close();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') close();
  });
  window.addEventListener('scroll', () => close(), { passive: true, capture: true });
  window.addEventListener('resize', () => { if (current) positionBubble(current.trigger, current.bubble); });
</script>

<style>
  .info-tooltip { position: relative; display: inline-flex; vertical-align: middle; }
  .info-tooltip-trigger:not([hidden]) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: .4rem;
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-neutral-300);
    cursor: pointer;
    transition: background-color var(--motion-ui) var(--motion-easing), color var(--motion-ui) var(--motion-easing);
  }
  @media (hover: hover) and (pointer: fine) {
    .info-tooltip-trigger:hover {
      background: color-mix(in srgb, var(--color-orange-500) 10%, transparent);
      color: var(--color-orange-500);
    }
  }
  .info-tooltip-trigger:focus-visible { outline: 2px solid var(--color-orange-500); outline-offset: 2px; }
  .info-tooltip-bubble {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 200;
    width: max-content;
    max-width: min(16rem, calc(100vw - 20px));
    overflow-wrap: anywhere;
    border: 1px solid var(--color-neutral-700);
    border-radius: 2px;
    background: var(--color-neutral-950);
    padding: .5rem .625rem;
    color: var(--color-neutral-300);
    font-size: .75rem;
    font-weight: 400;
    line-height: 1.45;
    text-align: start;
    box-shadow: 0 8px 20px #0006;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--motion-ui) var(--motion-easing);
  }
  .info-tooltip-bubble[data-open="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  :global(html[data-design="modern"]) .info-tooltip-bubble { border-radius: var(--modern-control); border-color: var(--modern-line); background: var(--modern-elevated); }
  @media (prefers-reduced-motion: reduce) {
    .info-tooltip-trigger, .info-tooltip-bubble { transition: none; }
  }
</style>
