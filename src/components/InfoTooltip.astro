---
interface Props {
  text: string;
  label: string;
  id: string;
}
const { text, label, id } = Astro.props;
---
<span class="info-tooltip" data-info-tooltip>
  <span
    class="info-tooltip-trigger"
    role="button"
    tabindex="0"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-describedby={id}
    aria-label={label}
    data-info-trigger
  >
    <svg aria-hidden="true" viewBox="0 0 20 20" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="10" cy="10" r="7.25" />
      <path d="M10 9.2v4" stroke-linecap="round" />
      <path d="M10 6.3h.01" stroke-linecap="round" />
    </svg>
  </span>
  <span role="tooltip" id={id} class="info-tooltip-bubble" data-info-bubble>{text}</span>
</span>

<script>
  const GAP = 8;
  const MARGIN = 10;
  const fineHover = () => window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  // Adopted into <body> the first time it opens, so no ancestor (overflow,
  // stacking context, etc.) can ever clip or constrain it. aria-describedby
  // still links trigger -> bubble by id regardless of where it lives in the DOM.
  function adoptIntoBody(bubble: HTMLElement) {
    if (bubble.parentElement !== document.body) document.body.appendChild(bubble);
  }

  function positionBubble(trigger: HTMLElement, bubble: HTMLElement) {
    const triggerRect = trigger.getBoundingClientRect();
    const bubbleRect = bubble.getBoundingClientRect();
    const openUp = triggerRect.top > bubbleRect.height + GAP + MARGIN;
    const top = (openUp
      ? Math.max(MARGIN, triggerRect.top - bubbleRect.height - GAP)
      : Math.min(window.innerHeight - bubbleRect.height - MARGIN, triggerRect.bottom + GAP)) + window.scrollY;
    let left = triggerRect.left + triggerRect.width / 2 - bubbleRect.width / 2;
    left = Math.max(MARGIN, Math.min(left, window.innerWidth - bubbleRect.width - MARGIN)) + window.scrollX;
    bubble.style.top = `${top}px`;
    bubble.style.left = `${left}px`;
  }

  let current: { trigger: HTMLElement; bubble: HTMLElement } | null = null;

  function close() {
    if (!current) return;
    current.bubble.removeAttribute('data-open');
    current.trigger.setAttribute('aria-expanded', 'false');
    current = null;
  }

  function open(root: HTMLElement) {
    const trigger = root.querySelector<HTMLElement>('[data-info-trigger]');
    const bubble = root.querySelector<HTMLElement>('[data-info-bubble]');
    if (!trigger || !bubble) return;
    if (current && current.bubble !== bubble) close();
    adoptIntoBody(bubble);
    positionBubble(trigger, bubble);
    bubble.setAttribute('data-open', 'true');
    trigger.setAttribute('aria-expanded', 'true');
    current = { trigger, bubble };
  }

  document.querySelectorAll<HTMLElement>('[data-info-tooltip]').forEach((root) => {
    const trigger = root.querySelector<HTMLElement>('[data-info-trigger]');
    if (!trigger) return;
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (current && current.trigger === trigger) close();
      else open(root);
    });
    trigger.addEventListener('mouseenter', () => { if (fineHover()) open(root); });
    trigger.addEventListener('mouseleave', () => { if (current?.trigger === trigger) close(); });
    trigger.addEventListener('focus', () => open(root));
    trigger.addEventListener('blur', () => { if (current?.trigger === trigger) close(); });
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    if (current && !(target instanceof Element && target.closest('[data-info-tooltip]')) && !current.bubble.contains(target)) close();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && current) {
      const trigger = current.trigger;
      close();
      trigger.focus();
    }
  });
  window.addEventListener('scroll', () => close(), { passive: true, capture: true });
  window.addEventListener('resize', () => { if (current) positionBubble(current.trigger, current.bubble); });
</script>

<style>
  .info-tooltip { position: relative; display: inline-flex; vertical-align: middle; }
  .info-tooltip-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 999px;
    border: 1px solid var(--color-neutral-600);
    color: var(--color-neutral-400);
    cursor: pointer;
    transition: border-color var(--motion-ui) var(--motion-easing), color var(--motion-ui) var(--motion-easing);
  }
  @media (hover: hover) and (pointer: fine) {
    .info-tooltip-trigger:hover { border-color: var(--color-orange-500); color: var(--color-orange-500); }
  }
  .info-tooltip-trigger:focus-visible { outline: 2px solid var(--color-orange-500); outline-offset: 2px; }
  .info-tooltip-bubble {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 200;
    width: max-content;
    max-width: 16rem;
    border: 1px solid var(--color-neutral-700);
    border-radius: 2px;
    background: var(--color-neutral-950);
    padding: .5rem .625rem;
    color: var(--color-neutral-300);
    font-size: .75rem;
    font-weight: 400;
    line-height: 1.45;
    text-align: start;
    box-shadow: 0 8px 20px #0006;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--motion-ui) var(--motion-easing);
  }
  .info-tooltip-bubble[data-open="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  html[data-design="modern"] .info-tooltip-trigger { border-radius: 999px; border-color: var(--modern-line); }
  html[data-design="modern"] .info-tooltip-bubble { border-radius: var(--modern-control); border-color: var(--modern-line); background: var(--modern-elevated); color: var(--color-neutral-300); }
</style>
