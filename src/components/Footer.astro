---
import { localePath, type Locale } from '../lib/locales';
import { t, CHROME_COPY } from '../lib/ui-strings';
import LogoMark from './LogoMark.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const strings = t(locale);
const copy = CHROME_COPY[locale];
const year = new Date().getFullYear();
const links = [
  { href: localePath(locale, '/catalog/'), label: strings.nav.catalog },
  { href: localePath(locale, '/brands/'), label: strings.nav.brands },
  { href: localePath(locale, '/compare/'), label: strings.nav.compare },
  { href: localePath(locale, '/favorites/'), label: strings.nav.favorites },
];
---

<footer class="mt-14 border-t border-neutral-700 bg-neutral-900/30 sm:mt-20">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <div class="grid gap-7 md:grid-cols-[minmax(0,1.4fr)_minmax(0,.8fr)_minmax(0,1fr)] md:gap-10">
      <div class="max-w-md">
        <a href={localePath(locale, '/')} class="inline-flex items-center gap-2 text-neutral-100 transition-colors motion-ui hover-desktop:text-orange-500">
          <LogoMark class="h-8 w-8" />
          <span class="font-bold tracking-tight">{strings.siteName}</span>
        </a>
        <p class="mt-3 text-sm font-semibold text-orange-500">{strings.brandLine}</p>
        <p class="mt-3 text-sm leading-relaxed text-neutral-400">{strings.footer.about}</p>
      </div>

      <nav class="border-t border-neutral-800 pt-5 md:border-t-0 md:pt-1" aria-label={strings.footer.navigation}>
        <h2 class="editorial-kicker mb-2 text-neutral-500">{strings.footer.navigation}</h2>
        <ul class="grid grid-cols-2 gap-x-4 text-sm md:grid-cols-1">
          {links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="group inline-flex min-h-11 items-center gap-2 text-neutral-300 transition-colors motion-ui hover-desktop:text-orange-500"
              >
                <span class="h-px w-3 bg-neutral-600 transition-colors motion-ui group-hover-desktop:bg-orange-500" aria-hidden="true"></span>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="border-t border-neutral-800 pt-5 md:border-t-0 md:pt-1">
        <h2 class="editorial-kicker mb-3 text-neutral-500">{copy.archive}</h2>
        <p class="text-sm leading-relaxed text-neutral-400">{copy.note}</p>
        <a class="mt-2 inline-flex min-h-11 items-center text-sm text-orange-500 underline underline-offset-4 hover-desktop:text-orange-400" href={localePath(locale, '/about/')}>{copy.approach}</a>
        <p class="text-xs leading-relaxed text-neutral-500">{strings.footer.inspiredBy}</p>
        <a class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm text-neutral-300 hover-desktop:text-orange-500" href="https://github.com/seb510/mobile-history-catalog" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-neutral-800 pt-5 text-xs text-neutral-500 sm:flex-row sm:items-start sm:justify-between">
      <p class="max-w-2xl leading-relaxed">{strings.footer.rights}</p>
      <p class="shrink-0">© {year} {strings.siteName}</p>
    </div>
  </div>
</footer>
