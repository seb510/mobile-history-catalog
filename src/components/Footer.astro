---
import { localePath, type Locale } from '../lib/locales';
import { t } from '../lib/ui-strings';
import LogoMark from './LogoMark.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const strings = t(locale);
const year = new Date().getFullYear();
const links = [
  { href: localePath(locale, '/catalog/'), label: strings.nav.catalog },
  { href: localePath(locale, '/brands/'), label: strings.nav.brands },
  { href: localePath(locale, '/compare/'), label: strings.nav.compare },
  { href: localePath(locale, '/about/'), label: strings.nav.about },
  { href: 'https://github.com/seb510/mobile-history-catalog', label: 'GitHub', external: true },
];
---

<footer class="mt-20 border-t border-neutral-800">
  <div class="mx-auto max-w-5xl px-4 py-10">
    <div class="grid gap-10 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-12">
      <div class="max-w-md">
        <a href={localePath(locale, '/')} class="inline-flex items-center gap-2 text-neutral-100 transition-colors motion-ui hover-desktop:text-orange-500">
          <LogoMark class="h-8 w-8" />
          <span class="font-bold tracking-tight">{strings.siteName}</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-neutral-400">{strings.footer.about}</p>
        <p class="mt-3 text-xs text-neutral-500">{strings.footer.inspiredBy}</p>
      </div>

      <nav aria-label={strings.footer.navigation}>
        <h2 class="editorial-kicker mb-4 text-neutral-500">{strings.footer.navigation}</h2>
        <ul class="grid grid-cols-2 gap-x-8 gap-y-3 text-sm">
          {links.map(({ href, label, external }) => (
            <li>
              <a
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                class="group inline-flex items-center gap-2 text-neutral-300 transition-colors motion-ui hover-desktop:text-orange-500"
              >
                <span class="h-px w-3 bg-neutral-600 transition-colors motion-ui group-hover-desktop:bg-orange-500" aria-hidden="true"></span>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-neutral-800 pt-5 text-xs text-neutral-500 sm:flex-row sm:items-start sm:justify-between">
      <p class="max-w-2xl leading-relaxed">{strings.footer.rights}</p>
      <p class="shrink-0">© 1998–{year} {strings.siteName}</p>
    </div>
  </div>
</footer>
