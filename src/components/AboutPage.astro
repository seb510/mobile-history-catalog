---
import Arrow from './Arrow.astro';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import LogoMark from './LogoMark.astro';
import { getPhonesForLocale } from '../lib/phones';
import { t, PROJECT_PRESENTATION } from '../lib/ui-strings';
import { localePath, type Locale } from '../lib/locales';
interface Props { locale: Locale }
const { locale } = Astro.props;
const strings = t(locale);
const projectCopy = PROJECT_PRESENTATION[locale];
const phones = await getPhonesForLocale(locale);
const brandCount = new Set(phones.map(phone => phone.data.brand)).size;
---
<Layout locale={locale} path="/about/" title={`${strings.about.title} — ${strings.siteName}`} description={strings.about.intro}>
  <Breadcrumbs locale={locale} items={[{ label: strings.breadcrumbs.home, path: '/' }, { label: strings.about.title }]} />
  <header class="grid gap-7 border-b border-neutral-800 pb-8 lg:grid-cols-[1.4fr_1fr] lg:items-end">
  <div>
    <div class="flex items-center gap-4">
      <LogoMark class="h-16 w-16 shrink-0 sm:h-20 sm:w-20" />
      <div><p class="editorial-kicker text-orange-500">{strings.siteName}</p><h1 class="page-title mt-2">{strings.about.title}</h1></div>
    </div>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-neutral-200 sm:text-xl">{strings.about.intro}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="primary-cta inline-flex min-h-11 items-center rounded-sm bg-orange-500 px-4 py-3 text-sm font-semibold text-neutral-950 transition-colors motion-ui" href={localePath(locale, '/catalog/')}>{strings.nav.catalog} <Arrow /></a>
      <a class="control-button text-sm" href={localePath(locale, '/compare/')}>{strings.nav.compare}</a>
    </div>
  </div>
  <aside class="rounded-sm border border-neutral-700 border-t-2 border-t-orange-500 bg-neutral-900 p-5 sm:p-6">
    <p class="editorial-kicker text-orange-500">{strings.siteName}</p>
    <p class="mt-3 text-2xl font-extrabold leading-tight tracking-tight sm:text-3xl">{strings.brandLine}</p>
    <p class="mt-4 text-sm leading-relaxed text-neutral-400">{projectCopy.note}</p>
    <dl class="mt-6 grid grid-cols-3 gap-3 border-t border-neutral-700 pt-4">{[{value:phones.length,label:projectCopy.collection},{value:brandCount,label:projectCopy.brands},{value:3,label:projectCopy.languages}].map(item=><div><dt class="text-xs text-neutral-500">{item.label}</dt><dd class="mt-2 text-2xl font-extrabold tabular-nums text-orange-500">{item.value}</dd></div>)}</dl>
  </aside>
  </header>
  <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2">
    {strings.about.sections.map((section, index) => <section class="border-t border-neutral-800 pt-4">
      <p class="editorial-kicker text-orange-500">{String(index + 1).padStart(2, '0')}</p>
      <h2 class="mt-2 text-xl font-bold tracking-tight text-neutral-100">{section.title}</h2>
      {section.paragraphs.map((paragraph) => <p class="mt-3 text-sm leading-relaxed text-neutral-400 lg:text-base">{paragraph}</p>)}
    </section>)}
  </div>
</Layout>
