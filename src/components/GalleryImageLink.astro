---
interface Props {
  image: string;
  caption: string;
  index: number;
  label: string;
  class: string;
  loading?: 'lazy';
}
const { image, caption, index, label, class: imageClass, loading } = Astro.props;
---
<a class="relative block cursor-zoom-in" href={image} data-gallery-open={index} aria-haspopup="dialog" aria-label={`${label} — ${caption}`}>
  <img class={imageClass} src={image} alt={caption} loading={loading} decoding="async" />
  <span class="gallery-expand-icon absolute bottom-2 right-2 inline-flex h-11 w-11 items-center justify-center rounded-sm border border-neutral-600 bg-neutral-950/90 text-neutral-100" aria-hidden="true">
    <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg>
  </span>
</a>
