---
import LogoMark from './LogoMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { LOCALES, localePath, type Locale } from '../lib/locales';
import { t } from '../lib/ui-strings';

interface Props {
  locale: Locale;
  /** Unprefixed current path, e.g. "/", "/phones/nokia-3310/", "/about/". Used to build the
   * language-switcher links and the nav "active" state. */
  path: string;
}
const { locale, path } = Astro.props;
const strings = t(locale);

const LOCALE_LABEL: Record<Locale, string> = { uk: 'UK', ru: 'RU', en: 'EN' };
const isActive = (target: string) =>
  path === target ||
  (target !== '/' && path.startsWith(target)) ||
  (target === '/catalog/' && path.startsWith('/phones/'));
const navLinkClass = (target: string) => {
  const active = isActive(target);
  return `rounded-sm px-2.5 py-1.5 text-sm font-medium transition-colors motion-ui ${active ? 'bg-neutral-900 text-neutral-100' : 'text-neutral-400 hover-desktop:bg-neutral-900 hover-desktop:text-neutral-100'}`;
};
const mobileNavLinkClass = (target: string) =>
  `flex min-h-10 items-center rounded-sm border px-3 text-sm transition-colors motion-ui ${isActive(target) ? 'border-orange-500/60 bg-neutral-900 text-neutral-100' : 'border-neutral-800 text-neutral-300 hover-desktop:border-neutral-700 hover-desktop:bg-neutral-900 hover-desktop:text-neutral-100'}`;
---

<header id="site-header" class="site-header sticky top-0 z-50 border-t-2 border-b border-t-orange-500 border-b-neutral-800 bg-neutral-950/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2 sm:px-6">
    <a href={localePath(locale, '/')} class="flex min-w-0 items-center gap-2 text-neutral-100">
      <LogoMark class="h-7 w-7 shrink-0" />
      <span class="truncate text-sm font-bold tracking-tight sm:text-base" title={`${strings.siteName} — ${strings.brandLine}`}>{strings.siteName}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      <a href={localePath(locale, '/catalog/')} class={navLinkClass('/catalog/')} aria-current={isActive('/catalog/') ? 'page' : undefined}>{strings.nav.catalog}</a>
      <a href={localePath(locale, '/brands/')} class={navLinkClass('/brands/')} aria-current={isActive('/brands/') ? 'page' : undefined}>{strings.nav.brands}</a>
      <a href={localePath(locale, '/compare/')} class={navLinkClass('/compare/')} aria-current={isActive('/compare/') ? 'page' : undefined}>{strings.nav.compare}</a>
      <a href={localePath(locale, '/about/')} class={navLinkClass('/about/')} aria-current={isActive('/about/') ? 'page' : undefined}>{strings.nav.about}</a>
      <div role="group" class="ml-2 flex items-center gap-0.5 rounded-sm border border-neutral-800 bg-neutral-900/50 p-0.5" aria-label={strings.langSwitcher}>
        {LOCALES.map((l) => (
          l === locale ? (
            <span aria-current="page" class="rounded-sm bg-orange-500 px-1.5 py-1 text-[0.65rem] font-bold text-neutral-950">{LOCALE_LABEL[l]}</span>
          ) : (
            <a href={localePath(l, path === '/404/' ? '/' : path)} class="rounded-sm px-1.5 py-1 text-[0.65rem] font-semibold text-neutral-500 transition-colors motion-ui hover-desktop:text-neutral-100">
              {LOCALE_LABEL[l]}
            </a>
          )
        ))}
      </div>
      <ThemeToggle locale={locale} class="ml-1 h-8 w-8 rounded-sm" />
    </nav>

    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={strings.menu.open}
      data-label-open={strings.menu.open}
      data-label-close={strings.menu.close}
      class="flex h-9 w-9 items-center justify-center rounded-sm border border-neutral-700 text-neutral-200 transition-colors motion-ui hover-desktop:border-orange-500 hover-desktop:text-orange-500 md:hidden"
    >
      <span class="sr-only">{strings.menu.open}</span>
      <svg data-menu-icon viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M2 5h16v1.5H2zM2 9.25h16v1.5H2zM2 13.5h16V15H2z"/></svg>
      <svg data-close-icon viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="hidden h-5 w-5" aria-hidden="true"><path d="m4 4 12 12M16 4 4 16" stroke-linecap="round" /></svg>
    </button>
  </div>

  <div id="mobile-menu" inert aria-hidden="true" class="pointer-events-none absolute top-[calc(100%+0.5rem)] right-4 z-50 max-h-0 w-[min(22rem,calc(100vw-2rem))] translate-y-1 overflow-hidden rounded-sm border border-neutral-800 bg-neutral-950 opacity-0 shadow-xl shadow-neutral-950/30 transition-[max-height,opacity,transform] motion-ui md:hidden">
    <nav class="grid grid-cols-2 gap-1.5 p-2">
      <a href={localePath(locale, '/catalog/')} class={mobileNavLinkClass('/catalog/')} aria-current={isActive('/catalog/') ? 'page' : undefined}>{strings.nav.catalog}</a>
      <a href={localePath(locale, '/brands/')} class={mobileNavLinkClass('/brands/')} aria-current={isActive('/brands/') ? 'page' : undefined}>{strings.nav.brands}</a>
      <a href={localePath(locale, '/compare/')} class={mobileNavLinkClass('/compare/')} aria-current={isActive('/compare/') ? 'page' : undefined}>{strings.nav.compare}</a>
      <a href={localePath(locale, '/about/')} class={mobileNavLinkClass('/about/')} aria-current={isActive('/about/') ? 'page' : undefined}>{strings.nav.about}</a>
      <div role="group" class="col-span-2 mt-1 flex items-center gap-3 border-t border-neutral-800 px-1 pt-2" aria-label={strings.langSwitcher}>
        {LOCALES.map((l) => (
          l === locale ? (
            <span aria-current="page" class="text-sm font-semibold text-orange-500">{LOCALE_LABEL[l]}</span>
          ) : (
            <a href={localePath(l, path === '/404/' ? '/' : path)} class="text-sm font-medium text-neutral-400 transition-colors motion-ui hover-desktop:text-neutral-100">
              {LOCALE_LABEL[l]}
            </a>
          )
        ))}
        <ThemeToggle locale={locale} class="ml-auto h-8 w-8 rounded-sm" />
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const setHeaderHidden = (hidden: boolean) => {
    header?.classList.toggle('is-hidden', hidden);
    document.documentElement.dataset.headerHidden = String(hidden);
  };
  const setMenuOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    if (open) setHeaderHidden(false);
    menu.classList.toggle('pointer-events-none', !open);
    menu.classList.toggle('max-h-0', !open);
    menu.classList.toggle('opacity-0', !open);
    menu.classList.toggle('max-h-[24rem]', open);
    menu.classList.toggle('opacity-100', open);
    menu.classList.toggle('translate-y-1', !open);
    menu.classList.toggle('translate-y-0', open);
    menu.inert = !open;
    menu.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!);
    toggle.querySelector('.sr-only')!.textContent = open ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!;
    toggle.querySelector('[data-menu-icon]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-close-icon]')?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => {
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      toggle.focus();
    }
  });

  document.addEventListener('pointerdown', (event) => {
    if (
      event.target instanceof Node &&
      !menu?.contains(event.target) &&
      !toggle?.contains(event.target) &&
      toggle?.getAttribute('aria-expanded') === 'true'
    ) {
      setMenuOpen(false);
    }
  });

  window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
    if (event.matches) setMenuOpen(false);
  });

  let previousScrollY = window.scrollY;
  window.addEventListener(
    'scroll',
    () => {
      const currentScrollY = Math.max(0, window.scrollY);
      if (Math.abs(currentScrollY - previousScrollY) < 4) return;

      if (
        currentScrollY === 0 ||
        toggle?.getAttribute('aria-expanded') === 'true' ||
        header?.contains(document.activeElement)
      ) {
        setHeaderHidden(false);
      } else {
        setHeaderHidden(currentScrollY > previousScrollY);
      }

      previousScrollY = currentScrollY;
    },
    { passive: true },
  );

  header?.addEventListener('focusin', () => setHeaderHidden(false));
</script>
