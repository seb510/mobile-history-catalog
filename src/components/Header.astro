---
import Arrow from './Arrow.astro';
import LogoMark from './LogoMark.astro';
import GlobalSearch from './GlobalSearch.astro';
import ThemeToggle from './ThemeToggle.astro';
import DesignToggle from './DesignToggle.astro';
import { LOCALES, localePath, type Locale } from '../lib/locales';
import { t } from '../lib/ui-strings';

interface Props {
  locale: Locale;
  /** Unprefixed current path, e.g. "/", "/phones/nokia-3310/", "/about/". Used to build the
   * language-switcher links and the nav "active" state. */
  path: string;
}
const { locale, path } = Astro.props;
const strings = t(locale);
const settingsCopy = { uk: { style:'Стиль', language:'Мова', theme:'Тема' }, ru: { style:'Стиль', language:'Язык', theme:'Тема' }, en: { style:'Style', language:'Language', theme:'Theme' } }[locale];

const LOCALE_LABEL: Record<Locale, string> = { uk: 'UK', ru: 'RU', en: 'EN' };
const isActive = (target: string) =>
  path === target ||
  (target !== '/' && path.startsWith(target)) ||
  (target === '/catalog/' && path.startsWith('/phones/'));
const links = [
  { path: '/catalog/', label: strings.nav.catalog },
  { path: '/brands/', label: strings.nav.brands },
  { path: '/compare/', label: strings.nav.compare },
  { path: '/favorites/', label: strings.nav.favorites },
  { path: '/about/', label: strings.nav.about },
];
---

<header id="site-header" class="site-header sticky top-0 z-50 border-t-2 border-b border-t-orange-500 border-b-neutral-800 bg-neutral-950/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 h-14 sm:px-6">
    <a href={localePath(locale, '/')} class="flex min-w-0 items-center gap-2 text-neutral-100">
      <LogoMark class="h-7 w-7 shrink-0" />
      <span class="truncate text-sm font-bold tracking-tight sm:text-base" title={`${strings.siteName} — ${strings.brandLine}`}>{strings.siteName}</span>
    </a>

    <div class="header-actions flex items-center gap-1">
      <nav aria-label={strings.footer.navigation} class="hidden items-center gap-1 xl:flex">
        {links.map((link) => (
          <a href={localePath(locale, link.path)} class="header-nav-link" aria-current={isActive(link.path) ? 'page' : undefined}>
            {link.label}
            {link.path === '/favorites/' && <span data-favorite-count hidden class="favorite-count ml-1.5"></span>}
          </a>
        ))}
        <details class="language-dropdown">
          <summary aria-label={strings.langSwitcher}><span>{LOCALE_LABEL[locale]}</span><Arrow kind="chevron" direction="down" size={14} /></summary>
          <div class="language-options">
            {LOCALES.map(l => l === locale
              ? <span aria-current="page">{LOCALE_LABEL[l]}<span aria-hidden="true">✓</span></span>
              : <a href={localePath(l, path === '/404/' ? '/' : path)} lang={l} hreflang={l}>{LOCALE_LABEL[l]}</a>)}
          </div>
        </details>
        <DesignToggle locale={locale} />
        <ThemeToggle locale={locale} class="ml-1 h-11 w-11 rounded-sm" />
      </nav>
      <GlobalSearch locale={locale} />
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={strings.menu.open}
        data-label-open={strings.menu.open}
        data-label-close={strings.menu.close}
        class="menu-toggle flex h-11 w-11 shrink-0 items-center justify-center text-neutral-200 xl:hidden"
      >
        <span class="sr-only">{strings.menu.open}</span>
        <span class="menu-control-face">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-6 w-6" aria-hidden="true">
            <g class="icon-edition-magazine"><path class="menu-line-first" d="M4 8h16" /><path class="menu-line-last" d="M4 16h16" /></g>
            <g class="icon-edition-modern"><path class="menu-line-first" d="M6 8h12" /><path class="menu-line-last" d="M6 16h12" /></g>
          </svg>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden inert aria-hidden="true" class="mobile-menu-panel xl:hidden">
    <div class="mx-auto max-w-6xl px-4 pb-4 sm:px-6">
      <p class="editorial-kicker border-b border-neutral-800 py-4 text-orange-500">{strings.brandLine}</p>
      <nav aria-label={strings.footer.navigation}>
        {links.map((link, index) => <a class="mobile-nav-link" href={localePath(locale, link.path)} aria-current={isActive(link.path) ? 'page' : undefined}>
          <span aria-hidden="true" class="text-xs tabular-nums text-neutral-500">0{index + 1}</span>
          <span>{link.label}</span>
          {link.path === '/favorites/' && <span data-favorite-count hidden class="favorite-count"></span>}
          <Arrow direction="right" class="ml-auto text-neutral-500" />
        </a>)}
      </nav>
      <div class="mobile-settings">
        <div><p class="mobile-settings-label">{settingsCopy.language}</p>
        <div role="group" class="flex gap-1" aria-label={strings.langSwitcher}>
          {LOCALES.map((l) => l === locale
            ? <span aria-current="page" class="flex h-11 min-w-11 items-center justify-center rounded-sm border border-orange-500 text-sm font-bold text-orange-500">{LOCALE_LABEL[l]}</span>
            : <a href={localePath(l, path === '/404/' ? '/' : path)} class="flex h-11 min-w-11 items-center justify-center rounded-sm border border-neutral-800 text-sm text-neutral-300 hover-desktop:border-orange-500">{LOCALE_LABEL[l]}</a>)}
        </div>
        </div>
        <div><p class="mobile-settings-label">{settingsCopy.style}</p><DesignToggle locale={locale} mobile /></div>
        <div><p class="mobile-settings-label">{settingsCopy.theme}</p><ThemeToggle locale={locale} class="h-11 w-11 rounded-sm" /></div>
      </div>
    </div>
  </div>
</header>
<div id="menu-backdrop" class="menu-backdrop xl:hidden" hidden aria-hidden="true"></div>
<div data-search-backdrop class="search-backdrop" hidden aria-hidden="true"></div>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('menu-backdrop');
  const language = document.querySelector<HTMLDetailsElement>('.language-dropdown');
  document.addEventListener('pointerdown', event => {
    if (language && event.target instanceof Node && !language.contains(event.target)) language.open = false;
  });
  language?.addEventListener('keydown', event => {
    if (event.key === 'Escape') { language.open = false; language.querySelector('summary')?.focus(); }
  });
  language?.addEventListener('focusout', event => {
    if (event.relatedTarget instanceof Node && !language.contains(event.relatedTarget)) language.open = false;
  });
  let menuRevision = 0;
  const setHeaderHidden = (hidden: boolean) => {
    header?.classList.toggle('is-hidden', hidden);
    document.documentElement.dataset.headerHidden = String(hidden);
  };
  const setMenuOpen = (open: boolean) => {
    if (!toggle || !menu || !backdrop) return;
    if (toggle.getAttribute('aria-expanded') === String(open)) return;
    const revision = ++menuRevision;
    if (open) setHeaderHidden(false);
    menu.inert = !open;
    menu.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!);
    toggle.querySelector('.sr-only')!.textContent = open ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const motion = getComputedStyle(document.documentElement);
    const duration = reduced ? 0 : parseFloat(motion.getPropertyValue('--motion-ui')) || 180;
    const easing = motion.getPropertyValue('--motion-easing').trim() || 'ease-out';
    const transitions = [menu, backdrop].map((element) => {
      const wasHidden = element.hidden;
      const current = getComputedStyle(element);
      const from = { opacity: wasHidden ? '0' : current.opacity, transform: wasHidden && element === menu ? 'translateY(-10px)' : current.transform };
      element.getAnimations().forEach((animation) => animation.cancel());
      element.hidden = false;
      return element.animate([from, { opacity: open ? '1' : '0', transform: !open && element === menu ? 'translateY(-10px)' : 'none' }], { duration, easing, fill: 'both' });
    });
    Promise.all(transitions.map((animation) => animation.finished)).then(() => {
      if (revision !== menuRevision) return;
      menu.hidden = !open;
      backdrop.hidden = !open;
      transitions.forEach((animation) => animation.cancel());
    }).catch(() => { /* A newer toggle owns the interrupted transition. */ });
  };

  toggle?.addEventListener('click', () => {
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      toggle.focus();
    }
  });

  document.addEventListener('pointerdown', (event) => {
    if (
      event.target instanceof Node &&
      !menu?.contains(event.target) &&
      !toggle?.contains(event.target) &&
      toggle?.getAttribute('aria-expanded') === 'true'
    ) {
      setMenuOpen(false);
    }
  });

  window.matchMedia('(min-width: 1280px)').addEventListener('change', (event) => {
    if (event.matches) setMenuOpen(false);
  });

  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setMenuOpen(false);
  });
  header?.addEventListener('focusout', (event) => {
    if (event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) setMenuOpen(false);
  });

  let previousScrollY = window.scrollY;
  window.addEventListener(
    'scroll',
    () => {
      const currentScrollY = Math.max(0, window.scrollY);
      if (Math.abs(currentScrollY - previousScrollY) < 12) return;

      if (
        currentScrollY < 96 ||
        toggle?.getAttribute('aria-expanded') === 'true' ||
        header?.contains(document.activeElement)
      ) {
        setHeaderHidden(false);
      } else {
        setHeaderHidden(window.matchMedia('(min-width: 1280px)').matches && currentScrollY > previousScrollY);
      }

      previousScrollY = currentScrollY;
    },
    { passive: true },
  );

  header?.addEventListener('focusin', () => setHeaderHidden(false));
</script>
