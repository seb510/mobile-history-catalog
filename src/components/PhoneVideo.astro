---
import Arrow from './Arrow.astro';
import type { Locale } from '../lib/locales';
import PlaceholderArt from './PlaceholderArt.astro';
import { PHONE_VIDEOS } from '../lib/phone-videos';
const { locale, slug, poster } = Astro.props as { locale: Locale; slug: string; poster?: { image?: string; imageCredit?: string; imageSourceUrl?: string } };
const video = PHONE_VIDEOS[slug];
const c = {
 uk: { title:'Телефон у дії', subtitle:'Огляд своєї епохи',  consent:'Натискаючи «Дивитися відео», ти дозволяєш YouTube (Google) отримати IP-адресу й дані браузера та використовувати власне сховище для цього перегляду.', load:'Дивитися відео', remove:'Вимкнути плеєр', source:'PhoneArena · Дивитися на YouTube', fallback:'Якщо вбудований перегляд недоступний, відкрий відео на YouTube.',   },
 ru: { title:'Телефон в действии', subtitle:'Обзор своей эпохи',  consent:'Нажимая «Смотреть видео», ты разрешаешь YouTube (Google) получить IP-адрес и данные браузера и использовать собственное хранилище для этого просмотра.', load:'Смотреть видео', remove:'Отключить плеер', source:'PhoneArena · Смотреть на YouTube', fallback:'Если встроенный просмотр недоступен, открой видео на YouTube.',   },
 en: { title:'The phone in action', subtitle:'A review from its era',  consent:'By pressing “Watch video”, you allow YouTube (Google) to receive your IP address and browser information and use its own storage for this viewing.', load:'Watch video', remove:'Disable player', source:'PhoneArena · Watch on YouTube', fallback:'If embedded playback is unavailable, open the video on YouTube.',   },
}[locale];
---
<section id="phone-video" aria-labelledby="phone-video-title" class="phone-video mb-8 scroll-mt-24 overflow-hidden rounded-sm border border-neutral-700 bg-neutral-900 p-4 sm:p-5" data-phone-video data-video-id={video.id}>
 <p class="editorial-kicker text-orange-500">{video.walkthrough ? ({uk:'Меню та звук',ru:'Меню и звук',en:'Menus and sound'}[locale]) : video.promo ? ({uk:'Рекламний погляд',ru:'Рекламный взгляд',en:'Promotional perspective'}[locale]) : video.demonstration ? ({uk:'Механіка в русі',ru:'Механика в движении',en:'Mechanism in motion'}[locale]) : video.retrospective ? ({uk:'Ретроспектива',ru:'Ретроспектива',en:'Retrospective'}[locale]) : c.subtitle}{video.year && ` · ${video.year}`}</p>
 <h2 id="phone-video-title" class="mt-2 text-xl font-bold">{c.title}</h2>
 <p class="mt-2 text-sm leading-relaxed text-neutral-300">{video.description[locale]}</p>
 <div class="video-surface mt-4" data-video-surface data-title={`${video.author}: ${video.label}`}>
  <button type="button" class:list={['video-cover', poster?.image && 'has-photo']} data-video-load aria-describedby={`video-consent-${slug}`} aria-label={`${c.load}: ${video.label}`}><span class="video-cover-photo" aria-hidden="true">{poster?.image ? <><img data-image-fallback src={poster.image} alt="" loading="lazy" decoding="async" /><span data-image-fallback-placeholder class="hidden"><PlaceholderArt class="h-full w-full text-neutral-600" /></span></> : <PlaceholderArt class="h-full w-full text-neutral-600" />}</span><span class="video-cover-copy"><span class="text-xs tracking-widest">{video.label}</span><span aria-hidden="true" class="video-play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 6.5v11a1 1 0 0 0 1.52.85l9-5.5a1 1 0 0 0 0-1.7l-9-5.5A1 1 0 0 0 9 6.5Z"/></svg></span><span class="text-sm font-semibold">{c.load}</span></span></button>
 </div>
 <div data-video-consent>
  {poster?.imageCredit && <p class="mt-2 text-[0.65rem] leading-relaxed text-neutral-500">{({uk:"Фото обкладинки: ",ru:"Фото обложки: ",en:"Cover photo: "}[locale])}{poster.imageSourceUrl ? <a href={poster.imageSourceUrl} target="_blank" rel="noopener noreferrer" class="text-orange-500 underline underline-offset-2">{poster.imageCredit}</a> : poster.imageCredit}</p>}
  <p id={`video-consent-${slug}`} class="mt-3 text-xs leading-relaxed text-neutral-400">{c.consent}</p>
 </div>
 <div class="video-actions">
 <button type="button" class="control-button min-h-11 justify-center text-sm" data-video-remove hidden>{c.remove}</button>
 <a title={c.fallback} class="inline-flex min-h-11 items-center text-xs text-orange-500 underline underline-offset-4" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">{c.source.replace('PhoneArena', video.author)} <Arrow direction="up-right" size={14} /></a>
 </div>
</section>
<script>
 document.querySelectorAll<HTMLElement>('[data-phone-video]').forEach(root => {
  const surface = root.querySelector<HTMLElement>('[data-video-surface]')!;
  const cover = root.querySelector<HTMLElement>('[data-video-load]')!;
  const consent = root.querySelector<HTMLElement>('[data-video-consent]')!;
  const load = root.querySelector<HTMLButtonElement>('[data-video-load]')!;
  const remove = root.querySelector<HTMLButtonElement>('[data-video-remove]')!;
  load.addEventListener('click', () => {
   if (surface.querySelector('iframe')) return;
   const frame = document.createElement('iframe');
   frame.src = `https://www.youtube-nocookie.com/embed/${root.dataset.videoId}?autoplay=1&playsinline=1`;
   frame.title = surface.dataset.title!;
   frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
   frame.allowFullscreen = true;
   frame.referrerPolicy = 'strict-origin-when-cross-origin';
   cover.hidden = true; surface.append(frame); consent.hidden = true; remove.hidden = false;
   frame.focus();
  });
  remove.addEventListener('click', () => {
   surface.querySelector('iframe')?.remove(); cover.hidden = false; consent.hidden = false; remove.hidden = true; load.focus();
  });
 });
</script>
<style>
.phone-video [hidden] { display:none; }
.video-actions { display:flex; align-items:center; flex-wrap:wrap; gap:.75rem 1.25rem; margin-top:1rem; }
.video-actions a { overflow-wrap:anywhere; }
@media (max-width:639px) { .video-actions { align-items:stretch; flex-direction:column; gap:.5rem; } .video-actions a { padding-block:.375rem; } }
.video-surface { min-height:200px; aspect-ratio:16/9; width:100%; position:relative; border:1px solid var(--color-neutral-700); background:var(--color-neutral-950); }
/* With a poster photo (.has-photo), the photo fills the whole box edge to edge
   and the controls float on top of a bottom scrim — a two-column split left a
   wide empty gap once this section became full-width in the modern layout. The
   icon-only fallback (no poster) keeps the original centered-on-gradient look. */
.video-cover { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; width:100%; padding:1.25rem; cursor:pointer; text-align:center; color:var(--color-neutral-400); background:radial-gradient(ellipse at center,var(--color-neutral-800),transparent 80%); }
.video-cover.has-photo { align-items:flex-end; color:#fff; background:none; }
.video-cover:focus-visible { outline:2px solid var(--color-orange-500); outline-offset:-4px; }
@media (hover:hover) and (pointer:fine) {
  .video-cover:not(.has-photo):hover { color:var(--color-orange-500); }
  .video-cover.has-photo:hover .video-cover-copy { color:var(--color-orange-500); }
}
.video-cover-photo { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.video-cover-photo img { width:100%; height:100%; object-fit:cover; }
.video-cover.has-photo .video-cover-photo::after { content:''; position:absolute; inset:0; background:linear-gradient(to top,rgba(10,8,16,.82) 0%,rgba(10,8,16,.4) 48%,rgba(10,8,16,.05) 75%); }
.video-cover-copy { position:relative; z-index:1; display:flex; min-width:0; flex-direction:column; align-items:center; gap:.625rem; }
.video-cover.has-photo .video-cover-copy { padding-block-start:3rem; }
@media (max-width:639px) { .video-cover-copy { gap:.5rem; } .video-cover-copy > span:first-child { font-size:.625rem; letter-spacing:.08em; } }
.video-play {
  position:relative;
  display:flex;
  align-items:center;
  justify-content:center;
  width:4.25rem;
  height:4.25rem;
  border-radius:999px;
  background:var(--color-orange-500);
  color:#fff;
  box-shadow:0 6px 18px rgba(0,0,0,.4);
  transition:transform var(--motion-ui) var(--motion-easing), box-shadow var(--motion-ui) var(--motion-easing);
}
.video-play svg { width:1.875rem; height:1.875rem; margin-inline-start:.1875rem; }
.video-play::after {
  content:'';
  position:absolute;
  inset:0;
  border-radius:inherit;
  border:2px solid var(--color-orange-500);
  animation:video-play-pulse 2.4s ease-out infinite;
}
@keyframes video-play-pulse {
  0% { transform:scale(1); opacity:.55; }
  75%, 100% { transform:scale(1.55); opacity:0; }
}
@media (hover:hover) and (pointer:fine) {
  .video-cover:hover .video-play { transform:scale(1.08); box-shadow:0 8px 22px rgba(0,0,0,.5); }
}
.video-cover:focus-visible .video-play { transform:scale(1.08); }
@media (prefers-reduced-motion:reduce) {
  .video-play, .video-cover:hover .video-play, .video-cover:focus-visible .video-play { transition:none; }
  .video-play::after { animation:none; display:none; }
}
@media (max-width:639px) { .video-play { width:3.5rem; height:3.5rem; } .video-play svg { width:1.5rem; height:1.5rem; } }
.video-surface :global(iframe) { width:100%; height:100%; position:absolute; inset:0; border:0; }
</style>
