---
import type { Locale } from '../lib/locales';
import { PHONE_VIDEOS } from '../lib/phone-videos';
const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const video = PHONE_VIDEOS[slug];
const c = {
 uk: { title:'Телефон у дії', subtitle:'Огляд своєї епохи',  consent:'Натискаючи «Дивитися відео», ти дозволяєш YouTube (Google) отримати IP-адресу й дані браузера та використовувати власне сховище для цього перегляду.', load:'Дивитися відео', remove:'Вимкнути плеєр', source:'PhoneArena · Дивитися на YouTube ↗', fallback:'Якщо вбудований перегляд недоступний, відкрий відео на YouTube.',   },
 ru: { title:'Телефон в действии', subtitle:'Обзор своей эпохи',  consent:'Нажимая «Смотреть видео», ты разрешаешь YouTube (Google) получить IP-адрес и данные браузера и использовать собственное хранилище для этого просмотра.', load:'Смотреть видео', remove:'Отключить плеер', source:'PhoneArena · Смотреть на YouTube ↗', fallback:'Если встроенный просмотр недоступен, открой видео на YouTube.',   },
 en: { title:'The phone in action', subtitle:'A review from its era',  consent:'By pressing “Watch video”, you allow YouTube (Google) to receive your IP address and browser information and use its own storage for this viewing.', load:'Watch video', remove:'Disable player', source:'PhoneArena · Watch on YouTube ↗', fallback:'If embedded playback is unavailable, open the video on YouTube.',   },
}[locale];
---
<section id="phone-video" aria-labelledby="phone-video-title" class="phone-video mb-8 scroll-mt-24 overflow-hidden rounded-sm border border-neutral-700 bg-neutral-900 p-4 sm:p-5" data-phone-video data-video-id={video.id}>
 <p class="editorial-kicker text-orange-500">{video.walkthrough ? ({uk:'Меню та звук',ru:'Меню и звук',en:'Menus and sound'}[locale]) : video.promo ? ({uk:'Рекламний погляд',ru:'Рекламный взгляд',en:'Promotional perspective'}[locale]) : video.demonstration ? ({uk:'Механіка в русі',ru:'Механика в движении',en:'Mechanism in motion'}[locale]) : video.retrospective ? ({uk:'Ретроспектива',ru:'Ретроспектива',en:'Retrospective'}[locale]) : c.subtitle}{video.year && ` · ${video.year}`}</p>
 <h2 id="phone-video-title" class="mt-2 text-xl font-bold">{c.title}</h2>
 <p class="mt-2 text-sm leading-relaxed text-neutral-300">{video.description[locale]}</p>
 <div class="video-surface mt-4" data-video-surface data-title={`${video.author}: ${video.label}`}>
  <button type="button" class="video-cover" data-video-load aria-describedby={`video-consent-${slug}`} aria-label={`${c.load}: ${video.label}`}><span aria-hidden="true" class="video-play">▷</span><span class="text-sm font-semibold">{c.load}</span><span class="text-xs tracking-widest">{video.label}</span></button>
 </div>
 <div data-video-consent>
  <p id={`video-consent-${slug}`} class="mt-3 text-xs leading-relaxed text-neutral-400">{c.consent}</p>
 </div>
 <div class="video-actions">
 <button type="button" class="control-button min-h-11 justify-center text-sm" data-video-remove hidden>{c.remove}</button>
 <a title={c.fallback} class="inline-flex min-h-11 items-center text-xs text-orange-500 underline underline-offset-4" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">{c.source.replace('PhoneArena', video.author)}</a>
 </div>
</section>
<script>
 document.querySelectorAll<HTMLElement>('[data-phone-video]').forEach(root => {
  const surface = root.querySelector<HTMLElement>('[data-video-surface]')!;
  const cover = root.querySelector<HTMLElement>('[data-video-load]')!;
  const consent = root.querySelector<HTMLElement>('[data-video-consent]')!;
  const load = root.querySelector<HTMLButtonElement>('[data-video-load]')!;
  const remove = root.querySelector<HTMLButtonElement>('[data-video-remove]')!;
  load.addEventListener('click', () => {
   if (surface.querySelector('iframe')) return;
   const frame = document.createElement('iframe');
   frame.src = `https://www.youtube-nocookie.com/embed/${root.dataset.videoId}?autoplay=1&playsinline=1`;
   frame.title = surface.dataset.title!;
   frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
   frame.allowFullscreen = true;
   frame.referrerPolicy = 'strict-origin-when-cross-origin';
   cover.hidden = true; surface.append(frame); consent.hidden = true; remove.hidden = false;
   frame.focus();
  });
  remove.addEventListener('click', () => {
   surface.querySelector('iframe')?.remove(); cover.hidden = false; consent.hidden = false; remove.hidden = true; load.focus();
  });
 });
</script>
<style>
.phone-video [hidden] { display:none; }
.video-actions { display:flex; align-items:center; flex-wrap:wrap; gap:.75rem 1.25rem; margin-top:1rem; }
.video-actions a { overflow-wrap:anywhere; }
@media (max-width:639px) { .video-actions { align-items:stretch; flex-direction:column; gap:.5rem; } .video-actions a { padding-block:.375rem; } }
.video-surface { min-height:200px; aspect-ratio:16/9; width:100%; position:relative; border:1px solid var(--color-neutral-700); background:var(--color-neutral-950); }
.video-cover { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.625rem; width:100%; padding:1rem; cursor:pointer; text-align:center; color:var(--color-neutral-400); background:radial-gradient(ellipse at center,var(--color-neutral-800),transparent 80%); }
.video-cover:focus-visible { outline:2px solid var(--color-orange-500); outline-offset:-4px; }
@media (hover:hover) and (pointer:fine) { .video-cover:hover { color:var(--color-orange-500); } }
.video-play { font-size:3rem; color:var(--color-orange-500); line-height:1; }
.video-surface :global(iframe) { width:100%; height:100%; position:absolute; inset:0; border:0; }
</style>
