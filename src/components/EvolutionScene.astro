---
import Arrow from './Arrow.astro';
import PlaceholderArt from './PlaceholderArt.astro';
import { evolutionCopy, type EvolutionFrame } from '../lib/evolution';
import { evolutionYears } from '../lib/evolution-years';
import { museumImageCredit } from '../lib/image-attribution';
import { localePath, type Locale } from '../lib/locales';
import { GALLERY_INTERACTION, t } from '../lib/ui-strings';

interface Props { locale: Locale; stops: EvolutionFrame[]; brand?: string }
const { locale, stops, brand } = Astro.props;
const copy = evolutionCopy[locale];
const spreadCopy = locale === 'uk'
  ? { style: 'Стиль перегляду', classic: 'Класичний', spread: 'Розворот', details: 'Докладніше про', compare: 'Порівняти з', camera: 'Передня камера праворуч від динаміка.', headline: 'Телефон уже можна тримати екраном до себе' }
  : { style: 'View style', classic: 'Classic', spread: 'Spread', details: 'Explore', compare: 'Compare with', camera: 'The front camera sits to the right of the earpiece.', headline: 'You could face the screen during a call' };
const id = brand ? 'brand-evolution' : 'phone-evolution';
const titleId = `${id}-title`;
const close = t(locale).gallery.close;
const zoom = GALLERY_INTERACTION[locale];
const firstFrameByYear = new Map<number, number>();
stops.forEach(({ phone }, index) => {
  if (!firstFrameByYear.has(phone.year)) firstFrameByYear.set(phone.year, index);
});
// Use the gallery's localized alt text and attribution with the selected photograph.
const galleryShots: Record<string, string> = {
  'nokia-3210': '/images/phones/nokia-3210/commons-main.webp',
  'siemens-s55': '/images/phones/siemens-s55/commons-main.webp',
  'sony-ericsson-t610': '/images/phones/sony-ericsson-t610/commons-main.webp',
  'nokia-n95': '/images/phones/nokia-n95/media-and-camera.webp',
  'nokia-n86': 'https://upload.wikimedia.org/wikipedia/commons/thumb/0/01/Nokia_N86_8MP_-_Back_%28Open%2C_camera_slider_open%29.jpg/960px-Nokia_N86_8MP_-_Back_%28Open%2C_camera_slider_open%29.jpg',
  'sony-xperia-z': '/images/phones/sony-xperia-z/side.webp',
};
---

<dialog id={id} class="evolution-dialog" data-evolution-dialog aria-labelledby={titleId}>
  <section class="evolution" data-evolution data-view-style="spread">
    <div class="scene" data-evolution-scene>
      <header class="scene-heading">
        <div>
          <h2 id={titleId}>{brand ? `${copy.brandTitle} · ${brand}` : copy.title}</h2>
          {stops.length > 1 && <p>{brand ? copy.brandIntro : copy.intro}</p>}
        </div>
        <div class="style-switch" role="group" aria-label={spreadCopy.style}>
          <button type="button" data-view="classic" aria-label={spreadCopy.classic} aria-pressed="false">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="4" width="19" height="16" rx="2"/><path d="M3 15h18M6 17.5h3m2 0h3"/></svg>
            <span class="view-tip" aria-hidden="true">{spreadCopy.classic}</span>
          </button>
          <button type="button" data-view="spread" aria-label={spreadCopy.spread} aria-pressed="true">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 5Q7 2 2 4v15q5-2 10 1 5-3 10-1V4q-5-2-10 1Zm0 0v15m3-11h4m-4 4h4"/></svg>
            <span class="view-tip" aria-hidden="true">{spreadCopy.spread}</span>
          </button>
        </div>
        <button class="close-scene" type="button" data-close-evolution aria-label={close} title={close} autofocus>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
      </header>

      <div class="frames">
        {stops.map(({ slug, phone, label, description }, index) => {
          const name = phone.model.startsWith(`${phone.brand} `) ? phone.model : `${phone.brand} ${phone.model}`;
          const shot = phone.evolutionImage ?? phone.gallery?.find(frame => frame.image === galleryShots[slug]);
          const image = shot?.image ?? phone.image;
          const imageAlt = shot?.alt ?? phone.imageCaption ?? name;
          const caption = slug === 'samsung-galaxy-s' ? spreadCopy.camera : shot?.alt ?? phone.imageCaption;
          const prior = stops[index - 1]?.phone;
          const context = evolutionYears[phone.year];
          const contextText = context?.[locale];
          const external = context?.source.startsWith('https://');
          const priorName = prior && (prior.model.startsWith(prior.brand + ' ') ? prior.model : `${prior.brand} ${prior.model}`);
          const source = shot ? null : museumImageCredit(phone, locale);
          const credit = shot?.imageCredit ?? source?.label ?? phone.imageCredit;
          const creditUrl = shot
            ? shot.imageSourceUrl
            : source?.href ?? phone.imageSourceUrl;
          const extraPhotos = (phone.gallery ?? []).filter(photo => photo.image !== image && photo.image.startsWith('/images/'));
          return (
            <article class="frame" data-evolution-frame data-evolution-year={phone.year} data-announcement={[phone.year, name, label ?? description].filter(Boolean).join(' · ')}>
              <figure class="artwork">
                <div class="photo-surface" data-photo-year={phone.year}>
                {image && <img data-evolution-src={image} alt={imageAlt} class="hidden" decoding="async" />}
                <div data-image-fallback-placeholder><PlaceholderArt /></div>
                {image && <button type="button" class="photo-inspect" data-inspect aria-pressed="false" aria-label={zoom.zoomIn} data-zoom-in={zoom.zoomIn} data-zoom-out={zoom.zoomOut}>
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6M7 10h6"/><path class="zoom-plus" d="M10 7v6"/></svg>
                </button>}
                {image && extraPhotos.length > 0 && <button type="button" class="photo-cycle" data-photo-cycle data-photos={JSON.stringify(extraPhotos)} aria-label={locale === 'uk' ? 'Наступне фото телефона' : 'Next phone photo'}>
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="7" y="7" width="14" height="13" rx="2"/><path d="M3 16V5a2 2 0 0 1 2-2h12M9 17l4-4 3 3 2-2 3 3"/></svg>
                  <span>{locale === 'uk' ? 'Ще фото' : 'More photos'}</span>
                  <span data-photo-position>1/{extraPhotos.length + 1}</span>
                </button>}
                </div>
                {image && (caption || credit || extraPhotos.length > 0) && <figcaption class="spread-only" aria-live="polite">
                  {caption && <span>{caption}</span>}
                  {credit && <span class="credit">{creditUrl ? <a href={creditUrl} target="_blank" rel="noopener noreferrer">{credit}</a> : credit}</span>}
                </figcaption>}
              </figure>
              <div class="story">
                <p class="year">{phone.year}</p>
                <h3>{name}</h3>
                {label && <p class="milestone">{slug === 'samsung-galaxy-s' ? <><span class="classic-only">{label}</span><span class="spread-only">{spreadCopy.headline}</span></> : label}</p>}
                {description && <p class="description">{description}</p>}
                {context && contextText && <aside class="tech-context">
                  <p class="tech-date">{locale === 'uk' ? 'Технології року' : 'Technology of the year'} · {phone.year}</p>
                  <h4><a href={external ? context.source : localePath(locale, context.source)} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{contextText[0]} <span aria-hidden="true">↗</span></a></h4>
                  <p>{contextText[1]}</p>
                </aside>}
                <div class="scene-links"><a class="details" href={localePath(locale, `/phones/${slug}/`)}>
                  <span class="classic-only">{copy.details}</span><span class="spread-only">{spreadCopy.details} {phone.model}</span><span aria-hidden="true">→</span>
                </a>
                  {index > 0 && <a class="details" href={`${localePath(locale, '/compare/')}?${new URLSearchParams({ a: stops[index - 1].slug, b: slug })}`}><span class="classic-only">{ { uk: 'Порівняти з попереднім', ru: 'Сравнить с предыдущим', en: 'Compare with previous' }[locale] }</span><span class="spread-only">{spreadCopy.compare} {priorName}</span></a>}
                </div>
                {credit && <p class="classic-only credit">
                  {creditUrl ? <a href={creditUrl} target="_blank" rel="noopener noreferrer">{credit}</a> : credit}
                </p>}
              </div>
            </article>
          );
        })}
      </div>

      <div class="controls" data-evolution-controls hidden>
        <button class="arrow" type="button" data-evolution-prev aria-label={copy.previous} title={copy.previous}><Arrow direction="left" /></button>
        <div class="year-rail" data-evolution-rail>
          <nav class="years" data-evolution-years aria-label={copy.timeline}>
            {[...firstFrameByYear].map(([year, index]) => (
              <button type="button" data-evolution-step={index} data-evolution-year={year} class:list={[year % 10 === 0 && 'decade']}>{year}</button>
            ))}
          </nav>
        </div>
        <button class="arrow" type="button" data-evolution-next aria-label={copy.next} title={copy.next}><Arrow /></button>
      </div>
      <p class="sr-only" aria-live="polite" data-evolution-status></p>
    </div>
  </section>
</dialog>

<script>
  import { initEvolution } from '../scripts/evolution';

  for (const dialog of document.querySelectorAll<HTMLDialogElement>('[data-evolution-dialog]')) {
    const timeline = dialog.querySelector<HTMLElement>('[data-evolution]');
    const trigger = document.querySelector<HTMLButtonElement>(`[aria-controls="${dialog.id}"]`);
    if (!trigger || !timeline) continue;
    let refresh: (() => void) | undefined;
    let pageScroll = 0;
    const allowParallax = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
    const resetInspection = () => {
      const button = timeline.querySelector<HTMLButtonElement>('[data-inspect][aria-pressed="true"]');
      if (!button) return;
      button.setAttribute('aria-pressed', 'false');
      button.setAttribute('aria-label', button.dataset.zoomIn!);
    };
    for (const button of timeline.querySelectorAll<HTMLButtonElement>('[data-inspect]')) {
      const surface = button.parentElement!;
      const aim = (x: number, y: number) => {
        const bounds = surface.getBoundingClientRect();
        surface.style.setProperty('--inspect-at', `${100 * (x - bounds.left) / bounds.width}% ${100 * (y - bounds.top) / bounds.height}%`);
      };
      button.addEventListener('click', event => {
        const open = button.getAttribute('aria-pressed') === 'false';
        resetInspection();
        if (!open) return;
        if (event.detail) aim(event.clientX, event.clientY);
        else surface.style.setProperty('--inspect-at', 'center');
        button.setAttribute('aria-pressed', 'true');
        button.setAttribute('aria-label', button.dataset.zoomOut!);
      });
      button.addEventListener('pointermove', event => {
        if (event.pointerType !== 'mouse') return;
        if (button.getAttribute('aria-pressed') === 'true') {
          aim(event.clientX, event.clientY);
        } else if (allowParallax.matches) {
          const bounds = surface.getBoundingClientRect();
          surface.style.setProperty('--depth-x', `${(event.clientX - bounds.left) / bounds.width * 10 - 5}px`);
          surface.style.setProperty('--depth-y', `${(event.clientY - bounds.top) / bounds.height * 8 - 4}px`);
        }
      });
      button.addEventListener('pointerleave', () => {
        surface.style.removeProperty('--depth-x');
        surface.style.removeProperty('--depth-y');
      });
    }
    timeline.addEventListener('evolution-frame-change', resetInspection);
    for (const button of timeline.querySelectorAll<HTMLButtonElement>('[data-photo-cycle]')) {
      const figure = button.closest('figure')!;
      const photo = figure.querySelector<HTMLImageElement>('img')!;
      const caption = figure.querySelector('figcaption')!;
      const originalCaption = [...caption.childNodes];
      const originalAlt = photo.alt;
      const originalSrc = photo.dataset.evolutionSrc!;
      const extra: { image: string; alt: string; caption?: string; imageCredit: string; imageSourceUrl?: string }[] = JSON.parse(button.dataset.photos!);
      let position = 0;
      let revision = 0;
      const fadePhoto = () => {
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          photo.animate([{ opacity: .1 }, { opacity: 1 }], { duration: 220, easing: 'ease-out' });
        }
      };
      const restore = () => {
        revision++;
        if (!position) return;
        position = 0;
        photo.src = originalSrc;
        photo.alt = originalAlt;
        caption.replaceChildren(...originalCaption);
        button.querySelector('[data-photo-position]')!.textContent = `1/${extra.length + 1}`;
      };
      button.addEventListener('click', async () => {
        resetInspection();
        const next = (position + 1) % (extra.length + 1);
        if (!next) { restore(); fadePhoto(); return; }
        const item = extra[next - 1];
        const request = ++revision;
        const preload = new Image();
        preload.src = item.image;
        try { await preload.decode(); } catch { return; }
        if (revision !== request) return;
        position = next;
        photo.src = item.image;
        fadePhoto();
        photo.alt = item.alt;
        photo.classList.remove('hidden');
        figure.querySelector('[data-image-fallback-placeholder]')?.classList.add('hidden');
        const text = document.createElement('span');
        text.textContent = item.caption ?? item.alt;
        const credit = document.createElement('span');
        credit.className = 'credit';
        if (item.imageSourceUrl) {
          const link = document.createElement('a');
          link.href = item.imageSourceUrl;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.textContent = item.imageCredit;
          credit.append(link);
        } else credit.textContent = item.imageCredit;
        caption.replaceChildren(text, credit);
        button.querySelector('[data-photo-position]')!.textContent = `${next + 1}/${extra.length + 1}`;
      });
      timeline.addEventListener('evolution-frame-change', restore);
      dialog.querySelector('[data-view="classic"]')?.addEventListener('click', restore);
      dialog.addEventListener('close', restore);
    }
    dialog.addEventListener('close', resetInspection);
    const viewButtons = [...dialog.querySelectorAll<HTMLButtonElement>('[data-view]')];
    for (const button of viewButtons) {
      button.addEventListener('click', () => {
        resetInspection();
        timeline.dataset.viewStyle = button.dataset.view;
        for (const option of viewButtons) option.setAttribute('aria-pressed', String(option === button));
        refresh?.();
      });
    }
    trigger.hidden = false;
    trigger.addEventListener('click', () => {
      if (dialog.open) return;
      pageScroll = window.scrollY;
      dialog.showModal();
      dialog.scrollTop = 0;
      if (refresh) refresh();
      else refresh = initEvolution(timeline, dialog);
    });
    if (trigger.id && location.hash === `#${trigger.id}`) trigger.scrollIntoView({ block: 'start', behavior: 'instant' });
    dialog.querySelector('[data-close-evolution]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      trigger.focus({ preventScroll: true });
      window.scrollTo({ top: pageScroll, behavior: 'instant' });
    });
  }
</script>

<style>
  .evolution-dialog {
    position: fixed;
    inset: 0;
    margin: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    overflow: auto;
    overscroll-behavior: contain;
    overflow-anchor: none;
    scrollbar-width: none;
    background: #151e2a;
  }
  .evolution-dialog::-webkit-scrollbar { display: none; }
  .evolution-dialog::backdrop { background: rgb(9 12 20 / 68%); }
  :global(html:has([data-evolution-dialog][open])) { overflow: hidden; }

  @media (prefers-reduced-motion: no-preference) {
    .evolution-dialog[open] { animation: evolution-open 290ms cubic-bezier(.2, .75, .3, 1) both; }
    .evolution-dialog[open]::backdrop { animation: evolution-backdrop 220ms ease-out both; }
  }

  @keyframes evolution-open {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes evolution-backdrop {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .evolution {
    --scene-bg: #151e2a;
    --scene-text: #f5f2eb;
    --scene-muted: #bbc7d5;
    --scene-accent: #ffc28e;
    --scene-rule: #74849b60;
    --scene-height: 100vh;
    background: var(--scene-bg);
  }
  @supports (height: 100dvh) {
    .evolution { --scene-height: 100dvh; }
  }

  :global(html[data-design="modern"]) .evolution {
    --scene-bg: #141a24;
    --scene-muted: #c1cde0;
    --scene-accent: #5eead4;
    --scene-rule: #8fa0b866;
  }
  .evolution[data-scroll] {
    block-size: calc(var(--scene-height) + var(--walk));
  }

  .scene {
    display: grid;
    gap: clamp(.5rem, 2vh, 1.25rem);
    padding: clamp(1rem, 3vw, 2rem);
    min-height: var(--scene-height);
    width: min(100%, 78rem);
    margin-inline: auto;
    background: var(--scene-bg);
    color: var(--scene-text);
  }
  :global(html[data-design="modern"]) .scene {
    background-color:var(--scene-bg);
    background-image:radial-gradient(ellipse at 85% 4%,#668cf933,transparent 32rem),radial-gradient(ellipse at 12% 90%,#f0786122,transparent 26rem);
  }

  [data-scroll] .scene {
    position: sticky;
    inset-block-start: 0;
    block-size: var(--scene-height);
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  [data-scroll] :is(.scene-heading, .frames, .controls > *) {
    touch-action: pan-x pinch-zoom;
  }

  .evolution:not([data-scroll]) .scene-heading {
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    background: var(--scene-bg);
  }

  .scene-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .25rem 1rem;
    padding-block-end: .65rem;
    border-block-end: 1px solid var(--scene-rule);
  }

  .scene-heading h2 { font-size: clamp(1rem, 2.4vw, 1.45rem); font-weight: 750; }
  .scene-heading p { color: var(--scene-muted); font-size: .82rem; }
  .frames { display: grid; gap: 1.5rem; min-block-size: 0; }
  [data-scroll] .frames { grid-template: minmax(0, 1fr) / minmax(0, 1fr); gap: 0; }

  .frame {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    grid-template-areas: 'artwork story';
    align-items: center;
    gap: clamp(1rem, 5vw, 4rem);
    min-height: 0;
  }

  [data-scroll] .frame {
    grid-area: 1 / 1;
    visibility: hidden;
    pointer-events: none;
  }

  [data-scroll] .frame[data-active] { visibility: visible; pointer-events: auto; }

  .artwork {
    grid-area: artwork;
    position: relative;
    display: grid;
    place-items: center;
    block-size: clamp(14rem, 46vh, 30rem);
    min-height: 0;
    overflow: hidden;
    border: 1px solid #ffffff26;
    border-radius: 1rem;
    background: radial-gradient(ellipse at 50% 44%, #e9e8ee, #a4afbf 85%);
    color: #243042;
  }

  [data-scroll] .artwork {
    align-self: stretch;
    block-size: auto;
  }

  .artwork img, .artwork [data-image-fallback-placeholder] {
    position: absolute;
    inset: 5%;
    inline-size: 90%;
    block-size: 90%;
    object-fit: contain;
    object-position: center;
  }
  [data-scroll] .frame[data-active] .artwork :is(img, [data-image-fallback-placeholder]) { opacity: var(--frame-opacity, 1); }

  .story { grid-area: story; display: grid; align-content: center; gap: .4rem; min-inline-size: 0; }
  [data-scroll] .story { align-content: start; min-block-size: var(--story-height, 0px); }
  [data-scroll] .frame:not([data-active]) .story { visibility: hidden; }
  [data-scroll] .frame[data-active] .story { opacity: var(--frame-caption, 1); }
  .year {
    color: var(--scene-accent);
    font-size: clamp(2.4rem, 9vw, 6.8rem);
    font-weight: 760;
    font-variant-numeric: tabular-nums;
    line-height: .95;
  }
  .story :is(h2, h3) { font-size: clamp(1.3rem, 3.4vw, 2.7rem); font-weight: 750; line-height: 1.08; }
  .milestone { color: var(--scene-accent); font-size: clamp(1rem, 2vw, 1.25rem); font-weight: 650; }
  .description { max-inline-size: 36ch; color: var(--scene-muted); font-size: clamp(.85rem, 1.7vw, 1.05rem); line-height: 1.45; }
  .scene-links { display: flex; flex-wrap: wrap; gap: 0 1rem; }
  .details { justify-self: start; display: inline-flex; align-items: center; gap: .4em; min-height: 2rem; color: var(--scene-text); text-decoration: underline; text-underline-offset: .2em; font-size: .85rem; }
  .credit { color: var(--scene-muted); font-size: .7rem; overflow-wrap: anywhere; }
  .credit a { text-decoration: underline; text-underline-offset: .15em; }

  .controls:not([hidden]) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: .45rem;
    padding-block-start: .5rem;
    border-block-start: 1px solid var(--scene-rule);
  }

  .year-rail { position: relative; min-width: 0; }
  .year-rail::before, .year-rail::after {
    content: '';
    position: absolute;
    inset-block: 0;
    z-index: 1;
    width: 1.25rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--motion-ui) var(--motion-easing);
  }
  .year-rail::before { inset-inline-start: 0; background: linear-gradient(to right, var(--scene-bg), transparent); }
  .year-rail::after { inset-inline-end: 0; background: linear-gradient(to left, var(--scene-bg), transparent); }
  .year-rail[data-more-start]::before, .year-rail[data-more-end]::after { opacity: 1; }
  .years {
    display: flex;
    justify-content: safe center;
    gap: clamp(0rem, .8vw, .55rem);
    min-width: 0;
    padding-inline: .2rem;
    overflow-x: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  .years::-webkit-scrollbar { display: none; }
  .controls :is(.arrow, .years button) {
    min-block-size: 2.75rem;
    border: 1px solid transparent;
    border-radius: .5rem;
    color: var(--scene-muted);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .controls .arrow { display: grid; place-items: center; inline-size: 2.75rem; block-size: 2.75rem; padding: 0; border-color: var(--scene-rule); color: var(--scene-text); }
  .close-scene { display: grid; flex: 0 0 2.75rem; min-height: 2.75rem; place-items: center; border: 1px solid var(--scene-rule); border-radius: .5rem; cursor: pointer; }
  .controls .arrow[aria-disabled="true"] { opacity: .45; cursor: default; }
  .controls .years button {
    flex: none;
    min-inline-size: 2.75rem;
    padding-inline: .3rem;
    font-size: clamp(.75rem, 2.3vw, .9rem);
    font-weight: 600;
    transition: color var(--motion-ui) var(--motion-easing), border-color var(--motion-ui) var(--motion-easing);
  }
  .controls .years button[aria-current="step"] { color: var(--scene-accent); border-block-end-color: var(--scene-accent); }
