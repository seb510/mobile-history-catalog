---
import Arrow from './Arrow.astro';
import { OWNERSHIP_COPY } from '../lib/ownership-copy';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PhoneCard from './PhoneCard.astro';
import FilterSelect from './FilterSelect.astro';
import { getPhonesForLocale, slugOf } from '../lib/phones';
import { t, FINAL_DESIGN_COPY, OWNED_PHONE_COPY } from '../lib/ui-strings';
import { localePath, type Locale } from '../lib/locales';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const strings = t(locale);
const copy = FINAL_DESIGN_COPY[locale];
const ownedCopy = OWNED_PHONE_COPY[locale];
const periodCopy = OWNERSHIP_COPY[locale];
const phoneCount = strings.brands.phoneCount;
const comparePath = localePath(locale, '/compare/');

const phones = (await getPhonesForLocale(locale)).sort((a, b) => a.data.year - b.data.year);
---

<Layout locale={locale} path="/favorites/" title={`${strings.nav.favorites} — ${strings.siteName}`} description={strings.favorites.intro}>
  <Breadcrumbs locale={locale} items={[{ label: strings.breadcrumbs.home, path: '/' }, { label: strings.nav.favorites }]} />
  <header class="mb-7 max-w-3xl border-b border-neutral-800 pb-6">
    <h1 class="page-title">{strings.nav.favorites}</h1>
    <p class="mt-4 max-w-2xl leading-relaxed text-neutral-400">{strings.favorites.intro}</p>
    <p class="mt-2 text-sm text-neutral-500">{strings.favorites.storageNote}</p>
  </header>

  <section data-legacy-section hidden class="mb-8 border border-neutral-700 bg-neutral-900 p-4 sm:p-6" aria-labelledby="legacy-title">
    <h2 id="legacy-title" class="text-xl font-bold">{ownedCopy.legacyTitle}</h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-400">{ownedCopy.legacyIntro}</p>
    <ul class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">{phones.map(phone=><li data-legacy-item data-slug={slugOf(phone)} hidden class="min-w-0"><div class="flex"><PhoneCard phone={phone} locale={locale} compact /></div><button type="button" data-legacy-dismiss={slugOf(phone)} class="mt-2 min-h-11 text-left text-xs text-neutral-400 underline underline-offset-4">{ownedCopy.dismiss}</button></li>)}</ul>
  </section>
  <p data-favorites-loading role="status" class="py-8 text-sm text-neutral-500">{copy.loading}</p>
  <noscript><style is:inline>[data-favorites-loading] { display: none; }</style><p class="mb-6 border border-neutral-700 p-4 text-sm text-neutral-300">{copy.noScript}</p></noscript>
  <div data-favorites-empty hidden class="favorites-empty rounded-sm border border-neutral-800 bg-neutral-900/40 px-5 py-10 text-center text-neutral-400 sm:py-12">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="mx-auto mb-4 h-8 w-8 text-orange-500" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M8 2.5h8a2 2 0 0 1 2 2v15a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-15a2 2 0 0 1 2-2Z M10 5h4 M10 12l2 2 4-4 M11 18h2" /></svg>
    <h2 class="text-xl font-bold text-neutral-100">{strings.favorites.emptyTitle}</h2>
    <p class="mt-2 text-sm leading-relaxed">{strings.favorites.emptyBody}</p>
    <a class="primary-cta mt-5 inline-flex min-h-11 items-center rounded-sm bg-orange-500 px-4 py-3 text-sm font-semibold text-neutral-950 transition-colors motion-ui" href={localePath(locale, '/catalog/')}>{strings.nav.catalog} <Arrow /></a>
  </div>

  <div data-favorites-toolbar hidden class="favorites-toolbar mb-5 flex flex-wrap items-center justify-between gap-4 rounded-sm border border-neutral-800 border-t-2 border-t-orange-500 bg-neutral-900/40 p-4">
    <div class="flex flex-wrap items-center gap-3">
      <p
        data-favorites-count
        data-one={phoneCount.one}
        data-few={'few' in phoneCount ? phoneCount.few : phoneCount.many}
        data-many={phoneCount.many}
        data-locale={locale}
        data-suffix={strings.favorites.inCollection}
        role="status"
        class="text-sm font-semibold tabular-nums text-neutral-200"
      ></p>
      <a
        data-favorites-compare-cta
        data-compare-base={comparePath}
        hidden
        href={comparePath}
        class="inline-flex min-h-11 items-center text-sm font-semibold text-orange-500 underline underline-offset-4 transition-colors motion-ui hover-desktop:text-orange-400"
      >
        {strings.favorites.comparePair} <Arrow />
      </a>
    </div>
    <div class="w-full sm:w-56">
      <FilterSelect
        name="sort"
        label={strings.favorites.sortLabel}
        all={strings.favorites.sortNewest}
        defaultValue="personal"
        allowEmpty={false}
        options={[
          { value: 'personal', label: periodCopy.personal },
          { value: 'year-asc', label: strings.favorites.sortOldest },
          { value: 'year-desc', label: strings.favorites.sortNewest },
        ]}
      />
    </div>
  </div>

  <p data-period-hint hidden class="mb-5 text-sm leading-relaxed text-neutral-500">{periodCopy.hint}</p>
  <p data-period-status role="status" aria-live="polite" class="mb-3 text-sm text-orange-500"></p>
  <ol data-favorites-list hidden class="grid grid-cols-2 items-start gap-3 sm:grid-cols-3 lg:grid-cols-4">
    {phones.map((phone) => (
      <li data-favorite-item data-slug={slugOf(phone)} data-year={phone.data.year} class="flex min-w-0 flex-col" hidden>
        <div class="ownership-heading mb-2 flex items-start justify-between gap-1 border-l-2 border-orange-500 pl-2">
          <div class="min-w-0"><p data-period-label class="text-sm font-bold tabular-nums text-orange-500">{periodCopy.unknown}</p><p class="mt-1 text-xs text-neutral-500">{periodCopy.release}: {phone.data.year}</p></div>
          <button type="button" data-period-open data-slug={slugOf(phone)} data-model={phone.data.brand+' '+phone.data.model} data-year={phone.data.year} aria-label={periodCopy.add+' — '+phone.data.brand+' '+phone.data.model} title={periodCopy.add} class="period-edit-button" hidden><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5 4 4M4 20l4-1L20 7a2.8 2.8 0 0 0-4-4L4 15Z"/></svg></button>
        </div>
        <PhoneCard phone={phone} locale={locale} compact />
      </li>
    ))}
  </ol>
  <dialog data-period-dialog class="period-dialog" aria-labelledby="period-dialog-title" data-locale={locale}>
    <div class="flex items-start justify-between gap-4"><div><p class="editorial-kicker text-orange-500">{periodCopy.edit}</p><h2 id="period-dialog-title" class="mt-2 text-xl font-bold"></h2></div><button type="button" data-period-close class="control-button h-11 w-11 justify-center" aria-label={periodCopy.close}><svg width="20" height="20" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <form data-period-form class="ownership-form mt-5 grid gap-4">
      <label>{periodCopy.start}<input name="start" type="number" inputmode="numeric" min="1980" max={new Date().getFullYear()} step="1" required /></label>
      <label>{periodCopy.end}<input name="end" type="number" inputmode="numeric" min="1980" max={new Date().getFullYear()} step="1" /></label>
      <label class="ownership-current"><input name="current" type="checkbox" />{periodCopy.current}</label>
      <p data-period-error role="alert" class="text-sm text-orange-500"></p>
      <button type="submit" class="primary-cta control-button justify-center text-sm">{periodCopy.save}</button>
      <button type="button" data-period-clear class="min-h-11 text-sm text-neutral-400 underline underline-offset-4">{periodCopy.clear}</button>
    </form>
  </dialog>
</Layout>

<script>
  import { readPeriods, savePeriod, PERIODS_KEY, validPeriod } from '../lib/ownership-periods';
  import { OWNERSHIP_COPY } from '../lib/ownership-copy';
  import { readFavorites, readLegacyFavorites, dismissLegacyFavorite, FAVORITES_CHANGED_EVENT } from '../scripts/favorites';

  const empty = document.querySelector<HTMLElement>('[data-favorites-empty]');
  const loading = document.querySelector<HTMLElement>('[data-favorites-loading]');
  const toolbar = document.querySelector<HTMLElement>('[data-favorites-toolbar]');
  const list = document.querySelector<HTMLUListElement>('[data-favorites-list]');
  const count = document.querySelector<HTMLElement>('[data-favorites-count]');
  const compareCta = document.querySelector<HTMLAnchorElement>('[data-favorites-compare-cta]');
  const sortSelect = document.querySelector<HTMLSelectElement>('[data-filter="sort"]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-favorite-item]'));

  function wordFor(n: number): string {
    if (!count) return '';
    const { one, few, many, locale } = count.dataset as Record<string, string>;
    if (locale === 'en') return n === 1 ? one : many;
    const lastTwo = n % 100;
    const last = n % 10;
    if (last === 1 && lastTwo !== 11) return one;
    if (last >= 2 && last <= 4 && (lastTwo < 12 || lastTwo > 14)) return few ?? many;
    return many;
  }

  function applySort() {
    if (!list || !sortSelect) return;
    const direction = sortSelect.value === 'year-asc' ? 1 : -1;
    const periods = readPeriods();
    const sorted = items.slice().sort((a, b) => sortSelect.value === 'personal'
      ? (periods[a.dataset.slug!]?.start ?? Infinity) - (periods[b.dataset.slug!]?.start ?? Infinity) || Number(a.dataset.year) - Number(b.dataset.year)
      : direction * (Number(a.dataset.year) - Number(b.dataset.year)));
    const active = document.activeElement instanceof HTMLElement && list.contains(document.activeElement) ? document.activeElement : null;
    for (const item of sorted) list.append(item);
    if (active && !active.closest('[hidden]')) active.focus({ preventScroll:true });
  }

  function render() {
    if (!empty || !toolbar || !list || !count) return;
    const focusedLegacy = document.activeElement?.closest<HTMLElement>('[data-legacy-item]');
    const focusedItem = document.activeElement?.closest<HTMLElement>('[data-favorite-item]');
    const previousIndex = focusedItem ? Array.from(list.children).filter((item) => !(item as HTMLElement).hidden).indexOf(focusedItem) : -1;
    const favorites = readFavorites();
    const legacy = readLegacyFavorites();
    let pending = 0;
    document.querySelectorAll<HTMLElement>('[data-legacy-item]').forEach(item=>{ item.hidden = !legacy.has(item.dataset.slug!) || favorites.has(item.dataset.slug!); if(!item.hidden)pending++; });
    const legacySection=document.querySelector<HTMLElement>('[data-legacy-section]');
    if(legacySection)legacySection.hidden=pending===0;
    const visibleSlugs: string[] = [];
    let visible = 0;
    for (const item of items) {
      const active = favorites.has(item.dataset.slug!);
      item.hidden = !active;
      if (active) { visible++; visibleSlugs.push(item.dataset.slug!); }
    }
    empty.hidden = visible > 0;
    toolbar.hidden = visible === 0;
    list.hidden = visible === 0;
    const hint = document.querySelector<HTMLElement>('[data-period-hint]');
    if (hint) hint.hidden = visible === 0;
    if (!visible) document.querySelector('[data-period-status]')!.textContent = '';
    count.textContent = `${visible} ${wordFor(visible)} ${count.dataset.suffix}`;
    if (loading) loading.hidden = true;
    if (compareCta) {
      if (visibleSlugs.length === 2) {
        const [a, b] = visibleSlugs;
        compareCta.href = `${compareCta.dataset.compareBase}?a=${encodeURIComponent(a)}&b=${encodeURIComponent(b)}`;
        compareCta.hidden = false;
      } else {
        compareCta.hidden = true;
      }
    }
    syncPeriods();
    applySort();
    if (focusedLegacy?.hidden) {
      const confirmed = items.find(item=>!item.hidden && item.dataset.slug===focusedLegacy.dataset.slug);
      (confirmed?.querySelector<HTMLButtonElement>('[data-favorite-toggle]') ?? empty.querySelector<HTMLAnchorElement>('a'))?.focus();
    }
    if (focusedItem?.hidden) {
      const remaining = Array.from(list.children).filter((item) => !(item as HTMLElement).hidden);
      const next = remaining[Math.min(Math.max(previousIndex, 0), remaining.length - 1)];
      (next?.querySelector<HTMLButtonElement>('[data-favorite-toggle]') ?? empty.querySelector<HTMLAnchorElement>('a'))?.focus();
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-legacy-dismiss]').forEach(button => button.addEventListener('click',()=>{ dismissLegacyFavorite(button.dataset.legacyDismiss!); const target = document.querySelector<HTMLElement>('[data-legacy-section]')?.hidden ? empty?.querySelector<HTMLElement>('a') : document.querySelector<HTMLElement>('#legacy-title'); target?.setAttribute('tabindex','-1'); target?.focus(); }));
  const dialog = document.querySelector<HTMLDialogElement>('[data-period-dialog]')!;
  const form = dialog.querySelector<HTMLFormElement>('[data-period-form]')!;
  const c = OWNERSHIP_COPY[dialog.dataset.locale as keyof typeof OWNERSHIP_COPY];
  const startInput = form.elements.namedItem('start') as HTMLInputElement;
  const endInput = form.elements.namedItem('end') as HTMLInputElement;
  const current = form.elements.namedItem('current') as HTMLInputElement;
  const error = form.querySelector('[data-period-error]')!;
  let editedSlug = '';
  let periodOpener: HTMLButtonElement | null = null;
  function syncPeriods() {
    const periods = readPeriods();
    for (const item of items) {
      const period = periods[item.dataset.slug!];
      item.querySelector('[data-period-label]')!.textContent = period ? String(period.start) + (period.current ? ' — ' + c.present : period.end && period.end !== period.start ? ' — ' + period.end : '') : c.unknown;
      const button = item.querySelector<HTMLButtonElement>('[data-period-open]')!;
      button.hidden = false;
      button.title = period ? c.edit : c.add;
      button.setAttribute('aria-label', button.title + ' — ' + button.dataset.model);
    }
    if (dialog.open && !readFavorites().has(editedSlug)) dialog.close();
  }
  document.querySelectorAll<HTMLButtonElement>('[data-period-open]').forEach(button => button.addEventListener('click', () => {
    periodOpener = button; editedSlug = button.dataset.slug!;
    const period = readPeriods()[editedSlug];
    dialog.querySelector('#period-dialog-title')!.textContent = button.dataset.model!;
    startInput.min = button.dataset.year!;
    startInput.value = period ? String(period.start) : '';
    endInput.value = period?.end ? String(period.end) : '';
    current.checked = period?.current ?? false; endInput.disabled = current.checked;
    error.textContent = ''; dialog.showModal(); startInput.focus();
  }));
  current.addEventListener('change', () => { endInput.disabled = current.checked; });
  dialog.querySelector('[data-period-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => {
    const r = dialog.getBoundingClientRect();
    if (event.target === dialog && (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom)) dialog.close();
  });
  dialog.addEventListener('close', () => { if (periodOpener && !periodOpener.closest('[hidden]')) periodOpener.focus({preventScroll:true}); });
  const commit = (clear: boolean) => {
    const period = { start:Number(startInput.value), ...(endInput.value && !current.checked ? {end:Number(endInput.value)} : {}), current:current.checked };
    if (!clear && (!validPeriod(period) || period.start < Number(startInput.min))) { error.textContent = c.invalid; return; }
    if (!readFavorites().has(editedSlug)) { dialog.close(); return; }
    if (!savePeriod(editedSlug, clear ? undefined : period)) { error.textContent = c.error; return; }
    dialog.close(); syncPeriods(); applySort();
    document.querySelector('[data-period-status]')!.textContent = clear ? c.removed : c.saved;
  };
  form.addEventListener('submit', event => { event.preventDefault(); commit(false); });
  form.querySelector('[data-period-clear]')!.addEventListener('click', () => commit(true));
  window.addEventListener('storage', event => { if (event.key === PERIODS_KEY || event.key === null) { syncPeriods(); applySort(); } });
  sortSelect?.addEventListener('change', applySort);
  render();
  document.addEventListener(FAVORITES_CHANGED_EVENT, render);
  window.addEventListener('pageshow', (event) => { if (event.persisted) render(); });
</script>
