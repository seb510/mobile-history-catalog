---
import Arrow from './Arrow.astro';
import { ACCOUNT_COPY, CABINET_COPY, COLLECTION_COPY, OWNERSHIP_COPY } from '../lib/ownership-copy';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PhoneCard from './PhoneCard.astro';
import FilterSelect from './FilterSelect.astro';
import { getPhonesForLocale, slugOf } from '../lib/phones';
import { t, FINAL_DESIGN_COPY, OWNED_PHONE_COPY } from '../lib/ui-strings';
import { localePath, type Locale } from '../lib/locales';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const strings = t(locale);
const copy = FINAL_DESIGN_COPY[locale];
const ownedCopy = OWNED_PHONE_COPY[locale];
const periodCopy = OWNERSHIP_COPY[locale];
const collectionCopy = COLLECTION_COPY[locale];
const cabinetCopy = CABINET_COPY[locale];
const comparePath = localePath(locale, '/compare/');

const phones = (await getPhonesForLocale(locale)).sort((a, b) => a.data.year - b.data.year);
---

<Layout locale={locale} path="/favorites/" title={`${strings.nav.favorites} — ${strings.siteName}`} description={strings.favorites.intro}>
  <Breadcrumbs locale={locale} items={[{ label: strings.breadcrumbs.home, path: '/' }, { label: strings.nav.favorites }]} />
  <div class="mb-7 grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_19rem]">
    <header class="editorial-card rounded-sm border border-neutral-800 border-t-2 border-t-orange-500 bg-neutral-900/40 p-5 sm:p-7">
      <p class="editorial-kicker text-orange-500">{cabinetCopy.title}</p>
      <h1 class="page-title mt-2">{strings.nav.favorites}</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-neutral-400">{strings.favorites.intro}</p>
      <dl data-cabinet-stats hidden class="mt-5 grid grid-cols-3 gap-3 border-t border-neutral-800 pt-4">
        <div><dt class="text-xs text-neutral-400">{cabinetCopy.total}</dt><dd data-favorites-count class="mt-1 text-2xl font-bold tabular-nums">0</dd></div>
        <div><dt class="text-xs text-neutral-400">{cabinetCopy.dated}</dt><dd data-cabinet-dated class="mt-1 text-2xl font-bold tabular-nums">0</dd></div>
        <div><dt class="text-xs text-neutral-400">{cabinetCopy.current}</dt><dd data-cabinet-current class="mt-1 text-2xl font-bold tabular-nums">0</dd></div>
      </dl>
      <button type="button" data-collection-add hidden class="primary-cta mt-5 min-h-11 rounded-sm bg-orange-500 px-4 text-sm font-semibold text-neutral-950">{collectionCopy.add}</button>
    </header>
    <section class="editorial-card rounded-sm border border-neutral-800 bg-neutral-900/40 p-5" aria-labelledby="collection-account-title">
      <h2 id="collection-account-title" tabindex="-1" class="scroll-mt-24 text-lg font-bold">{cabinetCopy.account}</h2>
      <p data-collection-account-mode aria-live="polite" class="mt-3 inline-flex rounded-sm bg-neutral-950 px-2.5 py-1 text-xs font-semibold text-orange-500">{ACCOUNT_COPY[locale].signedOut}</p>
      <p data-collection-account-note class="mt-2 text-sm leading-relaxed text-neutral-400">{cabinetCopy.localNote}</p>
      <a data-collection-sign-in hidden class="primary-cta mt-4 flex min-h-11 w-full items-center justify-center gap-2 rounded-sm bg-orange-500 px-3 text-center text-sm font-semibold text-neutral-950" href={`/api/collection/login?lang=${locale}`}>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4M4 12h11m-4-4 4 4-4 4"/></svg>
        {collectionCopy.signIn}
      </a>
      <p data-collection-sync-status role="status" class="mt-4 text-sm font-medium text-neutral-300 empty:hidden"></p>
      <button type="button" data-collection-sign-out hidden class="control-button mt-3 min-h-11">{collectionCopy.signOut}</button>
    </section>
  </div>

  <section data-legacy-section hidden class="mb-8 border border-neutral-700 bg-neutral-900 p-4 sm:p-6" aria-labelledby="legacy-title">
    <h2 id="legacy-title" class="text-xl font-bold">{ownedCopy.legacyTitle}</h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-400">{ownedCopy.legacyIntro}</p>
    <ul class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">{phones.map(phone=><li data-legacy-item data-slug={slugOf(phone)} hidden class="min-w-0"><div class="flex"><PhoneCard phone={phone} locale={locale} compact /></div><button type="button" data-legacy-dismiss={slugOf(phone)} class="mt-2 min-h-11 text-left text-xs text-neutral-400 underline underline-offset-4">{ownedCopy.dismiss}</button></li>)}</ul>
  </section>
  <p data-favorites-loading role="status" class="py-8 text-sm text-neutral-500">{copy.loading}</p>
  <noscript><style is:inline>[data-favorites-loading] { display: none; }</style><p class="mb-6 border border-neutral-700 p-4 text-sm text-neutral-300">{copy.noScript}</p></noscript>
  <div data-favorites-empty hidden class="favorites-empty rounded-sm border border-neutral-800 bg-neutral-900/40 px-5 py-10 text-center text-neutral-400 sm:py-12">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="mx-auto mb-4 h-8 w-8 text-orange-500" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M8 2.5h8a2 2 0 0 1 2 2v15a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-15a2 2 0 0 1 2-2Z M10 5h4 M10 12l2 2 4-4 M11 18h2" /></svg>
    <h2 class="text-xl font-bold text-neutral-100">{strings.favorites.emptyTitle}</h2>
    <p class="mt-2 text-sm leading-relaxed">{strings.favorites.emptyBody}</p>
    <a class="control-button mt-5 min-h-11" href={localePath(locale, '/catalog/')}>{strings.nav.catalog} <Arrow /></a>
  </div>

  <div data-favorites-toolbar hidden class="favorites-toolbar mb-5 flex flex-wrap items-center justify-between gap-4 rounded-sm border border-neutral-800 border-t-2 border-t-orange-500 bg-neutral-900/40 p-4">
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="text-lg font-bold">{periodCopy.personal}</h2>
      <a
        data-favorites-compare-cta
        data-compare-base={comparePath}
        hidden
        href={comparePath}
        class="inline-flex min-h-11 items-center text-sm font-semibold text-orange-500 underline underline-offset-4 transition-colors motion-ui hover-desktop:text-orange-400"
      >
        {strings.favorites.comparePair} <Arrow />
      </a>
    </div>
    <div class="w-full sm:w-56">
      <FilterSelect
        name="sort"
        label={strings.favorites.sortLabel}
        all={strings.favorites.sortNewest}
        defaultValue="personal"
        allowEmpty={false}
        options={[
          { value: 'personal', label: periodCopy.personal },
          { value: 'year-asc', label: strings.favorites.sortOldest },
          { value: 'year-desc', label: strings.favorites.sortNewest },
        ]}
      />
    </div>
  </div>

  <p data-period-hint hidden class="mb-5 text-sm leading-relaxed text-neutral-500">{periodCopy.hint}</p>
  <p data-period-status role="status" aria-live="polite" class="mb-3 text-sm text-orange-500"></p>
  <ol data-favorites-list hidden class="grid grid-cols-2 items-start gap-3 sm:grid-cols-3 lg:grid-cols-4">
    {phones.map((phone) => (
      <li data-favorite-item data-slug={slugOf(phone)} data-year={phone.data.year} class="flex min-w-0 flex-col" hidden>
        <div class="ownership-heading mb-2 flex items-start justify-between gap-1 border-l-2 border-orange-500 pl-2">
          <div class="min-w-0"><p data-period-label class="text-sm font-bold tabular-nums text-orange-500">{periodCopy.unknown}</p><p class="mt-1 text-xs text-neutral-500">{periodCopy.release}: {phone.data.year}</p></div>
          <button type="button" data-period-open data-slug={slugOf(phone)} data-model={phone.data.brand+' '+phone.data.model} data-year={phone.data.year} aria-label={periodCopy.add+' — '+phone.data.brand+' '+phone.data.model} title={periodCopy.add} class="period-edit-button" hidden><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5 4 4M4 20l4-1L20 7a2.8 2.8 0 0 0-4-4L4 15Z"/></svg></button>
        </div>
        <PhoneCard phone={phone} locale={locale} compact />
      </li>
    ))}
  </ol>
  <dialog data-collection-picker class="period-dialog collection-picker" aria-labelledby="collection-picker-title">
    <div class="period-dialog-header flex items-center justify-between gap-4">
      <h2 id="collection-picker-title" class="text-xl font-bold">{collectionCopy.add}</h2>
      <button type="button" data-collection-close class="control-button h-11 w-11 shrink-0 justify-center" aria-label={periodCopy.close} title={periodCopy.close}>
        <svg width="20" height="20" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="ownership-form mt-4 grid gap-3">
      <label class="collection-search-label">
        <span>{collectionCopy.search}</span>
        <span class="collection-search-field">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="5.5"/><path d="m15 15 4.5 4.5"/></svg>
          <input type="search" data-collection-search autocomplete="off" placeholder="Nokia 3310" />
        </span>
      </label>
      <p data-collection-empty role="status" hidden class="text-sm text-neutral-400">{collectionCopy.empty}</p>
      <ul class="collection-results grid gap-1.5 overflow-auto">
        {phones.map(phone => <li hidden>
          <button type="button" data-collection-choice data-slug={slugOf(phone)} data-model={phone.data.brand+' '+phone.data.model} data-year={phone.data.year} class="control-button collection-choice min-h-11 w-full text-left">
            <span>{phone.data.brand} {phone.data.model}</span><span class="text-xs text-neutral-400">{phone.data.year}</span>
          </button>
        </li>)}
      </ul>
    </div>
  </dialog>
  <dialog data-period-dialog class="period-dialog" aria-labelledby="period-dialog-title" data-locale={locale}>
    <div class="period-dialog-header flex items-start justify-between gap-4"><div><p data-period-heading class="editorial-kicker text-orange-500">{periodCopy.edit}</p><h2 id="period-dialog-title" class="mt-2 text-xl font-bold"></h2></div><button type="button" data-period-close class="control-button h-11 w-11 justify-center" aria-label={periodCopy.close}><svg width="20" height="20" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <p id="period-dialog-help" class="period-dialog-help">{periodCopy.approximate}</p>
    <form data-period-form aria-describedby="period-dialog-help" class="ownership-form mt-5 grid gap-4">
      <div class="period-years">
      <label>{periodCopy.from}<input aria-label={periodCopy.start} name="start" type="number" inputmode="numeric" min="1980" max={new Date().getFullYear()} step="1" required /></label>
      <label>{periodCopy.until}<input aria-label={periodCopy.end} name="end" type="number" inputmode="numeric" min="1980" max={new Date().getFullYear()} step="1" /></label>
      </div>
      <label class="ownership-current"><input name="current" type="checkbox" />{periodCopy.current}</label>
      <p data-period-error role="alert" class="text-sm text-orange-500"></p>
      <div class="period-dialog-actions">
      <button type="submit" class="primary-cta period-save justify-center text-sm">{periodCopy.save}</button>
      <button type="button" data-period-clear class="period-clear">{periodCopy.clear}</button>
      <button type="button" data-period-skip hidden class="period-clear">{collectionCopy.skip}</button>
      <button type="button" data-period-back hidden class="period-clear">{collectionCopy.back}</button>
      </div>
    </form>
  </dialog>
</Layout>

<style>
  .collection-picker { width: min(36rem, calc(100vw - 1.5rem)); }
  .collection-search-label { font-weight: 650; }
  .collection-search-field {
    display: flex;
    align-items: center;
    gap: .625rem;
    min-height: 3rem;
    padding-inline: .75rem;
    border: 1px solid var(--color-neutral-600);
    border-radius: .375rem;
    background: var(--color-neutral-900);
    color: var(--color-orange-500);
  }
  .collection-search-field:focus-within {
    border-color: var(--color-orange-500);
    box-shadow: 0 0 0 1px var(--color-orange-500);
  }
  .collection-search-field svg { flex: none; }
  .collection-search-field input {
    min-width: 0;
    width: 100%;
    min-height: 2.875rem;
    color: var(--color-neutral-100);
    font-size: 1rem;
    font-weight: 400;
    outline: none;
  }
  .collection-results { max-height: min(23rem, 48dvh); padding-right: .25rem; }
  .collection-choice { justify-content: space-between; gap: .75rem; }
</style>

<script>
  import { readPeriods, savePeriod, PERIODS_KEY, validPeriod } from '../lib/ownership-periods';
  import { COLLECTION_COPY, OWNERSHIP_COPY } from '../lib/ownership-copy';
  import { addFavorite, readFavorites, readLegacyFavorites, dismissLegacyFavorite, FAVORITES_CHANGED_EVENT } from '../scripts/favorites';

  const empty = document.querySelector<HTMLElement>('[data-favorites-empty]');
  const loading = document.querySelector<HTMLElement>('[data-favorites-loading]');
  const toolbar = document.querySelector<HTMLElement>('[data-favorites-toolbar]');
  const list = document.querySelector<HTMLUListElement>('[data-favorites-list]');
  const count = document.querySelector<HTMLElement>('[data-favorites-count]');
  const compareCta = document.querySelector<HTMLAnchorElement>('[data-favorites-compare-cta]');
  const sortSelect = document.querySelector<HTMLSelectElement>('[data-filter="sort"]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-favorite-item]'));

  const stats = document.querySelector<HTMLElement>('[data-cabinet-stats]')!;
  const datedCount = stats.querySelector('[data-cabinet-dated]')!;
  const currentCount = stats.querySelector('[data-cabinet-current]')!;

  function applySort() {
    if (!list || !sortSelect) return;
    const direction = sortSelect.value === 'year-asc' ? 1 : -1;
    const periods = readPeriods();
    const sorted = items.slice().sort((a, b) => sortSelect.value === 'personal'
      ? (periods[a.dataset.slug!]?.start ?? Infinity) - (periods[b.dataset.slug!]?.start ?? Infinity) || Number(a.dataset.year) - Number(b.dataset.year)
      : direction * (Number(a.dataset.year) - Number(b.dataset.year)));
    const active = document.activeElement instanceof HTMLElement && list.contains(document.activeElement) ? document.activeElement : null;
    for (const item of sorted) list.append(item);
    if (active && !active.closest('[hidden]')) active.focus({ preventScroll:true });
  }

  function render() {
    if (!empty || !toolbar || !list || !count) return;
    const focusedLegacy = document.activeElement?.closest<HTMLElement>('[data-legacy-item]');
    const focusedItem = document.activeElement?.closest<HTMLElement>('[data-favorite-item]');
    const previousIndex = focusedItem ? Array.from(list.children).filter((item) => !(item as HTMLElement).hidden).indexOf(focusedItem) : -1;
    const favorites = readFavorites();
    const legacy = readLegacyFavorites();
    let pending = 0;
    document.querySelectorAll<HTMLElement>('[data-legacy-item]').forEach(item=>{ item.hidden = !legacy.has(item.dataset.slug!) || favorites.has(item.dataset.slug!); if(!item.hidden)pending++; });
    const legacySection=document.querySelector<HTMLElement>('[data-legacy-section]');
    if(legacySection)legacySection.hidden=pending===0;
    const visibleSlugs: string[] = [];
    let visible = 0;
    for (const item of items) {
      const active = favorites.has(item.dataset.slug!);
      item.hidden = !active;
      if (active) { visible++; visibleSlugs.push(item.dataset.slug!); }
    }
    empty.hidden = visible > 0;
    toolbar.hidden = visible === 0;
    list.hidden = visible === 0;
    const hint = document.querySelector<HTMLElement>('[data-period-hint]');
    if (hint) hint.hidden = visible === 0;
    if (!visible) document.querySelector('[data-period-status]')!.textContent = '';
    const periods = readPeriods();
    const dated = visibleSlugs.filter(slug => periods[slug]);
    count.textContent = String(visible);
    datedCount.textContent = String(dated.length);
    currentCount.textContent = String(dated.filter(slug => periods[slug].current).length);
    stats.hidden = false;
    if (loading) loading.hidden = true;
    if (compareCta) {
      if (visibleSlugs.length === 2) {
        const [a, b] = visibleSlugs;
        compareCta.href = `${compareCta.dataset.compareBase}?a=${encodeURIComponent(a)}&b=${encodeURIComponent(b)}`;
        compareCta.hidden = false;
      } else {
        compareCta.hidden = true;
      }
    }
    syncPeriods();
    applySort();
    if (focusedLegacy?.hidden) {
      const confirmed = items.find(item=>!item.hidden && item.dataset.slug===focusedLegacy.dataset.slug);
      (confirmed?.querySelector<HTMLButtonElement>('[data-favorite-toggle]') ?? empty.querySelector<HTMLAnchorElement>('a'))?.focus();
    }
    if (focusedItem?.hidden) {
      const remaining = Array.from(list.children).filter((item) => !(item as HTMLElement).hidden);
      const next = remaining[Math.min(Math.max(previousIndex, 0), remaining.length - 1)];
      (next?.querySelector<HTMLButtonElement>('[data-favorite-toggle]') ?? empty.querySelector<HTMLAnchorElement>('a'))?.focus();
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-legacy-dismiss]').forEach(button => button.addEventListener('click',()=>{ dismissLegacyFavorite(button.dataset.legacyDismiss!); const target = document.querySelector<HTMLElement>('[data-legacy-section]')?.hidden ? empty?.querySelector<HTMLElement>('a') : document.querySelector<HTMLElement>('#legacy-title'); target?.setAttribute('tabindex','-1'); target?.focus(); }));
  const dialog = document.querySelector<HTMLDialogElement>('[data-period-dialog]')!;
  const form = dialog.querySelector<HTMLFormElement>('[data-period-form]')!;
  const c = OWNERSHIP_COPY[dialog.dataset.locale as keyof typeof OWNERSHIP_COPY];
  const startInput = form.elements.namedItem('start') as HTMLInputElement;
  const endInput = form.elements.namedItem('end') as HTMLInputElement;
  const current = form.elements.namedItem('current') as HTMLInputElement;
  const error = form.querySelector('[data-period-error]')!;
  let editedSlug = '';
  let periodOpener: HTMLButtonElement | null = null;
  let adding = false;
  const addButton = document.querySelector<HTMLButtonElement>('[data-collection-add]')!;
  const picker = document.querySelector<HTMLDialogElement>('[data-collection-picker]')!;
  const search = picker.querySelector<HTMLInputElement>('[data-collection-search]')!;
  const choices = [...picker.querySelectorAll<HTMLButtonElement>('[data-collection-choice]')];
  const collectionCopy = COLLECTION_COPY[dialog.dataset.locale as keyof typeof COLLECTION_COPY];
  function filterChoices() {
    const terms = search.value.trim().toLowerCase().split(/\s+/);
    const favorites = readFavorites();
    let shown = 0;
    for (const button of choices) {
      const label = `${button.dataset.model} ${button.dataset.year} ${button.dataset.slug}`.toLowerCase();
      const show = shown < 20 && !favorites.has(button.dataset.slug!) && terms.every(term => label.includes(term));
      button.closest('li')!.hidden = !show;
      if (show) shown++;
    }
    picker.querySelector<HTMLElement>('[data-collection-empty]')!.hidden = shown > 0;
  }
  function openPicker() {
    filterChoices();
    picker.showModal();
    search.focus();
  }
  addButton.hidden = false;
  addButton.addEventListener('click', () => { search.value = ''; openPicker(); });
  search.addEventListener('input', filterChoices);
  search.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    event.preventDefault();
    picker.close();
  });
  picker.querySelector('[data-collection-close]')!.addEventListener('click', () => picker.close());
  document.addEventListener(FAVORITES_CHANGED_EVENT, () => { if (picker.open) filterChoices(); });
  function syncPeriods() {
    const periods = readPeriods();
    for (const item of items) {
      const period = periods[item.dataset.slug!];
      item.querySelector('[data-period-label]')!.textContent = period ? String(period.start) + (period.current ? ' — ' + c.present : period.end && period.end !== period.start ? ' — ' + period.end : '') : c.unknown;
      const button = item.querySelector<HTMLButtonElement>('[data-period-open]')!;
      button.hidden = false;
      button.title = period ? c.edit : c.add;
      button.setAttribute('aria-label', button.title + ' — ' + button.dataset.model);
    }
    if (dialog.open && !adding && !readFavorites().has(editedSlug)) dialog.close();
  }
  function openPeriod(button: HTMLButtonElement, isNew: boolean) {
    adding = isNew;
    periodOpener = isNew ? addButton : button;
    editedSlug = button.dataset.slug!;
    const period = isNew ? undefined : readPeriods()[editedSlug];
    dialog.querySelector('[data-period-heading]')!.textContent = isNew ? collectionCopy.years : c.edit;
    dialog.querySelector('#period-dialog-title')!.textContent = button.dataset.model!;
    startInput.min = button.dataset.year!;
    startInput.value = period ? String(period.start) : '';
    endInput.value = period?.end ? String(period.end) : '';
    current.checked = period?.current ?? false; endInput.disabled = current.checked;
    error.textContent = '';
    form.querySelector<HTMLButtonElement>('[data-period-clear]')!.hidden = !period;
    form.querySelector<HTMLButtonElement>('[data-period-skip]')!.hidden = !isNew;
    form.querySelector<HTMLButtonElement>('[data-period-back]')!.hidden = !isNew;
    dialog.showModal();
    startInput.focus();
  }
  document.querySelectorAll<HTMLButtonElement>('[data-period-open]').forEach(button => button.addEventListener('click', () => openPeriod(button, false)));
  for (const button of choices) button.addEventListener('click', () => { picker.close(); openPeriod(button, true); });
  form.querySelector('[data-period-back]')!.addEventListener('click', () => { dialog.close(); openPicker(); });
  current.addEventListener('change', () => { endInput.disabled = current.checked; });
  dialog.querySelector('[data-period-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => {
    const r = dialog.getBoundingClientRect();
    if (event.target === dialog && (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom)) dialog.close();
  });
  dialog.addEventListener('close', () => { if (!picker.open && periodOpener && !periodOpener.closest('[hidden]')) periodOpener.focus({preventScroll:true}); });
  const commit = (clear: boolean) => {
    const period = { start:Number(startInput.value), ...(endInput.value && !current.checked ? {end:Number(endInput.value)} : {}), current:current.checked };
    if (!clear && (!validPeriod(period) || period.start < Number(startInput.min))) { error.textContent = c.invalid; return; }
    if (!adding && !readFavorites().has(editedSlug)) { dialog.close(); return; }
    if (adding && readFavorites().has(editedSlug)) { dialog.close(); return; }
    if (!savePeriod(editedSlug, clear ? undefined : period)) { error.textContent = c.error; return; }
    if (adding && !addFavorite(editedSlug)) {
      savePeriod(editedSlug);
      error.textContent = c.error;
      return;
    }
    dialog.close(); syncPeriods(); applySort();
    document.dispatchEvent(new CustomEvent(FAVORITES_CHANGED_EVENT));
    document.querySelector('[data-period-status]')!.textContent = adding ? collectionCopy.added : clear ? c.removed : c.saved;
  };
  form.addEventListener('submit', event => { event.preventDefault(); commit(false); });
  form.querySelector('[data-period-clear]')!.addEventListener('click', () => commit(true));
  form.querySelector('[data-period-skip]')!.addEventListener('click', () => commit(true));
  window.addEventListener('storage', event => { if (event.key === PERIODS_KEY || event.key === null) render(); });
  sortSelect?.addEventListener('change', applySort);
  render();
  document.addEventListener(FAVORITES_CHANGED_EVENT, render);
  window.addEventListener('pageshow', (event) => { if (event.persisted) render(); });
</script>
