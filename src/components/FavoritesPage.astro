---
import Arrow from './Arrow.astro';
import { ACCOUNT_COPY, CABINET_COPY, COLLECTION_COPY, OWNERSHIP_COPY } from '../lib/ownership-copy';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PhoneCard from './PhoneCard.astro';
import FilterSelect from './FilterSelect.astro';
import { getPhonesForLocale, slugOf } from '../lib/phones';
import { t, FINAL_DESIGN_COPY, OWNED_PHONE_COPY } from '../lib/ui-strings';
import { localePath, type Locale } from '../lib/locales';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const strings = t(locale);
const copy = FINAL_DESIGN_COPY[locale];
const ownedCopy = OWNED_PHONE_COPY[locale];
const periodCopy = OWNERSHIP_COPY[locale];
const collectionCopy = COLLECTION_COPY[locale];
const cabinetCopy = CABINET_COPY[locale];
const shareCopy = {
  uk: { download:'Завантажити PNG', preview:'Попередній перегляд PNG', done:'Зображення збережено.', error:'Не вдалося створити зображення.', loading:'Готуємо попередній перегляд…', design:'Оберіть оформлення', magazine:'Журнальне', magazineHint:'Теплий папір і мідні акценти', modern:'Сучасне', modernHint:'Світлі картки та кольорові акценти', close:'Закрити', release:'Випуск' },
  ru: { download:'Скачать PNG', preview:'Предпросмотр PNG', done:'Изображение сохранено.', error:'Не удалось создать изображение.', loading:'Готовим предпросмотр…', design:'Выберите оформление', magazine:'Журнальное', magazineHint:'Тёплая бумага и медные акценты', modern:'Современное', modernHint:'Светлые карточки и цветные акценты', close:'Закрыть', release:'Выпуск' },
  en: { download:'Download PNG', preview:'Preview PNG', done:'Image saved.', error:'Could not create the image.', loading:'Preparing preview…', design:'Choose a style', magazine:'Magazine', magazineHint:'Warm paper with copper accents', modern:'Modern', modernHint:'Light cards with color accents', close:'Close', release:'Released' },
}[locale];
const comparePath = localePath(locale, '/compare/');

const phones = (await getPhonesForLocale(locale)).sort((a, b) => a.data.year - b.data.year);
---

<Layout locale={locale} path="/favorites/" title={`${strings.nav.favorites} — ${strings.siteName}`} description={strings.favorites.intro}>
  <Breadcrumbs locale={locale} items={[{ label: strings.breadcrumbs.home, path: '/' }, { label: strings.nav.favorites }]} />
  <div class="favorites-overview editorial-card mb-7 grid items-start gap-6 rounded-sm border border-neutral-800 border-t-2 border-t-orange-500 bg-neutral-900/40 p-5 sm:p-7 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-10">
    <header>
      <p class="editorial-kicker text-orange-500">{cabinetCopy.title}</p>
      <h1 class="page-title mt-2">{strings.nav.favorites}</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-neutral-400">{strings.favorites.intro}</p>
      <dl data-cabinet-stats hidden class="favorites-stats mt-5 grid grid-cols-3 gap-3 border-t border-neutral-800 pt-4">
        <div><dt class="text-xs text-neutral-400">{cabinetCopy.total}</dt><dd data-favorites-count class="mt-1 text-2xl font-bold tabular-nums">0</dd></div>
        <div><dt class="text-xs text-neutral-400">{cabinetCopy.dated}</dt><dd data-cabinet-dated class="mt-1 text-2xl font-bold tabular-nums">0</dd></div>
        <div><dt class="text-xs text-neutral-400">{cabinetCopy.current}</dt><dd data-cabinet-current class="mt-1 text-2xl font-bold tabular-nums">0</dd></div>
      </dl>
      <button type="button" data-collection-add hidden class="primary-cta mt-5 min-h-11 rounded-sm bg-orange-500 px-4 text-sm font-semibold text-neutral-950">{collectionCopy.add}</button>
    </header>
    <section class="favorites-account border-t border-neutral-800 pt-5 lg:border-t-0 lg:pt-0" aria-labelledby="collection-account-title">
      <h2 id="collection-account-title" tabindex="-1" class="scroll-mt-24 text-lg font-bold">{cabinetCopy.account}</h2>
      <p data-collection-account-mode aria-live="polite" class="mt-2 text-sm font-semibold text-neutral-200">{ACCOUNT_COPY[locale].signedOut}</p>
      <p data-collection-account-name hidden class="mt-1 break-words text-sm font-semibold text-neutral-100"></p>
      <p data-collection-account-note class="mt-2 text-sm leading-relaxed text-neutral-400">{cabinetCopy.localNote}</p>
      <a data-collection-sign-in hidden class="mt-4 flex min-h-11 w-full items-center justify-center gap-2.5 rounded-sm bg-[#f2f2f2] px-3 text-center text-sm font-medium text-[#1f1f1f] hover-desktop:bg-white" href={`/api/collection/login?lang=${locale}`}>
        <img src="/images/google-sign-in.png" alt="" width="18" height="18" class="shrink-0" />
        {collectionCopy.signIn}
      </a>
      <p data-collection-sync-status role="status" class="mt-4 text-sm font-medium text-neutral-300 empty:hidden"></p>
      <button type="button" data-collection-sign-out hidden class="control-button mt-3 min-h-11">{collectionCopy.signOut}</button>
    </section>
  </div>

  <section data-legacy-section hidden class="mb-8 border border-neutral-700 bg-neutral-900 p-4 sm:p-6" aria-labelledby="legacy-title">
    <h2 id="legacy-title" class="text-xl font-bold">{ownedCopy.legacyTitle}</h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-400">{ownedCopy.legacyIntro}</p>
    <ul class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">{phones.map(phone=><li data-legacy-item data-slug={slugOf(phone)} hidden class="min-w-0"><div class="flex"><PhoneCard phone={phone} locale={locale} compact /></div><button type="button" data-legacy-dismiss={slugOf(phone)} class="mt-2 min-h-11 text-left text-xs text-neutral-400 underline underline-offset-4">{ownedCopy.dismiss}</button></li>)}</ul>
  </section>
  <p data-favorites-loading role="status" class="py-8 text-sm text-neutral-500">{copy.loading}</p>
  <noscript><style is:inline>[data-favorites-loading] { display: none; }</style><p class="mb-6 border border-neutral-700 p-4 text-sm text-neutral-300">{copy.noScript}</p></noscript>
  <div data-favorites-empty hidden class="favorites-empty rounded-sm border border-neutral-800 bg-neutral-900/40 px-5 py-10 text-center text-neutral-400 sm:py-12">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="mx-auto mb-4 h-8 w-8 text-orange-500" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M8 2.5h8a2 2 0 0 1 2 2v15a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-15a2 2 0 0 1 2-2Z M10 5h4 M10 12l2 2 4-4 M11 18h2" /></svg>
    <h2 class="text-xl font-bold text-neutral-100">{strings.favorites.emptyTitle}</h2>
    <p class="mt-2 text-sm leading-relaxed">{strings.favorites.emptyBody}</p>
    <a class="control-button mt-5 min-h-11" href={localePath(locale, '/catalog/')}>{strings.nav.catalog} <Arrow /></a>
  </div>

  <div data-favorites-toolbar hidden class="favorites-toolbar mb-5 flex flex-wrap items-center justify-between gap-4 rounded-sm border border-neutral-800 border-t-2 border-t-orange-500 bg-neutral-900/40 p-4">
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="text-lg font-bold">{periodCopy.personal}</h2>
      <button type="button" class="control-button text-sm" data-timeline-preview-open>{shareCopy.preview}</button>
      <a
        data-favorites-compare-cta
        data-compare-base={comparePath}
        hidden
        href={comparePath}
        class="inline-flex min-h-11 items-center text-sm font-semibold text-orange-500 underline underline-offset-4 transition-colors motion-ui hover-desktop:text-orange-400"
      >
        {strings.favorites.comparePair} <Arrow />
      </a>
    </div>
    <div class="w-full sm:w-56">
      <FilterSelect
        name="sort"
        label={strings.favorites.sortLabel}
        defaultValue="personal"
        options={[
          { value: 'personal', label: periodCopy.personal },
          { value: 'year-asc', label: strings.favorites.sortOldest },
          { value: 'year-desc', label: strings.favorites.sortNewest },
        ]}
      />
    </div>
  </div>

  <p data-period-hint hidden class="period-hint mb-5 text-sm leading-relaxed text-neutral-500">{periodCopy.hint}</p>
  <p data-period-status role="status" aria-live="polite" class="period-status mb-3 text-sm text-orange-500"></p>
  <ol data-favorites-list hidden class="favorites-timeline grid grid-cols-1 items-start gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {phones.map((phone) => (
      <li data-favorite-item data-slug={slugOf(phone)} data-year={phone.data.year} data-timeline-name={`${phone.data.brand} ${phone.data.model}`} data-timeline-image={phone.data.image} data-timeline-highlight={phone.data.milestone ?? phone.data.os ?? (phone.data.formFactor ? strings.formFactors[phone.data.formFactor] : '')} class="ownership-item flex min-w-0 flex-col overflow-hidden rounded-sm border border-neutral-800 bg-neutral-900/50" hidden>
        <div class="ownership-heading flex items-start justify-between gap-2 border-b border-neutral-800 bg-neutral-950/40 px-3 py-2">
          <div class="min-w-0"><p data-period-label class="text-sm font-bold tabular-nums text-orange-500">{periodCopy.unknown}</p><p class="mt-1 text-xs text-neutral-500">{periodCopy.release}: {phone.data.year}</p></div>
          <button type="button" data-period-open data-slug={slugOf(phone)} data-model={phone.data.brand+' '+phone.data.model} data-year={phone.data.year} aria-label={periodCopy.add+' — '+phone.data.brand+' '+phone.data.model} class="period-edit-button" hidden>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5 4 4M4 20l4-1L20 7a2.8 2.8 0 0 0-4-4L4 15Z"/></svg>
            <span data-period-action-label>{periodCopy.add}</span>
          </button>
        </div>
        <PhoneCard phone={phone} locale={locale} compact />
      </li>
    ))}
  </ol>
  <dialog data-timeline-dialog class="period-dialog timeline-export-dialog" aria-labelledby="timeline-export-title" data-title={periodCopy.personal} data-site={strings.siteName} data-done={shareCopy.done} data-error={shareCopy.error} data-release={shareCopy.release} data-loading={shareCopy.loading}>
    <div class="period-dialog-header flex items-start justify-between gap-4">
      <div><p class="editorial-kicker text-orange-500">{shareCopy.preview}</p><h2 id="timeline-export-title" class="mt-2 text-xl font-bold">{periodCopy.personal}</h2></div>
      <button type="button" data-timeline-close class="control-button h-11 w-11 shrink-0 justify-center" aria-label={shareCopy.close} title={shareCopy.close}>
        <svg width="20" height="20" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <fieldset class="timeline-design-options">
      <legend class="text-sm font-semibold">{shareCopy.design}</legend>
      <div class="mt-2 grid grid-cols-2 gap-2">
        <label><input type="radio" name="timeline-design" value="magazine" /><span class="timeline-style-choice"><span class="timeline-style-swatch timeline-style-swatch--magazine" aria-hidden="true"><i></i><i></i><i></i></span><span class="timeline-style-copy"><strong>{shareCopy.magazine}</strong><small>{shareCopy.magazineHint}</small></span><span class="timeline-style-check" aria-hidden="true"></span></span></label>
        <label><input type="radio" name="timeline-design" value="modern" /><span class="timeline-style-choice"><span class="timeline-style-swatch timeline-style-swatch--modern" aria-hidden="true"><i></i><i></i><i></i></span><span class="timeline-style-copy"><strong>{shareCopy.modern}</strong><small>{shareCopy.modernHint}</small></span><span class="timeline-style-check" aria-hidden="true"></span></span></label>
      </div>
    </fieldset>
    <p data-timeline-preview-status role="status" aria-live="polite" class="timeline-preview-status min-h-5 text-sm text-neutral-500">{shareCopy.loading}</p>
    <div class="timeline-preview-frame"><img data-timeline-preview alt={`${periodCopy.personal} — PNG`} /></div>
    <div class="period-dialog-actions timeline-preview-actions">
      <button type="button" data-timeline-cancel class="control-button min-h-11 px-4 text-sm">{shareCopy.close}</button>
      <button type="button" data-timeline-download class="primary-cta period-save justify-center text-sm" disabled>{shareCopy.download}</button>
    </div>
  </dialog>
  <dialog data-collection-picker class="period-dialog collection-picker" aria-labelledby="collection-picker-title">
    <div class="period-dialog-header flex items-center justify-between gap-4">
      <h2 id="collection-picker-title" class="text-xl font-bold">{collectionCopy.add}</h2>
      <button type="button" data-collection-close class="control-button h-11 w-11 shrink-0 justify-center" aria-label={periodCopy.close} title={periodCopy.close}>
        <svg width="20" height="20" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="ownership-form mt-4 grid gap-3">
      <label class="collection-search-label">
        <span>{collectionCopy.search}</span>
        <span class="collection-search-field">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="5.5"/><path d="m15 15 4.5 4.5"/></svg>
          <input type="search" data-collection-search autocomplete="off" placeholder="Nokia 3310" />
        </span>
      </label>
      <p data-collection-empty role="status" hidden class="text-sm text-neutral-400">{collectionCopy.empty}</p>
      <ul class="collection-results grid gap-1.5 overflow-auto">
        {phones.map(phone => <li hidden>
          <button type="button" data-collection-choice data-slug={slugOf(phone)} data-model={phone.data.brand+' '+phone.data.model} data-year={phone.data.year} class="control-button collection-choice min-h-11 w-full text-left">
            <span>{phone.data.brand} {phone.data.model}</span><span class="text-xs text-neutral-400">{phone.data.year}</span>
          </button>
        </li>)}
      </ul>
    </div>
  </dialog>
  <dialog data-period-dialog class="period-dialog" aria-labelledby="period-dialog-title" data-locale={locale}>
    <div class="period-dialog-header flex items-start justify-between gap-4"><div><p data-period-heading class="editorial-kicker text-orange-500">{periodCopy.edit}</p><h2 id="period-dialog-title" class="mt-2 text-xl font-bold"></h2></div><button type="button" data-period-close class="control-button h-11 w-11 justify-center" aria-label={periodCopy.close}><svg width="20" height="20" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <p id="period-dialog-help" class="period-dialog-help">{periodCopy.approximate}</p>
    <form data-period-form aria-describedby="period-dialog-help" class="ownership-form mt-5 grid gap-4">
      <div class="period-years">
      <label>{periodCopy.from}<span class="period-date-controls"><input aria-label={periodCopy.start} name="start" type="number" inputmode="numeric" min="1980" max={new Date().getFullYear()} step="1" required /><select aria-label={`${periodCopy.start}: ${periodCopy.month}`} name="startMonth"><option value="">—</option>{periodCopy.months.map((month, index) => <option value={index + 1}>{month}</option>)}</select></span></label>
      <label>{periodCopy.until}<span class="period-date-controls"><input aria-label={periodCopy.end} name="end" type="number" inputmode="numeric" min="1980" max={new Date().getFullYear()} step="1" /><select aria-label={`${periodCopy.end}: ${periodCopy.month}`} name="endMonth"><option value="">—</option>{periodCopy.months.map((month, index) => <option value={index + 1}>{month}</option>)}</select></span></label>
      </div>
      <label class="ownership-current"><input name="current" type="checkbox" />{periodCopy.current}</label>
      <p data-period-error role="alert" class="text-sm text-orange-500"></p>
      <div class="period-dialog-actions">
      <button type="submit" class="primary-cta period-save justify-center text-sm">{periodCopy.save}</button>
      <button type="button" data-period-clear class="period-clear">{periodCopy.clear}</button>
      <button type="button" data-period-skip hidden class="period-clear">{collectionCopy.skip}</button>
      <button type="button" data-period-back hidden class="period-clear">{collectionCopy.back}</button>
      </div>
    </form>
  </dialog>
</Layout>

<style>
  .collection-picker { width:min(60rem,calc(100vw - 2rem)); max-height:calc(100dvh - 2rem); }
  .collection-picker .period-dialog-header { padding:1.5rem 1.75rem 0; }
  .collection-picker .ownership-form { padding:0 1.75rem 1.75rem; }
  .collection-results { grid-template-columns:repeat(3,minmax(0,1fr)); gap:.5rem; max-height:min(58dvh,40rem); }
  .collection-results li { min-width:0; }
  .collection-choice { min-height:2.75rem; padding:.4rem .65rem; }
  .collection-choice > span:first-child { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .collection-choice > span:last-child { flex:none; }
  @media(max-width:899px) { .collection-results { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:639px) {
    .collection-picker { width:calc(100vw - 1rem); max-height:calc(100dvh - 1rem); }
    .collection-picker .period-dialog-header { padding:1rem 1rem 0; }
    .collection-picker .ownership-form { padding:0 1rem 1rem; }
    .collection-results { grid-template-columns:minmax(0,1fr); max-height:54dvh; }
  }
  .timeline-export-dialog { width:min(58rem,calc(100vw - 2rem)); padding:0; overflow:hidden; }
  .timeline-export-dialog .period-dialog-header { padding:1.5rem 1.75rem 0; }
  .timeline-design-options { margin:1.25rem 1.75rem 0; border:0; padding:0; }
  .timeline-design-options legend { margin-bottom:.65rem; }
  .timeline-design-options label { position:relative; display:block; min-width:0; cursor:pointer; }
  .timeline-design-options input { position:absolute; inset:0; width:100%; height:100%; margin:0; opacity:0; }
  .timeline-style-choice { display:flex; min-height:4.25rem; align-items:center; gap:.8rem; border:1px solid var(--color-neutral-700); border-radius:.65rem; padding:.65rem .8rem; transition:border-color var(--motion-ui) var(--motion-easing),background-color var(--motion-ui) var(--motion-easing),box-shadow var(--motion-ui) var(--motion-easing); }
  .timeline-design-options input:checked + .timeline-style-choice { border-color:var(--color-orange-500); background:color-mix(in srgb,var(--color-orange-500) 7%,var(--color-neutral-950)); box-shadow:inset 3px 0 var(--color-orange-500); }
  .timeline-design-options input:focus-visible + .timeline-style-choice { outline:2px solid var(--color-orange-500); outline-offset:3px; }
  .timeline-style-swatch { display:flex; width:2.6rem; height:2.6rem; flex:none; align-items:flex-end; gap:.2rem; border:1px solid var(--color-neutral-700); border-radius:.5rem; padding:.35rem; }
  .timeline-style-swatch i { width:.42rem; height:.9rem; border-radius:99px; background:#994320; }
  .timeline-style-swatch i:nth-child(2) { height:1.25rem; background:#c47a4d; }
  .timeline-style-swatch i:nth-child(3) { height:.7rem; background:#5c4839; }
  .timeline-style-swatch--magazine { background:#f5f0e6; }
  .timeline-style-swatch--modern { background:#edf2f8; }
  .timeline-style-swatch--modern i { background:#315fc2; }
  .timeline-style-swatch--modern i:nth-child(2) { background:#157c78; }
  .timeline-style-swatch--modern i:nth-child(3) { background:#ad432f; }
  .timeline-style-copy { display:grid; min-width:0; gap:.15rem; }
  .timeline-style-copy strong { font-size:.875rem; }
  .timeline-style-copy small { color:var(--color-neutral-400); font-size:.75rem; font-weight:400; line-height:1.35; }
  .timeline-preview-status { margin:1rem 1.75rem .55rem; }
  .timeline-preview-frame { max-height:min(56vh,42rem); overflow:auto; margin-inline:1.75rem; border:1px solid var(--color-neutral-700); border-radius:.65rem; background:var(--color-neutral-900); padding:.65rem; }
  .timeline-preview-frame img { display:block; width:100%; height:auto; border-radius:.25rem; }
  .timeline-export-dialog .timeline-preview-actions { justify-content:flex-end; gap:.75rem; margin-top:1.25rem; padding:1rem 1.75rem 1.25rem; background:var(--color-neutral-900); }
  @media(max-width:639px) {
    .timeline-export-dialog { width:calc(100vw - 1rem); max-height:calc(100dvh - 1rem); }
    .timeline-export-dialog .period-dialog-header { padding:1.1rem 1rem 0; }
    .timeline-design-options { margin:1rem 1rem 0; }
    .timeline-design-options > div { grid-template-columns:minmax(0,1fr); }
    .timeline-style-choice { min-height:3.6rem; }
    .timeline-preview-status { margin-inline:1rem; }
    .timeline-preview-frame { max-height:46dvh; margin-inline:1rem; padding:.4rem; }
    .timeline-export-dialog .timeline-preview-actions { padding:1rem; }
  }
  .collection-search-label { font-weight: 650; }
  .collection-search-field {
    display: flex;
    align-items: center;
    gap: .625rem;
    min-height: 3rem;
    padding-inline: .75rem;
    border: 1px solid var(--color-neutral-600);
    border-radius: .375rem;
    background: var(--color-neutral-900);
    color: var(--color-orange-500);
  }
  .collection-search-field:focus-within {
    border-color: var(--color-orange-500);
    box-shadow: 0 0 0 1px var(--color-orange-500);
  }
  .collection-search-field svg { flex: none; }
  .collection-search-field input {
    min-width: 0;
    width: 100%;
    min-height: 2.875rem;
    color: var(--color-neutral-100);
    font-size: 1rem;
    font-weight: 400;
    outline: none;
  }
  .collection-results { padding-right:.25rem; }
  .collection-choice { justify-content: space-between; gap: .75rem; }

  /* The period header and the phone card below it read as one object, not two
     stacked boxes: the outer .ownership-item supplies the single border/surface,
     and the nested PhoneCard's own chrome is turned off — same pattern already
     used for .generation-feature on the homepage. */
  .ownership-item :global(.editorial-card) {
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .ownership-item :global(.phone-card-art) { border-radius: 0; }
</style>

<script>
  import { matchesPhoneSearch, normalizePhoneSearch } from '../lib/phone-search-match';
  import { readPeriods, savePeriod, PERIODS_KEY, validPeriod } from '../lib/ownership-periods';
  import { COLLECTION_COPY, OWNERSHIP_COPY } from '../lib/ownership-copy';
  import { addFavorite, readFavorites, readLegacyFavorites, dismissLegacyFavorite, FAVORITES_CHANGED_EVENT } from '../scripts/favorites';

  const empty = document.querySelector<HTMLElement>('[data-favorites-empty]');
  const loading = document.querySelector<HTMLElement>('[data-favorites-loading]');
  const toolbar = document.querySelector<HTMLElement>('[data-favorites-toolbar]');
  const list = document.querySelector<HTMLUListElement>('[data-favorites-list]');
  const count = document.querySelector<HTMLElement>('[data-favorites-count]');
  const compareCta = document.querySelector<HTMLAnchorElement>('[data-favorites-compare-cta]');
  const sortSelect = document.querySelector<HTMLSelectElement>('[data-filter="sort"]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-favorite-item]'));
  const previewOpen = document.querySelector<HTMLButtonElement>('[data-timeline-preview-open]');
  const exportDialog = document.querySelector<HTMLDialogElement>('[data-timeline-dialog]');
  const previewImage = exportDialog?.querySelector<HTMLImageElement>('[data-timeline-preview]');
  const previewStatus = exportDialog?.querySelector<HTMLElement>('[data-timeline-preview-status]');
  const downloadButton = exportDialog?.querySelector<HTMLButtonElement>('[data-timeline-download]');
  let previewBlob: Blob | null = null;
  let previewUrl: string | null = null;
  let previewVersion = 0;
  const getTimelineEntries = () => Array.from(list?.querySelectorAll<HTMLElement>('[data-favorite-item]:not([hidden])') ?? [], item => ({
    name: item.dataset.timelineName ?? '',
    period: item.querySelector('[data-period-label]')?.textContent ?? '',
    year: item.dataset.year ?? '',
    highlight: item.dataset.timelineHighlight ?? '',
    image: item.dataset.timelineImage,
  }));
  const updateTimelinePreview = async () => {
    if (!exportDialog || !previewImage || !previewStatus || !downloadButton) return;
    const version = ++previewVersion;
    previewBlob = null;
    downloadButton.disabled = true;
    previewStatus.textContent = previewStatus.dataset.loading ?? '';
    try {
      const design = exportDialog.querySelector<HTMLInputElement>('[name="timeline-design"]:checked')?.value === 'modern' ? 'modern' : 'magazine';
      const { renderTimeline } = await import('../scripts/timeline-export');
      const blob = await renderTimeline(getTimelineEntries(), exportDialog.dataset.title ?? '', exportDialog.dataset.site ?? '', design, exportDialog.dataset.release ?? 'Released');
      if (version !== previewVersion) return;
      previewBlob = blob;
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = URL.createObjectURL(blob);
      previewImage.src = previewUrl;
      previewImage.dataset.ready = 'true';
      previewStatus.textContent = '';
      downloadButton.disabled = false;
    } catch {
      if (version === previewVersion) previewStatus.textContent = exportDialog.dataset.error ?? '';
    }
  };
  previewOpen?.addEventListener('click', () => {
    if (!getTimelineEntries().length || !exportDialog) return;
    const preferred = document.documentElement.dataset.design === 'modern' ? 'modern' : 'magazine';
    const radio = exportDialog.querySelector<HTMLInputElement>(`[name="timeline-design"][value="${preferred}"]`);
    if (radio) radio.checked = true;
    exportDialog.showModal();
    void updateTimelinePreview();
  });
  exportDialog?.querySelectorAll<HTMLInputElement>('[name="timeline-design"]').forEach(radio => radio.addEventListener('change', () => void updateTimelinePreview()));
  exportDialog?.querySelectorAll<HTMLButtonElement>('[data-timeline-close],[data-timeline-cancel]').forEach(button => button.addEventListener('click', () => exportDialog.close()));
  exportDialog?.addEventListener('click', event => { if (event.target === exportDialog) exportDialog.close(); });
  exportDialog?.addEventListener('close', () => { previewVersion++; if (previewUrl) URL.revokeObjectURL(previewUrl); previewUrl = null; previewBlob = null; if (previewImage) { previewImage.removeAttribute('src'); delete previewImage.dataset.ready; } });
  downloadButton?.addEventListener('click', async () => {
    if (!previewBlob || !exportDialog || !downloadButton) return;
    downloadButton.disabled = true;
    try {
      const { downloadTimeline } = await import('../scripts/timeline-export');
      await downloadTimeline(previewBlob);
      document.querySelector('[data-period-status]')!.textContent = exportDialog.dataset.done ?? '';
      exportDialog.close();
    } catch {
      if (previewStatus) previewStatus.textContent = exportDialog.dataset.error ?? '';
    } finally { downloadButton.disabled = false; }
  });

  const stats = document.querySelector<HTMLElement>('[data-cabinet-stats]')!;
  const datedCount = stats.querySelector('[data-cabinet-dated]')!;
  const currentCount = stats.querySelector('[data-cabinet-current]')!;

  function applySort() {
    if (!list || !sortSelect) return;
    const direction = sortSelect.value === 'year-asc' ? 1 : -1;
    const periods = readPeriods();
    const rank = (slug: string) => { const period = periods[slug]; return period ? period.start * 13 + (period.startMonth ?? 13) : Infinity; };
    const sorted = items.slice().sort((a, b) => sortSelect.value === 'personal'
      ? rank(a.dataset.slug!) - rank(b.dataset.slug!) || Number(a.dataset.year) - Number(b.dataset.year) || a.dataset.slug!.localeCompare(b.dataset.slug!)
      : direction * (Number(a.dataset.year) - Number(b.dataset.year)));
    const active = document.activeElement instanceof HTMLElement && list.contains(document.activeElement) ? document.activeElement : null;
    for (const item of sorted) list.append(item);
    if (active && !active.closest('[hidden]')) active.focus({ preventScroll:true });
  }

  function render() {
    if (!empty || !toolbar || !list || !count) return;
    const focusedLegacy = document.activeElement?.closest<HTMLElement>('[data-legacy-item]');
    const focusedItem = document.activeElement?.closest<HTMLElement>('[data-favorite-item]');
    const previousIndex = focusedItem ? Array.from(list.children).filter((item) => !(item as HTMLElement).hidden).indexOf(focusedItem) : -1;
    const favorites = readFavorites();
    const legacy = readLegacyFavorites();
    let pending = 0;
    document.querySelectorAll<HTMLElement>('[data-legacy-item]').forEach(item=>{ item.hidden = !legacy.has(item.dataset.slug!) || favorites.has(item.dataset.slug!); if(!item.hidden)pending++; });
    const legacySection=document.querySelector<HTMLElement>('[data-legacy-section]');
    if(legacySection)legacySection.hidden=pending===0;
    const visibleSlugs: string[] = [];
    let visible = 0;
    for (const item of items) {
      const active = favorites.has(item.dataset.slug!);
      item.hidden = !active;
      if (active) { visible++; visibleSlugs.push(item.dataset.slug!); }
    }
    empty.hidden = visible > 0;
    toolbar.hidden = visible === 0;
    list.hidden = visible === 0;
    const hint = document.querySelector<HTMLElement>('[data-period-hint]');
    if (hint) hint.hidden = visible === 0;
    if (!visible) document.querySelector('[data-period-status]')!.textContent = '';
    const periods = readPeriods();
    const dated = visibleSlugs.filter(slug => periods[slug]);
    count.textContent = String(visible);
    datedCount.textContent = String(dated.length);
    currentCount.textContent = String(dated.filter(slug => periods[slug].current).length);
    stats.hidden = false;
    if (loading) loading.hidden = true;
    if (compareCta) {
      if (visibleSlugs.length === 2) {
        const [a, b] = visibleSlugs;
        compareCta.href = `${compareCta.dataset.compareBase}?a=${encodeURIComponent(a)}&b=${encodeURIComponent(b)}`;
        compareCta.hidden = false;
      } else {
        compareCta.hidden = true;
      }
    }
    syncPeriods();
    applySort();
    if (focusedLegacy?.hidden) {
      const confirmed = items.find(item=>!item.hidden && item.dataset.slug===focusedLegacy.dataset.slug);
      (confirmed?.querySelector<HTMLButtonElement>('[data-favorite-toggle]') ?? empty.querySelector<HTMLAnchorElement>('a'))?.focus();
    }
    if (focusedItem?.hidden) {
      const remaining = Array.from(list.children).filter((item) => !(item as HTMLElement).hidden);
      const next = remaining[Math.min(Math.max(previousIndex, 0), remaining.length - 1)];
      (next?.querySelector<HTMLButtonElement>('[data-favorite-toggle]') ?? empty.querySelector<HTMLAnchorElement>('a'))?.focus();
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-legacy-dismiss]').forEach(button => button.addEventListener('click',()=>{ dismissLegacyFavorite(button.dataset.legacyDismiss!); const target = document.querySelector<HTMLElement>('[data-legacy-section]')?.hidden ? empty?.querySelector<HTMLElement>('a') : document.querySelector<HTMLElement>('#legacy-title'); target?.setAttribute('tabindex','-1'); target?.focus(); }));
  const dialog = document.querySelector<HTMLDialogElement>('[data-period-dialog]')!;
  const form = dialog.querySelector<HTMLFormElement>('[data-period-form]')!;
  const c = OWNERSHIP_COPY[dialog.dataset.locale as keyof typeof OWNERSHIP_COPY];
  const startInput = form.elements.namedItem('start') as HTMLInputElement;
  const endInput = form.elements.namedItem('end') as HTMLInputElement;
  const startMonthInput = form.elements.namedItem('startMonth') as HTMLSelectElement;
  const endMonthInput = form.elements.namedItem('endMonth') as HTMLSelectElement;
  const current = form.elements.namedItem('current') as HTMLInputElement;
  const error = form.querySelector('[data-period-error]')!;
  let editedSlug = '';
  let periodOpener: HTMLButtonElement | null = null;
  let adding = false;
  const addButton = document.querySelector<HTMLButtonElement>('[data-collection-add]')!;
  const picker = document.querySelector<HTMLDialogElement>('[data-collection-picker]')!;
  const search = picker.querySelector<HTMLInputElement>('[data-collection-search]')!;
  const choices = [...picker.querySelectorAll<HTMLButtonElement>('[data-collection-choice]')];
  const collectionCopy = COLLECTION_COPY[dialog.dataset.locale as keyof typeof COLLECTION_COPY];
  function filterChoices() {
    const terms = normalizePhoneSearch(search.value).split(' ').filter(Boolean);
    const favorites = readFavorites();
    let shown = 0;
    for (const button of choices) {
      const label = normalizePhoneSearch(`${button.dataset.model} ${button.dataset.year} ${button.dataset.slug}`);
      const show = shown < 36 && !favorites.has(button.dataset.slug!) && matchesPhoneSearch(terms, label);
      button.closest('li')!.hidden = !show;
      if (show) shown++;
    }
    picker.querySelector<HTMLElement>('[data-collection-empty]')!.hidden = shown > 0;
  }
  function openPicker() {
    filterChoices();
    picker.showModal();
    search.focus();
  }
  addButton.hidden = false;
  addButton.addEventListener('click', () => { search.value = ''; openPicker(); });
  search.addEventListener('input', filterChoices);
  search.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    event.preventDefault();
    picker.close();
  });
  picker.querySelector('[data-collection-close]')!.addEventListener('click', () => picker.close());
  document.addEventListener(FAVORITES_CHANGED_EVENT, () => { if (picker.open) filterChoices(); });
  function syncPeriods() {
    const periods = readPeriods();
    const point = (year: number, month?: number) => month ? `${c.months[month - 1]} ${year}` : String(year);
    for (const item of items) {
      const period = periods[item.dataset.slug!];
      const finish = period?.end ? point(period.end, period.endMonth) : '';
      const hasRange = !!period && (period.current || period.end !== undefined && (period.end !== period.start || period.endMonth !== undefined || period.startMonth !== undefined));
      item.querySelector('[data-period-label]')!.textContent = period ? point(period.start, period.startMonth) + (hasRange ? ' — ' + (period.current ? c.present : finish) : '') : c.unknown;
      const button = item.querySelector<HTMLButtonElement>('[data-period-open]')!;
      button.hidden = false;
      const label = period ? c.edit : c.add;
      button.querySelector('[data-period-action-label]')!.textContent = label;
      button.setAttribute('aria-label', label + ' — ' + button.dataset.model);
    }
    if (dialog.open && !adding && !readFavorites().has(editedSlug)) dialog.close();
  }
  function openPeriod(button: HTMLButtonElement, isNew: boolean) {
    adding = isNew;
    periodOpener = isNew ? addButton : button;
    editedSlug = button.dataset.slug!;
    const period = isNew ? undefined : readPeriods()[editedSlug];
    dialog.querySelector('[data-period-heading]')!.textContent = isNew ? collectionCopy.years : period ? c.edit : c.add;
    dialog.querySelector('#period-dialog-title')!.textContent = button.dataset.model!;
    startInput.min = button.dataset.year!;
    startInput.value = period ? String(period.start) : '';
    endInput.value = period?.end ? String(period.end) : '';
    startMonthInput.value = period?.startMonth ? String(period.startMonth) : '';
    endMonthInput.value = period?.endMonth ? String(period.endMonth) : '';
    current.checked = period?.current ?? false; endInput.disabled = current.checked; endMonthInput.disabled = current.checked;
    error.textContent = '';
    form.querySelector<HTMLButtonElement>('[data-period-clear]')!.hidden = !period;
    form.querySelector<HTMLButtonElement>('[data-period-skip]')!.hidden = !isNew;
    form.querySelector<HTMLButtonElement>('[data-period-back]')!.hidden = !isNew;
    dialog.showModal();
    startInput.focus();
  }
  document.querySelectorAll<HTMLButtonElement>('[data-period-open]').forEach(button => button.addEventListener('click', () => openPeriod(button, false)));
  for (const button of choices) button.addEventListener('click', () => { picker.close(); openPeriod(button, true); });
  form.querySelector('[data-period-back]')!.addEventListener('click', () => { dialog.close(); openPicker(); });
  current.addEventListener('change', () => { endInput.disabled = current.checked; endMonthInput.disabled = current.checked; });
  dialog.querySelector('[data-period-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => {
    const r = dialog.getBoundingClientRect();
    if (event.target === dialog && (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom)) dialog.close();
  });
  dialog.addEventListener('close', () => { if (!picker.open && periodOpener && !periodOpener.closest('[hidden]')) periodOpener.focus({preventScroll:true}); });
  const commit = (clear: boolean) => {
    const period = { start:Number(startInput.value), ...(startMonthInput.value ? {startMonth:Number(startMonthInput.value)} : {}), ...(endInput.value && !current.checked ? {end:Number(endInput.value), ...(endMonthInput.value ? {endMonth:Number(endMonthInput.value)} : {})} : {}), current:current.checked };
    if (!clear && (endMonthInput.value && !endInput.value || !validPeriod(period) || period.start < Number(startInput.min))) { error.textContent = c.invalid; return; }
    if (!adding && !readFavorites().has(editedSlug)) { dialog.close(); return; }
    if (adding && readFavorites().has(editedSlug)) { dialog.close(); return; }
    if (!savePeriod(editedSlug, clear ? undefined : period)) { error.textContent = c.error; return; }
    if (adding && !addFavorite(editedSlug)) {
      savePeriod(editedSlug);
      error.textContent = c.error;
      return;
    }
    dialog.close(); syncPeriods(); applySort();
    document.dispatchEvent(new CustomEvent(FAVORITES_CHANGED_EVENT));
    document.querySelector('[data-period-status]')!.textContent = adding ? collectionCopy.added : clear ? c.removed : c.saved;
  };
  form.addEventListener('submit', event => { event.preventDefault(); commit(false); });
  form.querySelector('[data-period-clear]')!.addEventListener('click', () => commit(true));
  form.querySelector('[data-period-skip]')!.addEventListener('click', () => commit(true));
  window.addEventListener('storage', event => { if (event.key === PERIODS_KEY || event.key === null) render(); });
  sortSelect?.addEventListener('change', applySort);
  render();
  document.addEventListener(FAVORITES_CHANGED_EVENT, render);
  window.addEventListener('pageshow', (event) => { if (event.persisted) render(); });
</script>
