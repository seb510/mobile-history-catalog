---
import PlaceholderArt from './PlaceholderArt.astro';
import { render, type CollectionEntry } from 'astro:content';
import { t } from '../lib/ui-strings';
import { buildSpecGroups } from '../lib/specs';
import type { Locale } from '../lib/locales';

interface Props {
  phone: CollectionEntry<'phones'>;
  locale: Locale;
}
const { phone, locale } = Astro.props;
const { data } = phone;
const strings = t(locale);
const s = strings.specs;
const { Content } = await render(phone);

const groups = buildSpecGroups(data, strings);
---

<div class="grid gap-10 lg:grid-cols-[2fr_3fr]">
  <div class="lg:sticky lg:top-20 lg:self-start">
    <div class="relative">
      <div class="flex h-80 items-center justify-center overflow-hidden rounded-lg border border-neutral-800 bg-neutral-900 p-6 sm:h-96 lg:h-[420px]">
        {data.image ? (
          <img src={data.image} alt={`${data.brand} ${data.model}`} class="h-full w-full object-contain" />
        ) : (
          <PlaceholderArt class="h-full w-full text-neutral-700" />
        )}
      </div>
      {data.priceUsdAtLaunch != null && (
        <div class="absolute -top-3 -right-3 rotate-6 rounded-md border-2 border-neutral-950 bg-orange-500 px-3 py-1.5 text-sm font-bold text-neutral-950 shadow-lg">
          <span class="absolute top-1/2 -left-1 h-2 w-2 -translate-y-1/2 rounded-full bg-neutral-950"></span>
          ${data.priceUsdAtLaunch}
        </div>
      )}
    </div>
    {data.imageCredit && (
      <p class="mt-2 text-xs text-neutral-500">
        {data.imageSourceUrl ? (
          <a href={data.imageSourceUrl} class="transition-colors duration-200 hover-desktop:text-neutral-300" target="_blank" rel="noopener noreferrer nofollow">
            {data.imageCredit}
          </a>
        ) : (
          data.imageCredit
        )}
      </p>
    )}
    {data.colors && data.colors.length > 0 && (
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold tracking-wide text-neutral-500 uppercase">{s.colors}</span>
        {data.colors.map((color) => (
          <span class="rounded-full border border-neutral-700 px-2.5 py-0.5 text-xs text-neutral-300">{color}</span>
        ))}
      </div>
    )}
  </div>

  <div>
    <p class="text-neutral-500">{data.brand}</p>
    <h1 class="text-3xl font-bold">{data.model}</h1>
    {data.milestone && (
      <p class="mt-3 border-l-2 border-orange-500 py-0.5 pl-3 text-lg text-orange-500">{data.milestone}</p>
    )}

    <div class="prose prose-invert mt-6 max-w-none prose-p:text-neutral-300">
      <Content />
    </div>

    <div class="mt-6 flex flex-col gap-3">
      {groups.map((group) => (
        <table class="w-full border-collapse overflow-hidden rounded-lg border border-neutral-800 text-sm">
          <tbody class="divide-y divide-neutral-800">
            {group.rows.map(([label, value], i) => (
              <tr class:list={[i % 2 === 1 && 'bg-neutral-900/40']}>
                <th class="w-40 py-2.5 pl-3 text-left align-top text-xs font-semibold tracking-wide text-neutral-500 uppercase">
                  {label}
                </th>
                <td class="py-2.5 pr-3 text-neutral-200">{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ))}
    </div>
  </div>
</div>
