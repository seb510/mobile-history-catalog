---
import CollectionIcon from './CollectionIcon.astro';
import Arrow from './Arrow.astro';
import { phoneColorSwatch } from '../lib/phone-colors';
import PlaceholderArt from './PlaceholderArt.astro';
import ImageGallery from './ImageGallery.astro';
import PhoneVideo from './PhoneVideo.astro';
import { PHONE_VIDEOS, PHONE_VIDEO_LABELS } from '../lib/phone-videos';
import { render, type CollectionEntry } from 'astro:content';
import { t, RELATED_PHONES, DESIGN_EDITORIAL, HOME_EDITORIAL, RETRO_DISCOVERY, SPEC_VARIANT_NOTE, GALLERY_INTERACTION, PHONE_READING } from '../lib/ui-strings';
import { RETRO_STORIES } from '../lib/editorial-stories';
import { PHONE_EDITORIAL, PHONE_EDITORIAL_LABELS } from '../lib/phone-editorial';
import { getPhone, getPhonesForLocale, slugOf, isRecentlyAdded } from '../lib/phones';
import { buildCompareGroups } from '../lib/specs';
import { slugifyBrandName } from '../lib/brands';
import { museumImageCredit } from '../lib/image-attribution';
import { localePath, type Locale } from '../lib/locales';
import { OS_PATH, platformFor } from '../lib/operating-systems';
import { versionFor } from '../lib/operating-system-versions';

interface Props {
  phone: CollectionEntry<'phones'>;
  locale: Locale;
}
const { phone, locale } = Astro.props;
const { data } = phone;
const strings = t(locale);
const isNew = isRecentlyAdded(data.dateAdded);
const reading = PHONE_READING[locale];
const galleryCopy = GALLERY_INTERACTION[locale];
const editorial = DESIGN_EDITORIAL[locale];
const s = strings.specs;
const { Content } = await render(phone);

const variantData = data.specVariant ? { ...data, ...data.specVariant.specs } : data;
const groups = buildCompareGroups(data, variantData, strings);
const video = PHONE_VIDEOS[slugOf(phone)];
const modelName = data.model.startsWith(`${data.brand} `) ? data.model : `${data.brand} ${data.model}`;
const detailCopy = {
  uk: { overview: 'Огляд', story: 'Історія', specs: 'Характеристики', allSpecs: 'Усі характеристики' },
  ru: { overview: 'Обзор', story: 'История', specs: 'Характеристики', allSpecs: 'Все характеристики' },
  en: { overview: 'Overview', story: 'History', specs: 'Specs', allSpecs: 'All specifications' },
}[locale];
const rows = new Map(groups.flatMap(group => group.rows.map(row => [row.label, row.a] as const)));
const quickSpecs = [s.formFactor, s.display, s.os, s.camera, s.battery, s.network]
  .flatMap(label => {
    const value = rows.get(label);
    return value ? [{ label, value }] : [];
  })
  .slice(0, 4);
const canonicalOs = locale === 'uk' ? data.os : (await getPhone('uk', slugOf(phone)))?.data.os;
const osPlatform = platformFor(canonicalOs);
const osVersion = osPlatform && canonicalOs ? versionFor(osPlatform.id, canonicalOs) : undefined;
const osHref = osPlatform ? localePath(locale, `${OS_PATH}${osPlatform.id}/`) + (osVersion ? `#version-${osVersion.id}` : '') : undefined;
const images = [
  ...(data.image
    ? [{ image: data.image, imageCredit: data.imageCredit, imageSourceUrl: data.imageSourceUrl, alt: `${data.brand} ${data.model}`, caption: data.imageCaption }]
    : []),
  ...(data.gallery ?? []),
];
const stories = RETRO_STORIES.flatMap((story, index) => story.slugs.some((slug) => slug === slugOf(phone))
  ? [{ ...story, title: HOME_EDITORIAL[locale].themes[index].title }] : []);
const storySlugs = new Set<string>(stories.flatMap((story) => [...story.slugs]));
const discovery = RETRO_DISCOVERY[locale];
const feature = PHONE_EDITORIAL[slugOf(phone)]?.[locale];
const featureLabels = PHONE_EDITORIAL_LABELS[locale];
const allPhones = await getPhonesForLocale(locale);
const nextPhone = feature && allPhones.find((candidate) => slugOf(candidate) === feature.next);
const related = allPhones
  .filter((candidate) => !nextPhone || slugOf(candidate) !== slugOf(nextPhone))
  .filter((candidate) => (stories.length ? storySlugs.has(slugOf(candidate)) : candidate.data.brand === data.brand) && slugOf(candidate) !== slugOf(phone))
  .sort((a, b) => (stories.length ? Number(a.data.brand === data.brand) - Number(b.data.brand === data.brand) : 0)
    || Math.abs(a.data.year - data.year) - Math.abs(b.data.year - data.year) || a.data.year - b.data.year || slugOf(a).localeCompare(slugOf(b)))
  .slice(0, 3);
---

<div class="phone-page-layout">
<header id="phone-overview" class="phone-masthead phone-cover mb-5 flex items-end justify-between gap-4 border-b border-neutral-800 pb-5 sm:mb-8 sm:pb-6">
  <div class="min-w-0">
    <div class="phone-identity-meta flex flex-wrap items-center gap-x-3 gap-y-1">
      <a href={localePath(locale, `/brands/${slugifyBrandName(data.brand)}/`)} class="editorial-kicker text-orange-500 hover-desktop:text-orange-400">{data.brand}</a>
      {isNew && <span class="rounded bg-orange-500 px-1.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-neutral-950">{strings.newBadge}</span>}
      <button
        type="button"
        data-favorite-toggle
        data-slug={slugOf(phone)}
        data-label-add={strings.favorites.add}
        data-label-remove={strings.favorites.remove}
        aria-pressed="false"
        aria-label={strings.favorites.add}
        class="favorite-toggle favorite-toggle-bare control-button shrink-0 text-xs normal-case tracking-normal motion-ui hover-desktop:border-orange-500 hover-desktop:text-orange-500"
      >
        <CollectionIcon />
        <span data-favorite-label class="text-xs normal-case tracking-normal">{strings.favorites.add}</span>
      </button>
      <span class="phone-inline-year editorial-kicker text-neutral-500 sm:hidden">{data.year}</span>
    </div>
    <h1 class="page-title mt-2 wrap-anywhere">{data.model}</h1>
    {data.formFactor && <p class="phone-masthead-form mt-2 text-sm text-neutral-500">{strings.specs.formFactor}: <a class="text-orange-500 underline underline-offset-4 hover-desktop:text-orange-400" href={localePath(locale, '/catalog/') + '?form=' + data.formFactor}>{strings.formFactors[data.formFactor]}</a></p>}
    {data.milestone && <p class="phone-masthead-summary mt-3 max-w-2xl border-l-2 border-orange-500 pl-3 text-sm leading-relaxed text-neutral-300 sm:mt-4 sm:text-lg">{data.milestone}</p>}
  </div>
  <span class="cover-year hidden shrink-0 font-extrabold tabular-nums text-neutral-600 sm:block">{data.year}</span>
</header>
    <nav class:list={['phone-section-nav phone-magazine-nav mb-6 grid gap-2', video ? 'grid-cols-4' : 'grid-cols-3']} aria-label={data.model}>
      <a class="control-button px-2 text-center text-xs leading-snug" href="#phone-photos">{reading.photos}</a>
      <a class="control-button px-2 text-center text-xs leading-snug" href="#phone-story">{editorial.story}</a>
      {video && <a class="control-button min-h-11 px-2 text-center text-xs leading-snug" href="#phone-video"><svg aria-hidden="true" viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="16" height="14" rx="2"/><path d="m8 7 5 3-5 3Z"/></svg>{PHONE_VIDEO_LABELS[locale].nav}</a>}
      <a class="control-button px-2 text-center text-xs leading-snug" href="#phone-specs">{editorial.specs}</a>
    </nav>
<div class="phone-detail-grid grid gap-8 sm:gap-10 lg:grid-cols-[2fr_3fr]">
  <div class="phone-media-rail min-w-0 lg:self-start">
    <div id="phone-photos" class="phone-photo-block scroll-mt-24" data-image-gallery>
      <p class="phone-gallery-heading editorial-kicker mb-3 text-neutral-500">{video ? reading.media : reading.photos}</p>
      <div class="relative">
        <div class="phone-gallery-stage relative flex h-[min(76vw,320px)] items-center justify-center overflow-hidden rounded-sm border border-neutral-800 border-t-4 border-t-orange-500 bg-neutral-900 p-4 sm:h-96 sm:p-6 lg:h-[420px]">
          {images.length > 0 ? (
            images.map((image, index) => (
              <div data-gallery-slide class:list={['absolute inset-0 flex items-center justify-center p-4 sm:p-6', index > 0 && 'hidden']}>
                <img data-image-fallback src={image.image} alt={image.alt ?? `${data.brand} ${data.model}`} class="h-full w-full object-contain" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                <div data-image-fallback-placeholder class="absolute inset-0 hidden flex items-center justify-center p-6">
                  <PlaceholderArt class="h-full w-full text-neutral-700" />
                </div>
              </div>
            ))
          ) : (
            <PlaceholderArt class="h-full w-full text-neutral-700" />
          )}
          {images.length > 0 && (
            <>

            <button
              type="button"
              data-gallery-open
              aria-label={strings.gallery.open}
              title={strings.gallery.open}
              class="absolute inset-0 z-10 flex cursor-zoom-in items-end justify-end p-3 focus-visible:outline-offset-[-4px]"
            >
              <span class="gallery-expand-icon inline-flex h-11 w-11 items-center justify-center rounded-sm border border-neutral-600 bg-neutral-950/90 text-neutral-100"><svg aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg></span>
            </button>
            </>
          )}
        </div>
        {video && (
          <a class="phone-preview-video control-button" href="#phone-video">
            <svg aria-hidden="true" width="17" height="17" viewBox="0 0 20 20" fill="currentColor"><path d="M6 4v12l10-6z"/></svg>
            {PHONE_VIDEO_LABELS[locale].nav}
          </a>
        )}
      </div>
      {images.length > 0 && <div class:list={['phone-gallery-controls', images.length > 1 && 'phone-gallery-controls--multiple']}>
      <div class="gallery-toolbar">
        <div><span class="phone-photo-label text-xs font-semibold text-neutral-400">{reading.photos}</span><span data-gallery-page aria-live="polite" aria-atomic="true" class="text-xs tabular-nums text-neutral-200">1 / {images.length}</span></div>
        {images.length > 1 && <div class="flex gap-2"><button type="button" data-gallery-inline-previous class="control-button gallery-step" aria-label={strings.gallery.previous}><Arrow direction="left" /></button><button type="button" data-gallery-inline-next class="control-button gallery-step" aria-label={strings.gallery.next}><Arrow direction="right" /></button></div>}
      </div>
      {images.length > 1 && (
        <div role="group" aria-label={strings.gallery.label} data-gallery-thumbnails class="mt-3 flex gap-2 overflow-x-auto pb-1">
          {images.map((image, index) => (
            <button
              type="button"
              data-gallery-thumb
              aria-label={strings.gallery.showImage.replace('{index}', String(index + 1)).replace('{count}', String(images.length)) + (image.caption ? ` — ${image.caption}` : '')}
              title={image.caption}
              aria-pressed={index === 0 ? 'true' : 'false'}
              class:list={[
                'h-16 w-16 shrink-0 overflow-hidden rounded-sm border bg-neutral-900 p-1 transition-colors motion-ui',
                index === 0 ? 'border-orange-500' : 'border-neutral-700 hover-desktop:border-neutral-400',
              ]}
            >
              <img src={image.image} alt="" class="h-full w-full object-contain" loading="lazy" />
            </button>
          ))}
        </div>
      )}
      </div>}
      {images.length > 1 && <p class="phone-swipe-hint mt-2 text-xs text-neutral-500 sm:hidden">{galleryCopy.swipe}</p>}
      {images.map((image, index) => image.caption && <p data-gallery-caption={index} class:list={['mt-4 border-l-2 border-orange-500 pl-3 text-sm leading-relaxed text-neutral-200', index > 0 && 'hidden']}>{image.caption}</p>)}
      {images.map((image, index) => (
        image.imageCredit && (
          <p data-gallery-credit={index} class:list={['mt-2 text-xs text-neutral-500', index > 0 && 'hidden']}>
            {image.imageSourceUrl ? (
              <a href={image.imageSourceUrl} class="text-orange-500 underline decoration-current/45 underline-offset-2 transition-colors motion-ui hover-desktop:text-orange-400" target="_blank" rel="noopener noreferrer nofollow">
                {image.imageCredit}
              </a>
            ) : (
              image.imageCredit
            )}
          </p>
        )
      ))}
      <ImageGallery locale={locale} images={images} />
    </div>
    {data.colors && data.colors.length > 0 && (
      <div class="phone-colors" aria-label={s.colors}>
        <span class="text-xs font-semibold tracking-wide text-neutral-500 uppercase">{s.colors}</span>
        {data.colors.map((color) => (
          <span class="phone-color-chip">{phoneColorSwatch(color) && <span class="phone-color-swatch" aria-hidden="true" style={{ background: phoneColorSwatch(color) }}></span>}<span>{color}</span></span>
        ))}
        <span class="phone-colors-note">{({uk:'Відтінки орієнтовні',ru:'Оттенки приблизительные',en:'Illustrative shades'}[locale])}</span>
      </div>
    )}
  </div>

  <div class="phone-quick-specs">
    {quickSpecs.length > 0 && <dl>
      {quickSpecs.map(({ label, value }) => (
        <div>
          <dt>{label}</dt>
          <dd>{label === s.os && osHref ? <a href={osHref}>{value}</a> : label === s.formFactor && data.formFactor ? <a href={localePath(locale, '/catalog/') + '?form=' + data.formFactor}>{value}</a> : value}</dd>
        </div>
      ))}
    </dl>}
    <a class="phone-quick-link" href="#phone-specs">{detailCopy.allSpecs}<Arrow direction="down" size={16} /></a>
  </div>
  <nav class="phone-section-nav phone-modern-nav" data-phone-detail-nav aria-label={modelName}>
    <a class="control-button" href="#phone-overview" aria-current="location">{detailCopy.overview}</a>
    <a class="control-button" href="#phone-story">{detailCopy.story}</a>
    <a class="control-button" href="#phone-specs">{detailCopy.specs}</a>
  </nav>

  <div class="phone-reading-column min-w-0">

    <section class="phone-story-section" aria-labelledby="phone-story">
    <h2 id="phone-story" class="section-label scroll-mt-24">{editorial.story}</h2>
    <div lang={phone.id.split('/')[0]} class="phone-story prose prose-invert mt-4 mb-8 max-w-none prose-p:text-neutral-300">
      <Content />
    </div>

    </section>

    {video && <PhoneVideo locale={locale} slug={slugOf(phone)} poster={data} />}
    <section class="phone-spec-section min-w-0" aria-labelledby="phone-specs">
    <h2 id="phone-specs" class="section-label mt-10 scroll-mt-24">{editorial.specs}</h2>
    <p class="mt-3 text-sm leading-relaxed text-neutral-400">{data.specVariant ? SPEC_VARIANT_NOTE[locale].replace('{model}', data.specVariant.model) : reading.specNote}</p>
    <div class="phone-spec-surface mt-4 overflow-hidden rounded-sm border border-neutral-700 bg-neutral-950/20">
      <table class="phone-spec-table w-full border-collapse text-left text-sm lg:text-base">
        <caption class="sr-only">{data.brand} {data.model} — {editorial.specs}</caption>
        <colgroup><col class="spec-label-column" /><col /></colgroup>
        {groups.map((group, gi) => (
          <tbody class:list={[gi > 0 && 'border-t-2 border-neutral-700']}>
            {group.rows.map(({ label, a, b }, i) => (
              <tr class:list={[i % 2 === 1 && 'bg-neutral-900/50', 'border-b border-neutral-700 last:border-b-0']}>
                <th scope="row" class="w-[38%] border-r border-neutral-700 bg-neutral-900/70 px-3 py-3 text-left align-top text-[0.65rem] leading-snug font-bold tracking-wide text-neutral-400 uppercase sm:w-40 lg:text-xs">
                  {label}
                </th>
                <td class="px-3 py-3 align-top leading-relaxed text-neutral-100">
                  {data.specVariant && a !== b ? (
                    <div class="spec-variants grid gap-2">
                      {a && <div class="flex flex-wrap items-baseline gap-x-2"><span class="text-[0.65rem] font-bold tracking-wide text-neutral-500">{data.model}</span><span>{a}</span></div>}
                      <div class="spec-variant border-l-2 border-orange-500 pl-2"><span class="block text-[0.65rem] font-bold tracking-wide text-orange-500">{data.specVariant.model}</span><span>{b ?? '—'}</span></div>
                    </div>
                  ) : label === s.os && osHref ? (
                    <a class="text-orange-500 underline underline-offset-4 hover-desktop:text-orange-400" href={osHref}>{a}</a>
                  ) : a}
                </td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
    </section>
  </div>
</div>
</div>

{stories.length > 0 && <nav class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-neutral-800 pt-5 text-sm" aria-label={discovery.collections}>
  <span class="text-neutral-500">{discovery.collections}</span>
  {stories.map((story) => <a class="inline-flex min-h-11 items-center text-orange-500 underline underline-offset-4 hover-desktop:text-orange-400" href={localePath(locale, '/catalog/') + '?story=' + story.id}>{story.title}</a>)}
</nav>}

{feature && nextPhone && <section class="mt-10 grid gap-5 border-y border-neutral-700 py-6 sm:grid-cols-[1fr_auto] sm:items-center" aria-labelledby="phone-next">
  <div>
    <p class="editorial-kicker text-orange-500">{featureLabels.next}</p>
    <h2 id="phone-next" class="mt-2 text-xl font-bold"><a class="underline decoration-neutral-700 underline-offset-4 hover-desktop:text-orange-500" href={localePath(locale, `/phones/${feature.next}/`)}>{nextPhone.data.brand} {nextPhone.data.model}</a></h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-300">{feature.note}</p>
  </div>
  <a class="control-button justify-center text-sm" href={localePath(locale, `/compare/?a=${slugOf(phone)}&b=${feature.next}`)}>{featureLabels.compare}</a>
</section>}

{related.length > 0 && (
  <section class="mt-12 border-t border-neutral-800 pt-6" aria-labelledby="related-phones">
    <h2 id="related-phones" class="text-xl font-bold">{stories.length ? discovery.related : `${RELATED_PHONES[locale].title} ${data.brand}`}</h2>
    {stories.length > 0 && <p class="mt-2 max-w-2xl text-sm text-neutral-400">{discovery.note}</p>}
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {related.map((candidate) => (
        <li class="flex min-w-0 flex-col rounded-sm border border-neutral-800 bg-neutral-900 p-4">
          <p class="editorial-kicker mb-3 text-neutral-500">{candidate.data.year < data.year ? editorial.earlier : candidate.data.year > data.year ? editorial.later : editorial.contemporary}</p>
          <a class="flex items-center gap-3 font-semibold text-orange-500 underline underline-offset-4 hover-desktop:text-orange-400" href={localePath(locale, `/phones/${slugOf(candidate)}/`)}>
            <span class="relative flex h-16 w-14 shrink-0 items-center justify-center overflow-hidden rounded-sm bg-neutral-800 p-1.5">
              {candidate.data.image ? <><img data-image-fallback src={candidate.data.image} alt="" loading="lazy" class="h-full w-full object-contain" /><span data-image-fallback-placeholder class="absolute inset-0 hidden flex items-center justify-center p-1.5"><PlaceholderArt class="h-full w-full text-neutral-600" /></span></> : <PlaceholderArt class="h-full w-full text-neutral-600" />}
            </span>
            <span class="min-w-0">{candidate.data.brand} {candidate.data.model}</span>
          </a>
          {museumImageCredit(candidate.data, locale) && <a href={candidate.data.imageSourceUrl} target="_blank" rel="noopener noreferrer" class="mt-2 text-[0.65rem] leading-4 text-orange-500 underline underline-offset-2">{museumImageCredit(candidate.data, locale)!.label}</a>}
          <p class="mt-1 text-sm text-neutral-400">{candidate.data.year}</p>
          {candidate.data.milestone && <p class="mt-2 mb-4 line-clamp-2 text-sm text-neutral-400">{candidate.data.milestone}</p>}
          <a class="mt-auto inline-block pt-3 text-sm text-neutral-300 underline underline-offset-4 hover-desktop:text-orange-500" href={localePath(locale, `/compare/?a=${slugOf(phone)}&b=${slugOf(candidate)}`)}>{RELATED_PHONES[locale].compare}</a>
        </li>
      ))}
    </ul>
  </section>
)}

<script>
  const nav = document.querySelector<HTMLElement>('[data-phone-detail-nav]');
  const header = document.getElementById('site-header');
  if (nav && header) {
    const layout = nav.closest<HTMLElement>('.phone-page-layout')!;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    const sections = links.map(link => document.getElementById(link.hash.slice(1)));
    let pending = false;
    const update = () => {
      pending = false;
      if (!nav.getClientRects().length) return;
      const bottom = nav.getBoundingClientRect().bottom + 24;
      let active = 0;
      sections.slice(1).forEach((section, index) => {
        if (section && section.getBoundingClientRect().top <= bottom) active = index + 1;
      });
      links.forEach((link, index) => {
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const queue = () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(update);
    };
    const measure = () => {
      const offset = parseFloat(getComputedStyle(header).top) || 0;
      layout.style.setProperty('--phone-header-height', `${header.offsetHeight + offset}px`);
      queue();
    };
    const observer = new ResizeObserver(measure);
    observer.observe(header);
    observer.observe(layout);
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('hashchange', queue);
    measure();
  }
</script>

<style>
  .phone-modern-nav, .phone-preview-video, .phone-quick-specs { display: none; }
  :global(html[data-design="modern"] body:has(.phone-page-layout) .global-info-bar) { display: none; }
  :global(html[data-design="modern"] main:has(> .phone-page-layout)) { padding-block-start: clamp(.875rem, 2vw, 1.5rem); }
  :global(html[data-design="modern"]) .phone-page-layout {
    --phone-panel-padding: clamp(.75rem, 2vw, 1.25rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'intro' 'media' 'quick' 'nav' 'reading';
    align-items: start;
    gap: 1rem;
  }
  :global(html[data-design="modern"]) .phone-detail-grid { display: contents; }
  :global(html[data-design="modern"]) :is(.phone-magazine-nav, .phone-gallery-heading, .phone-masthead-form, .phone-masthead .cover-year) { display: none; }
  :global(html[data-design="modern"]) :is(.phone-masthead, .phone-quick-specs, .phone-media-rail) {
    min-width: 0;
    padding: var(--phone-panel-padding);
    border: 1px solid var(--modern-line);
    border-radius: var(--modern-corner);
    background: var(--modern-surface);
  }
  :global(html[data-design="modern"]) .phone-masthead {
    grid-area: intro;
    margin: 0;
    box-shadow: none;
  }
  :global(html[data-design="modern"]) .phone-inline-year { display: inline; font-variant-numeric: tabular-nums; }
  :global(html[data-design="modern"]) .phone-identity-meta .favorite-toggle {
    order: 1;
    margin-inline-start: auto;
    max-inline-size: 60%;
    text-align: start;
  }
  :global(html[data-design="modern"]) .phone-identity-meta .favorite-toggle svg { flex: none; }
  :global(html[data-design="modern"]) .phone-masthead > div { width: 100%; }
