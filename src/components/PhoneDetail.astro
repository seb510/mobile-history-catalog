---
import PlaceholderArt from './PlaceholderArt.astro';
import { render, type CollectionEntry } from 'astro:content';
import { t, RELATED_PHONES, DESIGN_EDITORIAL } from '../lib/ui-strings';
import { getPhonesForLocale, slugOf } from '../lib/phones';
import { buildSpecGroups } from '../lib/specs';
import { slugifyBrandName } from '../lib/brands';
import { localePath, type Locale } from '../lib/locales';

interface Props {
  phone: CollectionEntry<'phones'>;
  locale: Locale;
}
const { phone, locale } = Astro.props;
const { data } = phone;
const strings = t(locale);
const editorial = DESIGN_EDITORIAL[locale];
const s = strings.specs;
const { Content } = await render(phone);

const groups = buildSpecGroups(data, strings);
const images = [
  ...(data.image
    ? [{ image: data.image, imageCredit: data.imageCredit, imageSourceUrl: data.imageSourceUrl, alt: `${data.brand} ${data.model}` }]
    : []),
  ...(data.gallery ?? []),
];
const related = (await getPhonesForLocale(locale))
  .filter((candidate) => candidate.data.brand === data.brand && slugOf(candidate) !== slugOf(phone))
  .sort((a, b) => Math.abs(a.data.year - data.year) - Math.abs(b.data.year - data.year) || a.data.year - b.data.year || slugOf(a).localeCompare(slugOf(b)))
  .slice(0, 3);
---

<header class="phone-cover mb-8 flex items-end justify-between gap-4 border-b border-neutral-800 pb-6">
  <div class="min-w-0">
    <a href={localePath(locale, `/brands/${slugifyBrandName(data.brand)}/`)} class="editorial-kicker text-orange-500 hover-desktop:text-orange-400">{data.brand}</a>
    <h1 class="page-title mt-2">{data.model}</h1>
    {data.milestone && <p class="mt-4 max-w-2xl border-l-2 border-orange-500 pl-3 text-base text-neutral-300 sm:text-lg">{data.milestone}</p>}
    <nav class="mt-5 flex flex-wrap gap-2" aria-label={data.model}>
      <a class="control-button text-xs" href="#phone-story">{editorial.story}</a>
      <a class="control-button text-xs" href="#phone-specs">{editorial.specs}</a>
    </nav>
  </div>
  <span class="cover-year hidden shrink-0 font-extrabold tabular-nums text-neutral-600 sm:block">{data.year}</span>
  <span class="editorial-kicker shrink-0 self-start text-orange-500 sm:hidden">{data.year}</span>
</header>
<div class="grid gap-10 lg:grid-cols-[2fr_3fr]">
  <div class="lg:sticky lg:top-20 lg:self-start">
    <div data-phone-gallery>
      <div class="relative">
        <div class="relative flex h-80 items-center justify-center overflow-hidden rounded-sm border border-neutral-800 border-t-4 border-t-orange-500 bg-neutral-900 p-6 sm:h-96 lg:h-[420px]">
          {images.length > 0 ? (
            images.map((image, index) => (
              <div data-gallery-slide class:list={['absolute inset-0 flex items-center justify-center p-6', index > 0 && 'hidden']}>
                <img data-image-fallback src={image.image} alt={image.alt ?? `${data.brand} ${data.model}`} class="h-full w-full object-contain" />
                <div data-image-fallback-placeholder class="absolute inset-0 hidden flex items-center justify-center p-6">
                  <PlaceholderArt class="h-full w-full text-neutral-700" />
                </div>
              </div>
            ))
          ) : (
            <PlaceholderArt class="h-full w-full text-neutral-700" />
          )}
          {images.length > 0 && (
            <button
              type="button"
              data-gallery-open
              aria-label={strings.gallery.open}
              class="absolute inset-0 z-10 flex cursor-zoom-in items-end justify-end p-3 focus-visible:outline-offset-[-4px]"
            >
              <span class="rounded-sm border border-neutral-600 bg-neutral-950/90 px-3 py-1.5 text-xs font-semibold text-neutral-100">
                {strings.gallery.open}
              </span>
            </button>
          )}
        </div>
      </div>
      {images.length > 1 && (
        <div role="group" aria-label={strings.gallery.label} class="mt-3 flex flex-wrap gap-2">
          {images.map((image, index) => (
            <button
              type="button"
              data-gallery-thumb
              aria-label={strings.gallery.showImage.replace('{index}', String(index + 1)).replace('{count}', String(images.length))}
              aria-pressed={index === 0 ? 'true' : 'false'}
              class:list={[
                'h-16 w-16 overflow-hidden rounded-sm border bg-neutral-900 p-1 transition-colors motion-ui',
                index === 0 ? 'border-orange-500' : 'border-neutral-700 hover-desktop:border-neutral-400',
              ]}
            >
              <img src={image.image} alt="" class="h-full w-full object-contain" loading="lazy" />
            </button>
          ))}
        </div>
      )}
      {images.map((image, index) => (
        image.imageCredit && (
          <p data-gallery-credit={index} class:list={['mt-2 text-xs text-neutral-500', index > 0 && 'hidden']}>
            {image.imageSourceUrl ? (
              <a href={image.imageSourceUrl} class="text-orange-500 underline decoration-current/45 underline-offset-2 transition-colors motion-ui hover-desktop:text-orange-400" target="_blank" rel="noopener noreferrer nofollow">
                {image.imageCredit}
              </a>
            ) : (
              image.imageCredit
            )}
          </p>
        )
      ))}
      {images.length > 0 && (
        <dialog
          data-gallery-dialog
          aria-label={strings.gallery.label}
          class="fixed inset-0 m-0 h-dvh max-h-none w-screen max-w-none overflow-hidden bg-neutral-950 p-0 text-neutral-100 backdrop:bg-neutral-950/95"
        >
          <div class="flex h-dvh flex-col">
            <div class="flex items-center justify-between gap-4 px-4 py-3">
              <p data-gallery-counter class="text-sm font-semibold text-neutral-300">1 / {images.length}</p>
              <button
                type="button"
                data-gallery-close
                aria-label={strings.gallery.close}
                class="flex h-11 w-11 items-center justify-center rounded-sm border border-neutral-700 text-3xl leading-none text-neutral-100 hover-desktop:bg-neutral-800"
              >
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="2">
                  <path d="m6 6 12 12M18 6 6 18" />
                </svg>
              </button>
            </div>
            <div class="relative flex min-h-0 flex-1 items-center justify-center">
              {images.map((image, index) => (
                <div data-gallery-lightbox-slide class:list={['absolute inset-0 flex items-center justify-center p-4 sm:p-8', index > 0 && 'hidden']}>
                  <img data-image-fallback src={image.image} alt={image.alt ?? `${data.brand} ${data.model}`} class="max-h-full max-w-full object-contain" />
                  <div data-image-fallback-placeholder class="absolute inset-0 hidden flex items-center justify-center p-8">
                    <PlaceholderArt class="h-full w-full text-neutral-700" />
                  </div>
                </div>
              ))}
              {images.length > 1 && (
                <>
                  <button
                    type="button"
                    data-gallery-previous
                    aria-label={strings.gallery.previous}
                    class="absolute left-2 z-10 flex h-11 w-11 items-center justify-center rounded-sm border border-neutral-700 bg-neutral-950/90 text-2xl hover-desktop:bg-neutral-800 sm:left-6"
                  >
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="2">
                      <path d="m15 18-6-6 6-6" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    data-gallery-next
                    aria-label={strings.gallery.next}
                    class="absolute right-2 z-10 flex h-11 w-11 items-center justify-center rounded-sm border border-neutral-700 bg-neutral-950/90 text-2xl hover-desktop:bg-neutral-800 sm:right-6"
                  >
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="2">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </button>
                </>
              )}
            </div>
            <div class="min-h-12 px-4 pb-4 text-center text-xs text-neutral-400">
              {images.map((image, index) => (
                image.imageCredit && (
                  <p data-gallery-lightbox-credit data-gallery-lightbox-credit-index={index} class:list={[index > 0 && 'hidden']}>
                    {image.imageSourceUrl ? (
                      <a href={image.imageSourceUrl} target="_blank" rel="noopener noreferrer nofollow" class="text-orange-500 underline underline-offset-2">
                        {image.imageCredit}
                      </a>
                    ) : (
                      image.imageCredit
                    )}
                  </p>
                )
              ))}
            </div>
          </div>
        </dialog>
      )}
    </div>
    {data.colors && data.colors.length > 0 && (
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold tracking-wide text-neutral-500 uppercase">{s.colors}</span>
        {data.colors.map((color) => (
          <span class="rounded-full border border-neutral-700 px-2.5 py-0.5 text-xs text-neutral-300">{color}</span>
        ))}
      </div>
    )}
  </div>

  <div>
    <h2 id="phone-story" class="section-label scroll-mt-24">{editorial.story}</h2>
    <div lang={phone.id.split('/')[0]} class="phone-story prose prose-invert mt-4 max-w-none prose-p:text-neutral-300">
      <Content />
    </div>

    <h2 id="phone-specs" class="section-label mt-10 scroll-mt-24">{editorial.specs}</h2>
    <div class="mt-4 overflow-hidden rounded-sm border border-neutral-700 bg-neutral-950/20">
      <table class="w-full border-collapse text-left text-sm lg:text-base">
        {groups.map((group, gi) => (
          <tbody class:list={[gi > 0 && 'border-t-2 border-neutral-700']}>
            {group.rows.map(([label, value], i) => (
              <tr class:list={[i % 2 === 1 && 'bg-neutral-900/50', 'border-b border-neutral-700 last:border-b-0']}>
                <th scope="row" class="w-[38%] border-r border-neutral-700 bg-neutral-900/70 px-3 py-3 text-left align-top text-[0.65rem] leading-snug font-bold tracking-wide text-neutral-400 uppercase sm:w-40 lg:text-xs">
                  {label}
                </th>
                <td class="px-3 py-3 align-top leading-relaxed text-neutral-100">{value}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </div>
</div>

{related.length > 0 && (
  <section class="mt-12 border-t border-neutral-800 pt-6" aria-labelledby="related-phones">
    <h2 id="related-phones" class="text-xl font-bold">{RELATED_PHONES[locale].title} {data.brand}</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {related.map((candidate) => (
        <li class="min-w-0 rounded-sm border border-neutral-800 bg-neutral-900 p-4">
          <p class="editorial-kicker mb-3 text-neutral-500">{candidate.data.year < data.year ? editorial.earlier : candidate.data.year > data.year ? editorial.later : editorial.contemporary}</p>
          <a class="font-semibold text-orange-500 underline underline-offset-4 hover-desktop:text-orange-400" href={localePath(locale, `/phones/${slugOf(candidate)}/`)}>{candidate.data.brand} {candidate.data.model}</a>
          <p class="mt-1 text-sm text-neutral-400">{candidate.data.year}</p>
          <a class="mt-3 inline-block text-sm text-neutral-300 underline underline-offset-4 hover-desktop:text-orange-500" href={localePath(locale, `/compare/?a=${slugOf(phone)}&b=${slugOf(candidate)}`)}>{RELATED_PHONES[locale].compare}</a>
        </li>
      ))}
    </ul>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-phone-gallery]').forEach((gallery) => {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
    const lightboxSlides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-lightbox-slide]'));
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'));
    const credits = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-credit]'));
    const lightboxCredits = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-lightbox-credit]'));
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
    const openButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-open]');
    const closeButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-close]');
    const previousButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-previous]');
    const nextButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const counter = gallery.querySelector<HTMLElement>('[data-gallery-counter]');
    let activeIndex = 0;

    const activate = (index: number, moveFocus = false) => {
      activeIndex = index;
      slides.forEach((slide, slideIndex) => slide.classList.toggle('hidden', slideIndex !== index));
      lightboxSlides.forEach((slide, slideIndex) => slide.classList.toggle('hidden', slideIndex !== index));
      credits.forEach((credit) => credit.classList.toggle('hidden', Number(credit.dataset.galleryCredit) !== index));
      lightboxCredits.forEach((credit) =>
        credit.classList.toggle('hidden', Number(credit.dataset.galleryLightboxCreditIndex) !== index),
      );
      if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
      thumbs.forEach((thumb, thumbIndex) => {
        const selected = thumbIndex === index;
        thumb.setAttribute('aria-pressed', String(selected));
        thumb.classList.toggle('border-orange-500', selected);
        thumb.classList.toggle('border-neutral-700', !selected);
        if (moveFocus && selected) thumb.focus();
      });
    };

    openButton?.addEventListener('click', () => {
      dialog?.showModal();
      closeButton?.focus();
    });
    closeButton?.addEventListener('click', () => dialog?.close());
    previousButton?.addEventListener('click', () => activate((activeIndex - 1 + slides.length) % slides.length));
    nextButton?.addEventListener('click', () => activate((activeIndex + 1) % slides.length));
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        activate((activeIndex - 1 + slides.length) % slides.length);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        activate((activeIndex + 1) % slides.length);
      }
    });
    dialog?.addEventListener('close', () => openButton?.focus());

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener('click', () => activate(index));
      thumb.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight' || event.key === 'ArrowLeft' || event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          const nextIndex =
            event.key === 'Home'
              ? 0
              : event.key === 'End'
                ? thumbs.length - 1
                : (index + (event.key === 'ArrowRight' ? 1 : -1) + thumbs.length) % thumbs.length;
          activate(nextIndex, true);
        }
      });
    });
  });
</script>
