---
import type { Locale } from '../lib/locales';
import type { PhoneSoundClip } from '../lib/phone-sounds';

interface Props {
  locale: Locale;
  model: string;
  startup?: PhoneSoundClip;
  signature?: PhoneSoundClip;
}

const { locale, model, startup, signature } = Astro.props;
const copy = {
  uk: {
    kicker: 'Аудіо',
    title: 'Звуки телефона',
    intro: 'Два короткі записи саме цієї моделі.',
    startup: 'Звук запуску',
    signature: 'Рингтон або характерна мелодія',
    source: 'Джерело',
    rights: 'Права',
  },
  ru: {
    kicker: 'Аудио',
    title: 'Звуки телефона',
    intro: 'Две короткие записи именно этой модели.',
    startup: 'Звук запуска',
    signature: 'Рингтон или характерная мелодия',
    source: 'Источник',
    rights: 'Права',
  },
  en: {
    kicker: 'Audio',
    title: 'Phone sounds',
    intro: 'Two short recordings of this specific model.',
    startup: 'Startup sound',
    signature: 'Ringtone or signature melody',
    source: 'Source',
    rights: 'Rights',
  },
}[locale];

const clips = [
  startup && { key: 'startup', label: copy.startup, clip: startup },
  signature && { key: 'signature', label: copy.signature, clip: signature },
].filter((clip): clip is NonNullable<typeof clip> => Boolean(clip));
---

<section class="phone-audio" aria-labelledby="phone-audio-title">
  <p class="editorial-kicker text-orange-500">{copy.kicker}</p>
  <h2 id="phone-audio-title" class="mt-2 text-lg font-bold">{copy.title} · {model}</h2>
  <p class="mt-1 text-sm leading-relaxed text-neutral-400">{copy.intro}</p>
  <div class="mt-4 grid gap-3">
    {clips.map(({ key, label, clip }) => (
      <figure class="phone-audio-track" data-phone-audio-track={key}>
        <figcaption>
          <h3 class="text-sm font-semibold text-neutral-200">{label}</h3>
          <p class="mt-1 text-xs leading-relaxed text-neutral-400">{clip.note[locale]}</p>
        </figcaption>
        <audio class="mt-3 block min-h-11 w-full" controls preload="none" aria-label={`${label} — ${model}`} src={clip.src}>
          {locale === 'uk' ? 'Ваш браузер не підтримує відтворення аудіо.' : locale === 'ru' ? 'Ваш браузер не поддерживает воспроизведение аудио.' : 'Your browser does not support audio playback.'}
        </audio>
        <p class="mt-2 text-xs leading-relaxed text-neutral-500">
          {clip.credit} · {copy.rights}: {clip.rights}
          {clip.sourceUrl && <> · <a class="text-orange-500 underline underline-offset-2" href={clip.sourceUrl} target="_blank" rel="noopener noreferrer">{copy.source}</a></>}
        </p>
      </figure>
    ))}
  </div>
</section>
