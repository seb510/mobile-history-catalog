---
import type { Locale } from '../lib/locales';
import type { PhoneStartupSound } from '../lib/phone-sounds';

interface Props {
  locale: Locale;
  brand: string;
  sound: PhoneStartupSound;
}

const { locale, brand, sound } = Astro.props;
const copy = {
  uk: {
    title: 'Звук запуску',
    source: 'Джерело й авторство',
    play: 'Відтворити',
    pause: 'Пауза',
  },
  ru: {
    title: 'Звук запуска',
    source: 'Источник и авторство',
    play: 'Воспроизвести',
    pause: 'Пауза',
  },
  en: {
    title: 'Startup sound',
    source: 'Source and credit',
    play: 'Play',
    pause: 'Pause',
  },
}[locale];
---

<section class="phone-audio phone-startup-audio" aria-labelledby="phone-startup-audio-title">
  <h2 id="phone-startup-audio-title" class="phone-startup-audio-heading font-bold">{copy.title} · {brand}</h2>
  <div class="phone-startup-audio-tracks grid gap-2">
    {sound.tracks.map((track, index) => (
      <figure class="phone-audio-track">
        <figcaption id={`startup-track-${index}`} class="text-xs font-semibold text-neutral-200">{track.title[locale]}</figcaption>
        <div class="audio-player mt-2" data-audio-player>
          <button type="button" class="audio-toggle" data-audio-toggle aria-pressed="false" aria-label={copy.play}>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="audio-icon-play" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="audio-icon-pause" fill="currentColor"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>
          </button>
          <div class="audio-scrub" data-audio-scrub role="slider" tabindex="0" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label={track.title[locale]}>
            <div class="audio-scrub-track"><div class="audio-scrub-fill" data-audio-fill></div></div>
          </div>
          <span class="audio-time" data-audio-time aria-hidden="true">0:00 / 0:00</span>
          <audio aria-labelledby={`startup-track-${index}`} data-audio-element preload="none" src={track.src}>
            {locale === 'uk' ? 'Ваш браузер не підтримує відтворення аудіо.' : locale === 'ru' ? 'Ваш браузер не поддерживает воспроизведение аудио.' : 'Your browser does not support audio playback.'}
          </audio>
        </div>
      </figure>
    ))}
  </div>
  <div class="phone-startup-audio-attribution text-xs leading-relaxed">
    <p class="text-neutral-300">
      {sound.credit} · <a class="text-orange-500 underline underline-offset-2" href={sound.sourceUrl} target="_blank" rel="noopener noreferrer">{copy.source}</a>
    </p>
    <p class="text-neutral-400">{sound.rightsNote[locale]}</p>
  </div>
</section>
<script>
  const fmt = (seconds: number) => {
    if (!isFinite(seconds) || seconds < 0) return '0:00';
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60).toString().padStart(2, '0');
    return `${m}:${s}`;
  };
  document.querySelectorAll<HTMLElement>('[data-audio-player]').forEach(root => {
    const audio = root.querySelector<HTMLAudioElement>('[data-audio-element]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-audio-toggle]')!;
    const scrub = root.querySelector<HTMLElement>('[data-audio-scrub]')!;
    const fill = root.querySelector<HTMLElement>('[data-audio-fill]')!;
    const time = root.querySelector<HTMLElement>('[data-audio-time]')!;
    const update = () => {
      time.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
      const pct = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
      fill.style.width = `${pct}%`;
      scrub.setAttribute('aria-valuenow', String(Math.round(pct)));
    };
    const seekTo = (ratio: number) => {
      if (isFinite(audio.duration)) audio.currentTime = Math.min(1, Math.max(0, ratio)) * audio.duration;
    };
    toggle.addEventListener('click', () => { audio.paused ? audio.play() : audio.pause(); });
    audio.addEventListener('play', () => toggle.setAttribute('aria-pressed', 'true'));
    audio.addEventListener('pause', () => toggle.setAttribute('aria-pressed', 'false'));
    audio.addEventListener('ended', () => toggle.setAttribute('aria-pressed', 'false'));
    audio.addEventListener('loadedmetadata', update);
    audio.addEventListener('timeupdate', update);
    scrub.addEventListener('click', (event) => {
      const rect = scrub.getBoundingClientRect();
      seekTo((event.clientX - rect.left) / rect.width);
    });
    scrub.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { audio.currentTime = Math.min(audio.duration || 0, audio.currentTime + 2); event.preventDefault(); }
      if (event.key === 'ArrowLeft') { audio.currentTime = Math.max(0, audio.currentTime - 2); event.preventDefault(); }
    });
    update();
  });
</script>
