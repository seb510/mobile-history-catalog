---
import Arrow from './Arrow.astro';
import BrandMark from './BrandMark.astro';
import FilterSelect from './FilterSelect.astro';
import { getBrandsForLocale, slugOfBrand } from '../lib/brands';
import { getPhonesForLocale } from '../lib/phones';
import { localePath, type Locale } from '../lib/locales';
import { t } from '../lib/ui-strings';
import { BRAND_EDITION, BRAND_NOTES } from '../lib/brand-editorial';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const strings = t(locale);
const copy = BRAND_EDITION[locale];

const phoneCountText = (count: number) => {
  const forms = strings.brands.phoneCount;
  if (locale === 'en') return count === 1 ? forms.one : forms.many;
  const lastTwo = count % 100;
  const last = count % 10;
  if (last === 1 && lastTwo !== 11) return forms.one;
  if (last >= 2 && last <= 4 && (lastTwo < 12 || lastTwo > 14)) return 'few' in forms ? forms.few : forms.many;
  return forms.many;
};

const brands = await getBrandsForLocale(locale);
const phones = await getPhonesForLocale(locale);
const archiveByBrand = new Map<string, { count: number; first: number; last: number }>();
for (const phone of phones) {
  const { brand, year } = phone.data;
  const archive = archiveByBrand.get(brand);
  if (archive) {
    archive.count += 1;
    archive.first = Math.min(archive.first, year);
    archive.last = Math.max(archive.last, year);
  } else {
    archiveByBrand.set(brand, { count: 1, first: year, last: year });
  }
}

const sorted = brands.slice().sort((a, b) => a.data.name.localeCompare(b.data.name, locale));
---

<div class="mb-4 w-full sm:w-64" data-brand-sort hidden>
  <FilterSelect name="brand-order" label={copy.sort.label} options={[
    { value: 'name', label: copy.sort.name },
    { value: 'count', label: copy.sort.count },
    { value: 'year', label: copy.sort.year },
  ]} />
</div>
<ul id="brand-grid" class="brand-index-grid grid items-stretch gap-3 sm:auto-rows-fr sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
  {sorted.map((brand) => {
    const { name } = brand.data;
    const slug = slugOfBrand(brand);
    const archive = archiveByBrand.get(name);
    const count = archive?.count ?? 0;
    let yearRange = '—';
    if (archive) {
      yearRange = archive.first === archive.last ? String(archive.first) : `${archive.first}–${archive.last}`;
    }
    return (
      <li class="flex min-w-0" data-brand-count={count} data-brand-first={archive?.first}>
        <a
          href={localePath(locale, `/brands/${slug}/`)}
          class="brand-index-card editorial-card group flex h-full min-w-0 w-full flex-col rounded-sm border border-neutral-800 bg-neutral-900 p-5 motion-ui sm:p-6"
        >
          <BrandMark name={name} logo={brand.data.logo} class={`brand-index-logo brand-index-logo--${slug} h-20 w-full min-w-0 shrink-0`} />
          <div class="card-copy mt-5 flex w-full flex-1 flex-col border-t border-neutral-800 pt-4">
            <h2 class="card-title text-xl font-bold tracking-tight text-neutral-100">{name}</h2>
            <p class="brand-index-note mt-2 text-sm leading-relaxed text-neutral-400">{BRAND_NOTES[locale][name]}</p>
            <div class="brand-index-meta mt-auto flex flex-wrap items-end justify-between gap-3 pt-5 text-sm">
              <div>
                <p class="text-xs text-neutral-500">{copy.archiveYears}</p>
                <p class="mt-1 font-semibold tabular-nums text-neutral-200">{yearRange}</p>
              </div>
              <p class="text-neutral-400"><span class="font-semibold text-neutral-200">{count}</span> {phoneCountText(count)}</p>
            </div>
            <p class="brand-index-action mt-4 flex items-center justify-between border-t border-neutral-800 pt-3 text-sm font-semibold text-orange-500"><span>{copy.open}</span><Arrow direction="right" /></p>
          </div>
        </a>
      </li>
    );
  })}
</ul>

<script>
  const sort = document.querySelector<HTMLElement>('[data-brand-sort]');
  const order = sort?.querySelector<HTMLSelectElement>('[data-select-native]');
  const grid = document.querySelector<HTMLUListElement>('#brand-grid');
  if (sort && order && grid) {
    const alphabetical = [...grid.querySelectorAll<HTMLLIElement>(':scope > li')];
    const byCount = [...alphabetical].sort((a, b) => Number(b.dataset.brandCount) - Number(a.dataset.brandCount));
    const firstYear = (card: HTMLLIElement) => Number(card.dataset.brandFirst ?? Number.MAX_SAFE_INTEGER);
    const byYear = [...alphabetical].sort((a, b) => firstYear(a) - firstYear(b));
    const sortCards = () => {
      const cards = order.value === 'count' ? byCount : order.value === 'year' ? byYear : alphabetical;
      grid.append(...cards);
    };
    sort.hidden = false;
    order.addEventListener('change', sortCards);
    window.addEventListener('pageshow', sortCards);
    sortCards();
  }
</script>

<style>
  .brand-index-card :global(.brand-index-logo) { box-shadow: none; }
  .brand-index-card :global(.brand-index-logo img) { width: min(72%, 9.25rem); height: 2.1rem; }
  .brand-index-card :global(.brand-index-logo--apple img),
  .brand-index-card :global(.brand-index-logo--htc img) { height: 2.75rem; }
  .brand-index-note { min-height: 3em; }
  .brand-index-card:focus-visible { outline: 2px solid var(--color-orange-500); outline-offset: 4px; }
  @media (max-width: 639px) {
    .brand-index-card { display: grid; grid-template-columns: 4.25rem minmax(0, 1fr); align-items: start; gap: .75rem; padding: .75rem; }
    .brand-index-card :global(.brand-index-logo) { height: 3.5rem; padding: .35rem; }
    .brand-index-card :global(.brand-index-logo img) { width: 100%; height: 1.7rem; }
    .brand-index-card :global(.brand-index-logo--apple img),
    .brand-index-card :global(.brand-index-logo--htc img) { height: 2.2rem; }
    .brand-index-card :global(.brand-index-logo span) { font-size: .75rem; text-align: center; overflow-wrap: anywhere; }
    .brand-index-card :global(.card-copy) { margin-top: 0; border-top: 0; padding-top: 0; }
    .brand-index-card :global(.card-title) { font-size: 1.125rem; }
    .brand-index-note { min-height: 0; margin-top: .25rem; }
    .brand-index-meta { gap: .4rem .75rem; padding-top: .65rem; }
    .brand-index-action { margin-top: .6rem; padding-top: .45rem; }
  }
</style>
