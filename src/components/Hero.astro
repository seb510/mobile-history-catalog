---
import PhoneCard from './PhoneCard.astro';
import GenerationComparison from './GenerationComparison.astro';
import PlaceholderArt from './PlaceholderArt.astro';
import { getPhonesForLocale, slugOf } from '../lib/phones';
import { t, HOME_EDITORIAL, FINAL_DESIGN_COPY } from '../lib/ui-strings';
import { localePath, type Locale } from '../lib/locales';
import { RETRO_STORIES } from '../lib/editorial-stories';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const strings = t(locale);

const phones = await getPhonesForLocale(locale);
const brandsCount = new Set(phones.map((p) => p.data.brand)).size;
const minYear = Math.min(...phones.map((p) => p.data.year));
const yearsSpan = new Date().getFullYear() - minYear + 1;

const bestSellers = phones
  .filter((p) => p.data.year <= 2007 && p.data.unitsSoldMillions != null)
  .sort((a, b) => b.data.unitsSoldMillions! - a.data.unitsSoldMillions!)
  .slice(0, 4);
const coverPhone = phones.find(p => slugOf(p) === 'motorola-razr-v3');
const copy = HOME_EDITORIAL[locale];
const pair = ['motorola-razr-v3', 'nokia-n95'].map(slug => phones.find(p => slugOf(p) === slug));
const themes = copy.themes.map((theme, index) => ({ ...theme, id: RETRO_STORIES[index].id, phones: RETRO_STORIES[index].leads.flatMap((slug) => { const phone = phones.find((p) => slugOf(p) === slug); return phone ? [phone] : []; }) }));
const otherBestSellers = bestSellers;
const reviewCopy = FINAL_DESIGN_COPY[locale];
const singleSeller = bestSellers.length === 1;

const stats = [
  { value: phones.length, label: strings.hero.statsPhones },
  { value: brandsCount, label: strings.hero.statsBrands },
  { value: yearsSpan, label: strings.hero.statsYears },
];
---

<section class="home-cover border-b border-neutral-800 py-4 sm:py-10">
  <div class="grid items-center gap-8 sm:gap-10 lg:grid-cols-[1fr_0.82fr]">
    <div>
    <p class="editorial-kicker animate-fade-up mb-5 inline-flex items-center gap-2 text-orange-500">
      <span class="h-2 w-2 bg-orange-500"></span>{strings.hero.eyebrow}
    </p>
    <h1 class="animate-fade-up max-w-xl text-[2.5rem] font-extrabold leading-[0.98] tracking-[-0.055em] sm:text-6xl lg:text-7xl" style="animation-delay:0.05s">
      {copy.title}
    </h1>
    <p class="animate-fade-up mt-4 max-w-lg text-base leading-relaxed text-neutral-400 sm:mt-5 sm:text-lg" style="animation-delay:0.1s">
      {strings.tagline}
    </p>

    <div class="animate-fade-up mt-6 grid grid-cols-2 gap-2 sm:mt-7 sm:flex sm:flex-wrap sm:gap-3" style="animation-delay:0.15s">
      <a
        href={localePath(locale, '/catalog/')}
        class="primary-cta inline-flex min-h-11 items-center justify-center rounded-sm bg-orange-500 px-3 py-3 text-center text-sm font-bold text-neutral-950 transition-colors motion-ui sm:px-5"
      >
        {strings.hero.cta}
      </a>
      <a
        href={localePath(locale, '/about/')}
        class="inline-flex min-h-11 items-center justify-center rounded-sm border border-neutral-700 px-3 py-3 text-center text-sm font-semibold text-neutral-200 transition-colors motion-ui hover-desktop:border-orange-500 sm:px-5"
      >
        {strings.hero.ctaAbout}
      </a>
    </div>

  </div>

  {coverPhone && (
    <a
      href={localePath(locale, `/phones/${slugOf(coverPhone)}/`)}
      class="editorial-card group focus-visible:-outline-offset-4 block overflow-hidden rounded-sm border border-neutral-800 bg-neutral-900 motion-ui"
    >
      <div class="relative flex aspect-[4/3] items-center justify-center overflow-hidden border-b border-neutral-800 bg-neutral-800 p-6 sm:aspect-[5/3] lg:aspect-[4/3]">
        {coverPhone.data.image ? (
          <>
            <img data-image-fallback src={coverPhone.data.image} alt={`${coverPhone.data.brand} ${coverPhone.data.model}`} class="h-full w-full object-contain" fetchpriority="high" />
            <div data-image-fallback-placeholder class="absolute inset-0 hidden flex items-center justify-center p-6">
              <PlaceholderArt class="h-full w-full text-neutral-600" />
            </div>
          </>
        ) : (
          <PlaceholderArt class="h-full w-full text-neutral-600" />
        )}
        <span class="editorial-kicker absolute top-3 left-3 bg-orange-500 px-2 py-1 text-neutral-950">
          {copy.cover}
        </span>
      </div>
      <div class="card-copy grid gap-2 p-4 sm:grid-cols-[1fr_auto] sm:items-end sm:p-5">
        <div>
          <p class="editorial-kicker text-neutral-500">{coverPhone.data.brand} · {coverPhone.data.year}</p>
          <h2 class="card-title mt-1 text-2xl font-extrabold leading-none tracking-tight sm:text-3xl">{coverPhone.data.model}</h2>
          {coverPhone.data.milestone && <p class="mt-2 border-l-2 border-orange-500 pl-2 text-sm text-neutral-400">{coverPhone.data.milestone}</p>}
        </div>
        <span class="hidden text-3xl text-orange-500 sm:block" aria-hidden="true">→</span>
      </div>
    </a>
  )}
  </div>

  <div class="animate-fade-up mt-6 grid max-w-lg grid-cols-3 divide-x divide-neutral-800 border-y border-neutral-800 py-3 lg:mt-8" style="animation-delay:0.2s">
    {stats.map((stat, index) => (
      <div class:list={[index === 0 ? 'pr-3' : 'px-3']}>
        <p class="text-2xl font-extrabold tracking-tight text-orange-500">{stat.value}</p>
        <p class="editorial-kicker mt-1 text-[0.6rem] text-neutral-500">{stat.label}</p>
      </div>
    ))}
  </div>
</section>

<nav class="py-8 sm:py-10" aria-label={copy.eras}>
  <p class="editorial-kicker mb-4 text-neutral-500">{copy.eras}</p>
  <ul class="grid gap-px border border-neutral-800 bg-neutral-800 sm:grid-cols-3">
    {themes.map((theme, index) => <li class="bg-neutral-950"><a class="flex min-h-16 items-center gap-3 p-4 text-sm font-semibold transition-colors motion-ui hover-desktop:bg-neutral-900" href={`#${theme.id}`}><span class="editorial-kicker text-orange-500">0{index + 1}</span>{theme.title}<span class="ml-auto text-orange-500" aria-hidden="true">↓</span></a></li>)}
  </ul>
</nav>
{pair.every(Boolean) && <GenerationComparison phones={pair.filter((phone) => phone != null)} locale={locale} />}

{themes.map((theme, index) => <section id={theme.id} class="scroll-mt-20 border-b border-neutral-800 py-9 sm:py-12" aria-labelledby={`${theme.id}-title`}>
  <div class="grid gap-6 lg:grid-cols-[.7fr_1.3fr] lg:gap-10">
    <div><p class="editorial-kicker text-orange-500">0{index + 1}</p><h2 id={`${theme.id}-title`} class="mt-3 text-3xl font-extrabold tracking-tight">{theme.title}</h2><p class="mt-4 max-w-md text-base leading-relaxed text-neutral-400">{theme.text}</p><a class="mt-5 inline-block text-sm font-semibold text-orange-500 underline underline-offset-4 hover-desktop:text-orange-400" href={localePath(locale, '/catalog/') + '?story=' + theme.id}>{strings.hero.cta} →</a></div>
    <ul class="grid auto-rows-fr grid-cols-2 gap-3 sm:gap-4">{theme.phones.map((phone) => <li class="flex min-w-0"><PhoneCard phone={phone} locale={locale} /></li>)}</ul>
  </div>
</section>)}

{bestSellers.length > 0 && (
  <section class:list={['pt-10 sm:pt-14', singleSeller && 'sales-feature']}>
    <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
      <div>
        <p class="editorial-kicker text-orange-500">{strings.hero.eyebrow}</p>
        <h2 class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">{singleSeller ? reviewCopy.sales : strings.hero.popularTitle}</h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-neutral-400 sm:text-right">{singleSeller ? reviewCopy.salesNote : strings.hero.popularSubtitle}</p>
    </div>
    {otherBestSellers.length > 0 && (
      <ul class:list={['mt-6 grid gap-4', singleSeller ? 'grid-cols-1' : 'grid-cols-2 lg:auto-rows-fr lg:items-stretch lg:grid-cols-4']}>
        {otherBestSellers.map((phone, i) => (
        <li class="flex min-w-0">
          <PhoneCard phone={phone} locale={locale} badge={`${singleSeller ? '' : `#${i + 1} · `}${phone.data.unitsSoldMillions} ${strings.hero.soldSuffix}`} />
        </li>
        ))}
      </ul>
    )}
  </section>
)}

<section class="mt-12 border-y border-neutral-800 py-8 sm:mt-16"><div class="flex flex-wrap items-end justify-between gap-4"><h2 class="text-2xl font-extrabold sm:text-3xl">{copy.principles}</h2><a href={localePath(locale,'/about/')} class="text-sm font-semibold text-orange-500 underline underline-offset-4">{strings.hero.ctaAbout} →</a></div><div class="mt-7 grid gap-6 sm:grid-cols-3">{copy.principleItems.map((item,i) => <div class="border-t border-neutral-800 pt-4"><p class="editorial-kicker text-orange-500">0{i+1}</p><h3 class="mt-3 text-lg font-bold">{item.title}</h3><p class="mt-2 text-sm leading-relaxed text-neutral-400">{item.text}</p></div>)}</div></section>

<aside class="mt-8 max-w-2xl border-l-2 border-neutral-700 pl-4"><h2 class="text-lg font-bold">{copy.modernTitle}</h2><p class="mt-2 text-sm leading-relaxed text-neutral-400">{copy.modernText}</p><a class="mt-3 inline-block text-sm font-semibold text-orange-500 underline underline-offset-4" href={localePath(locale, '/catalog/') + '#year-2019'}>{copy.modernLink} →</a></aside>
