---
import PhoneCard from './PhoneCard.astro';
import GenerationComparison from './GenerationComparison.astro';
import PlaceholderArt from './PlaceholderArt.astro';
import { getPhonesForLocale, slugOf } from '../lib/phones';
import { t, HOME_EDITORIAL } from '../lib/ui-strings';
import { localePath, type Locale } from '../lib/locales';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const strings = t(locale);

const phones = await getPhonesForLocale(locale);
const brandsCount = new Set(phones.map((p) => p.data.brand)).size;
const minYear = Math.min(...phones.map((p) => p.data.year));
const yearsSpan = new Date().getFullYear() - minYear + 1;

const bestSellers = phones
  .filter((p) => p.data.unitsSoldMillions != null)
  .sort((a, b) => b.data.unitsSoldMillions! - a.data.unitsSoldMillions!)
  .slice(0, 4);
const coverPhone = phones.find(p => slugOf(p) === 'nokia-3310');
const copy = HOME_EDITORIAL[locale];
const eras = [1999, 2004, 2007, 2019];
const ranges = ['1998–2002', '2003–2006', '2007–2018', '2019–…'];
const pair = ['nokia-3310', 'samsung-galaxy-s26-ultra'].map(slug => phones.find(p => slugOf(p) === slug));
const otherBestSellers = bestSellers;

const stats = [
  { value: phones.length, label: strings.hero.statsPhones },
  { value: brandsCount, label: strings.hero.statsBrands },
  { value: yearsSpan, label: strings.hero.statsYears },
];
---

<section class="border-b border-neutral-800 py-8 sm:py-14">
  <div class="grid items-center gap-8 sm:gap-10 lg:grid-cols-[1fr_0.82fr]">
    <div>
    <p class="editorial-kicker animate-fade-up mb-5 inline-flex items-center gap-2 text-orange-500">
      <span class="h-2 w-2 bg-orange-500"></span>{strings.hero.eyebrow}
    </p>
    <h1 class="animate-fade-up max-w-xl text-5xl font-extrabold leading-[0.94] tracking-[-0.055em] sm:text-6xl lg:text-7xl" style="animation-delay:0.05s">
      {copy.title}
    </h1>
    <p class="animate-fade-up mt-5 max-w-lg text-lg leading-relaxed text-neutral-400" style="animation-delay:0.1s">
      {strings.tagline}
    </p>

    <div class="animate-fade-up mt-7 flex flex-wrap gap-3" style="animation-delay:0.15s">
      <a
        href={localePath(locale, '/catalog/')}
        class="primary-cta rounded-sm bg-orange-500 px-5 py-3 text-sm font-bold text-neutral-950 transition-colors motion-ui"
      >
        {strings.hero.cta}
      </a>
      <a
        href={localePath(locale, '/about/')}
        class="rounded-sm border border-neutral-700 px-5 py-3 text-sm font-semibold text-neutral-200 transition-colors motion-ui hover-desktop:border-orange-500"
      >
        {strings.hero.ctaAbout}
      </a>
    </div>

  </div>

  {coverPhone && (
    <a
      href={localePath(locale, `/phones/${slugOf(coverPhone)}/`)}
      class="editorial-card group focus-visible:-outline-offset-4 block overflow-hidden rounded-sm border border-neutral-800 bg-neutral-900 motion-ui"
    >
      <div class="relative flex aspect-[4/3] items-center justify-center overflow-hidden border-b border-neutral-800 bg-neutral-800 p-6 sm:aspect-[5/3] lg:aspect-[4/3]">
        {coverPhone.data.image ? (
          <>
            <img data-image-fallback src={coverPhone.data.image} alt={`${coverPhone.data.brand} ${coverPhone.data.model}`} class="h-full w-full object-contain" fetchpriority="high" />
            <div data-image-fallback-placeholder class="absolute inset-0 hidden flex items-center justify-center p-6">
              <PlaceholderArt class="h-full w-full text-neutral-600" />
            </div>
          </>
        ) : (
          <PlaceholderArt class="h-full w-full text-neutral-600" />
        )}
        <span class="editorial-kicker absolute top-3 left-3 bg-orange-500 px-2 py-1 text-neutral-950">
          {copy.cover}
        </span>
      </div>
      <div class="card-copy grid gap-2 p-4 sm:grid-cols-[1fr_auto] sm:items-end sm:p-5">
        <div>
          <p class="editorial-kicker text-neutral-500">{coverPhone.data.brand} · {coverPhone.data.year}</p>
          <h2 class="card-title mt-1 text-2xl font-extrabold leading-none tracking-tight sm:text-3xl">{coverPhone.data.model}</h2>
          {coverPhone.data.milestone && <p class="mt-2 border-l-2 border-orange-500 pl-2 text-sm text-neutral-400">{coverPhone.data.milestone}</p>}
        </div>
        <span class="hidden text-3xl text-orange-500 sm:block" aria-hidden="true">→</span>
      </div>
    </a>
  )}
  </div>

  <div class="animate-fade-up mt-6 grid max-w-lg grid-cols-3 divide-x divide-neutral-800 border-y border-neutral-800 py-3 lg:mt-8" style="animation-delay:0.2s">
    {stats.map((stat, index) => (
      <div class:list={[index === 0 ? 'pr-3' : 'px-3']}>
        <p class="text-2xl font-extrabold tracking-tight text-orange-500">{stat.value}</p>
        <p class="editorial-kicker mt-1 text-[0.6rem] text-neutral-500">{stat.label}</p>
      </div>
    ))}
  </div>
</section>

<section class="py-9 sm:py-12" aria-labelledby="eras-title"><h2 id="eras-title" class="editorial-kicker mb-5 text-neutral-400">{copy.eras}</h2><ol class="grid grid-cols-2 gap-px border border-neutral-800 bg-neutral-800 lg:grid-cols-4">{eras.map((year,i) => <li class="bg-neutral-950"><a href={localePath(locale,'/catalog/') + '#year-' + year} class="block p-5 transition-colors motion-ui hover-desktop:bg-neutral-900"><p class="text-2xl font-extrabold tracking-tight text-orange-500">{ranges[i]}</p><p class="mt-4 text-sm font-semibold">{copy.labels[i]} <span aria-hidden="true">↗︎</span></p></a></li>)}</ol></section>
{pair.every(Boolean) && <GenerationComparison phones={pair.filter((phone) => phone != null)} locale={locale} />}

{bestSellers.length > 0 && (
  <section class="pt-12 sm:pt-16">
    <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
      <div>
        <p class="editorial-kicker text-orange-500">{strings.hero.eyebrow}</p>
        <h2 class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">{strings.hero.popularTitle}</h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-neutral-400 sm:text-right">{strings.hero.popularSubtitle}</p>
    </div>
    {otherBestSellers.length > 0 && (
      <ul class="mt-6 grid grid-cols-2 gap-4 lg:auto-rows-fr lg:items-stretch lg:grid-cols-4">
        {otherBestSellers.map((phone, i) => (
        <li class="flex min-w-0">
          <PhoneCard phone={phone} locale={locale} badge={`#${i + 1} · ${phone.data.unitsSoldMillions} ${strings.hero.soldSuffix}`} />
        </li>
        ))}
      </ul>
    )}
  </section>
)}

<section class="mt-12 border-y border-neutral-800 py-8 sm:mt-16"><div class="flex flex-wrap items-end justify-between gap-4"><h2 class="text-2xl font-extrabold sm:text-3xl">{copy.principles}</h2><a href={localePath(locale,'/about/')} class="text-sm font-semibold text-orange-500 underline underline-offset-4">{strings.hero.ctaAbout} →</a></div><div class="mt-7 grid gap-6 sm:grid-cols-3">{copy.principleItems.map((item,i) => <div class="border-t border-neutral-800 pt-4"><p class="editorial-kicker text-orange-500">0{i+1}</p><h3 class="mt-3 text-lg font-bold">{item.title}</h3><p class="mt-2 text-sm leading-relaxed text-neutral-400">{item.text}</p></div>)}</div></section>
