---
import PhoneCard from './PhoneCard.astro';
import FilterSelect from './FilterSelect.astro';
import { getPhonesForLocale } from '../lib/phones';
import { t, DESIGN_EDITORIAL } from '../lib/ui-strings';
import type { Locale } from '../lib/locales';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const strings = t(locale);
const editorial = DESIGN_EDITORIAL[locale];

const phones = await getPhonesForLocale(locale);
phones.sort((a, b) => a.data.year - b.data.year);

const brands = [...new Set(phones.map((p) => p.data.brand))].sort();
const years = [...new Set(phones.map((p) => p.data.year))].sort((a, b) => a - b);
const byYear = Map.groupBy(phones, (p) => p.data.year);
const eraStarts = [1998, 2002, 2005, 2007, 2011, 2019];
const eraForYear = (year: number) => eraStarts.findIndex((start, index) =>
  year === years.find((candidate) => candidate >= start && candidate < (eraStarts[index + 1] ?? Infinity)));
---

<section class="catalog-tools mb-8" data-filter-bar aria-label={editorial.filters}>
  <div class="catalog-filter-grid">
    <div class="catalog-search">
      <label class="filter-label" for="catalog-search">{editorial.modelSearch}</label>
      <div class="catalog-search-field">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <input id="catalog-search" type="search" name="q" placeholder={strings.filters.search} data-filter="search" autocomplete="off" />
      </div>
    </div>
    <FilterSelect name="brand" label={strings.filters.brand} all={strings.filters.all} search={editorial.optionSearch} empty={editorial.selectEmpty} options={brands} />
    <FilterSelect name="year" label={strings.filters.year} all={strings.filters.all} search={editorial.optionSearch} empty={editorial.selectEmpty} options={years.map(String)} />
  </div>
  <div class="catalog-filter-meta">
    <p data-filter-count data-count-label={strings.filters.shownCount} role="status" aria-live="polite"></p>
    <button type="button" data-filter-reset hidden>{strings.filters.reset} <span aria-hidden="true">×</span></button>
  </div>
</section>

<p class="hidden text-center text-neutral-500" data-filter-empty>{strings.filters.empty}</p>

<ol class="relative space-y-12 border-l border-neutral-800 pl-6 sm:pl-7" data-catalog-list>
  {years.map((year) => (
    <li id={`year-${year}`} data-year-group={year} class="relative scroll-mt-24">
      {eraForYear(year) >= 0 && (
        <div data-era-heading class="era-heading mb-6 border-t border-orange-500/50 pt-5">
          <p class="editorial-kicker text-orange-500">{eraStarts[eraForYear(year)]} — {eraStarts[eraForYear(year) + 1] ? eraStarts[eraForYear(year) + 1] - 1 : new Date().getFullYear()}</p>
          <h2 class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">{editorial.eras[eraForYear(year)]}</h2>
          <p class="mt-2 text-sm text-neutral-400">{editorial.eraNotes[eraForYear(year)]}</p>
        </div>
      )}
      <div class="mb-4 flex items-baseline gap-3 border-b border-neutral-800 pb-2">
        <span class="absolute -left-7 top-2.5 h-2 w-2 rounded-full bg-orange-500 sm:-left-8" aria-hidden="true"></span>
        <h2 class="text-2xl font-extrabold tracking-tight text-orange-500">{year}</h2>
        <span class="border border-neutral-800 px-1.5 py-0.5 text-xs text-neutral-500">
          {byYear.get(year)!.length}
        </span>
      </div>
      <ul class="grid auto-rows-fr items-stretch gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {byYear.get(year)!.map((phone) => (
          <li class="flex min-w-0">
            <PhoneCard phone={phone} locale={locale} />
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const list = document.querySelector<HTMLElement>('[data-catalog-list]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
  const count = document.querySelector<HTMLElement>('[data-filter-count]');
  const resetBtn = document.querySelector<HTMLButtonElement>('[data-filter-reset]');
  if (bar && list && empty && count) {
    const searchInput = bar.querySelector<HTMLInputElement>('[data-filter="search"]')!;
    const brandSelect = bar.querySelector<HTMLSelectElement>('[data-filter="brand"]')!;
    const yearSelect = bar.querySelector<HTMLSelectElement>('[data-filter="year"]')!;
    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-phone-card]'));
    const groups = Array.from(list.querySelectorAll<HTMLElement>('[data-year-group]'));

    const apply = () => {
      const q = searchInput.value.trim().toLowerCase();
      const brand = brandSelect.value;
      const year = yearSelect.value;
      let visible = 0;

      for (const card of cards) {
        const matches =
          (!q || card.dataset.search!.includes(q)) &&
          (!brand || card.dataset.brand === brand) &&
          (!year || card.dataset.year === year);
        card.closest('li')!.hidden = !matches;
        if (matches) visible++;
      }

      for (const group of groups) {
        const anyVisible = Array.from(group.querySelectorAll<HTMLElement>('[data-phone-card]')).some(
          (c) => !c.closest('li')!.hidden,
        );
        group.hidden = !anyVisible;
      }

      empty.classList.toggle('hidden', visible > 0);
      list.hidden = visible === 0;
      count.textContent = `${visible} ${count.dataset.countLabel}`;
      resetBtn!.hidden = !q && !brand && !year;
      list.querySelectorAll<HTMLElement>('[data-era-heading]').forEach((heading) => { heading.hidden = Boolean(q || brand || year); });
    };

    bar.addEventListener('input', apply);
    bar.addEventListener('change', apply);
    resetBtn?.addEventListener('click', () => {
      searchInput.value = '';
      brandSelect.value = '';
      yearSelect.value = '';
      brandSelect.dispatchEvent(new Event('change', { bubbles: true }));
      yearSelect.dispatchEvent(new Event('change', { bubbles: true }));
      apply();
    });

    apply();
  }
</script>
