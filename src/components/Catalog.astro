---
import PhoneCard from './PhoneCard.astro';
import FilterSelect from './FilterSelect.astro';
import { getPhonesForLocale } from '../lib/phones';
import { t, DESIGN_EDITORIAL, HOME_EDITORIAL, RETRO_DISCOVERY, CATALOG_POSITION } from '../lib/ui-strings';
import { RETRO_STORIES } from '../lib/editorial-stories';
import { FORM_FACTORS } from '../lib/form-factors';
import { localePath, type Locale } from '../lib/locales';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const strings = t(locale);
const editorial = DESIGN_EDITORIAL[locale];
const controls = {
  uk: { active: 'Активні фільтри', remove: 'Прибрати фільтр', empty: 'Спробуй прибрати одну з умов або повернути весь каталог.' },
  ru: { active: 'Активные фильтры', remove: 'Убрать фильтр', empty: 'Попробуй убрать одно из условий или вернуться ко всему каталогу.' },
  en: { active: 'Active filters', remove: 'Remove filter', empty: 'Remove a condition or return to the full catalog.' },
}[locale];
const stories = RETRO_STORIES.map((story, index) => ({ ...story, ...HOME_EDITORIAL[locale].themes[index] }));

const phones = await getPhonesForLocale(locale);
phones.sort((a, b) => a.data.year - b.data.year);

const brands = [...new Set(phones.map((p) => p.data.brand))].sort();
const years = [...new Set(phones.map((p) => p.data.year))].sort((a, b) => a - b);
const byYear = Map.groupBy(phones, (p) => p.data.year);
const eraStarts = [1998, 2002, 2005, 2007, 2011, 2019];
const eraForYear = (year: number) => eraStarts.findIndex((start, index) =>
  year === years.find((candidate) => candidate >= start && candidate < (eraStarts[index + 1] ?? Infinity)));
---

<section id="catalog-filters" class="catalog-tools mb-5 scroll-mt-20" data-filter-bar data-stories={JSON.stringify(stories)} aria-label={editorial.filters}>
  <button type="button" class="catalog-filter-toggle" data-filter-toggle aria-expanded="true" aria-controls="catalog-filter-fields catalog-filter-stories" hidden>
    <span>{editorial.filters} <span data-active-count class="ml-1 text-orange-500"></span></span>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 9 6 6 6-6" /></svg>
  </button>
  <div id="catalog-filter-fields" class="catalog-filter-grid">
    <div class="catalog-search">
      <label class="filter-label" for="catalog-search">{editorial.modelSearch}</label>
      <div class="catalog-search-field">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <input id="catalog-search" type="search" name="q" placeholder={strings.filters.search} data-filter="search" autocomplete="off" />
      </div>
    </div>
    <FilterSelect name="brand" label={strings.filters.brand} all={strings.filters.all} search={editorial.optionSearch} empty={editorial.selectEmpty} options={brands} />
    <FilterSelect name="year" label={strings.filters.year} all={strings.filters.all} search={editorial.optionSearch} empty={editorial.selectEmpty} options={years.map(String)} />
    <FilterSelect name="form" label={strings.specs.formFactor} all={strings.filters.all} search={editorial.optionSearch} empty={editorial.selectEmpty} options={FORM_FACTORS.filter((value) => phones.some((phone) => phone.data.formFactor === value)).map((value) => ({ value, label: strings.formFactors[value] }))} />
  </div>
  <div class="catalog-filter-footer">
    <nav id="catalog-filter-stories" class="catalog-stories flex flex-wrap gap-2" aria-label={RETRO_DISCOVERY[locale].collections}>
      <a href={localePath(locale, '/catalog/')} data-story-filter="" aria-current="true">{strings.filters.all}</a>
      {stories.map((story) => <a href={localePath(locale, '/catalog/') + '?story=' + story.id} data-story-filter={story.id}>{story.title}<span class="ml-2 text-neutral-500">{story.slugs.length}</span></a>)}
    </nav>
    <div class="catalog-filter-meta">
      <p data-filter-count data-count-label={strings.filters.shownCount} role="status" aria-live="polite">{phones.length} {strings.filters.shownCount}</p>
      <button type="button" data-filter-reset hidden>{strings.filters.reset} <span aria-hidden="true">×</span></button>
    </div>
  </div>
  <p data-story-description hidden class="mt-3 text-sm leading-relaxed text-neutral-400"></p>
  <div data-active-filters data-remove-label={controls.remove} role="group" aria-label={controls.active} class="catalog-active-filters" hidden></div>
</section>

<div class="hidden text-center text-neutral-400" data-filter-empty>
  <p class="text-lg font-bold text-neutral-100">{strings.filters.empty}</p>
  <p class="mt-2 text-sm leading-relaxed">{controls.empty}</p>
  <button class="control-button mt-5 text-sm" type="button" data-empty-reset>{strings.filters.reset}</button>
</div>

<nav data-catalog-position class="catalog-position" hidden aria-label={CATALOG_POSITION[locale].label}
  data-locale={locale} data-count-one={strings.brands.phoneCount.one}
  data-count-few={'few' in strings.brands.phoneCount ? strings.brands.phoneCount.few : strings.brands.phoneCount.many}
  data-count-many={strings.brands.phoneCount.many}>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <div class="flex min-w-0 items-baseline gap-3">
      <span class="editorial-kicker text-neutral-500">{strings.filters.year}</span>
      <strong data-current-year class="text-xl font-extrabold tabular-nums text-orange-500"></strong>
      <span data-current-year-count class="truncate text-xs text-neutral-400"></span>
    </div>
    <a href="#catalog-filters" class="inline-flex min-h-11 shrink-0 items-center gap-2 text-xs font-semibold text-neutral-300 hover-desktop:text-orange-500">{CATALOG_POSITION[locale].filters}<span aria-hidden="true">↑</span></a>
  </div>
</nav>

<ol class="catalog-timeline relative space-y-6 border-l border-neutral-800 pl-4 sm:pl-6" data-catalog-list>
  {years.map((year) => (
    <li id={`year-${year}`} data-year-group={year} class="relative scroll-mt-24">
      {eraForYear(year) >= 0 && (
        <div data-era-heading class="era-heading mb-6 border-t border-orange-500/50 pt-5">
          <p class="editorial-kicker text-orange-500">{eraStarts[eraForYear(year)]} — {eraStarts[eraForYear(year) + 1] ? eraStarts[eraForYear(year) + 1] - 1 : new Date().getFullYear()}</p>
          <h2 class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">{editorial.eras[eraForYear(year)]}</h2>
          <p class="mt-2 text-sm text-neutral-400">{editorial.eraNotes[eraForYear(year)]}</p>
        </div>
      )}
      <div data-year-heading class="mb-3 flex items-baseline gap-3 border-b border-neutral-800 pb-2">
        <span class="absolute -left-5 top-2.5 h-2 w-2 rounded-full bg-orange-500 sm:-left-7" aria-hidden="true"></span>
        <h2 class="text-2xl font-extrabold tracking-tight text-orange-500">{year}</h2>
        <span data-year-count class="border border-neutral-800 px-1.5 py-0.5 text-xs text-neutral-500">
          {byYear.get(year)!.length}
        </span>
      </div>
      <ul class="grid grid-cols-2 auto-rows-fr items-stretch gap-2.5 sm:grid-cols-3 sm:gap-3 lg:grid-cols-4 xl:grid-cols-5">
        {byYear.get(year)!.map((phone) => (
          <li class="flex min-w-0">
            <PhoneCard phone={phone} locale={locale} compact />
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>

<script>
  import { initCatalogPosition } from '../scripts/catalog-position';
  const position = initCatalogPosition();
  const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const list = document.querySelector<HTMLElement>('[data-catalog-list]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
  const count = document.querySelector<HTMLElement>('[data-filter-count]');
  const resetBtn = document.querySelector<HTMLButtonElement>('[data-filter-reset]');
  if (bar && list && empty && count) {
    const searchInput = bar.querySelector<HTMLInputElement>('[data-filter="search"]')!;
    const brandSelect = bar.querySelector<HTMLSelectElement>('[data-filter="brand"]')!;
    const yearSelect = bar.querySelector<HTMLSelectElement>('[data-filter="year"]')!;
    const formSelect = bar.querySelector<HTMLSelectElement>('[data-filter="form"]')!;
    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-phone-card]'));
    const groups = Array.from(list.querySelectorAll<HTMLElement>('[data-year-group]'));
    const stories: { id: string; slugs: string[]; text: string }[] = JSON.parse(bar.dataset.stories!);
    const storyLinks = Array.from(bar.querySelectorAll<HTMLAnchorElement>('[data-story-filter]'));
    const description = bar.querySelector<HTMLElement>('[data-story-description]')!;
    const activeFilters = bar.querySelector<HTMLElement>('[data-active-filters]')!;
    const toggle = bar.querySelector<HTMLButtonElement>('[data-filter-toggle]')!;
    toggle.hidden = false;
    const mobileFilters = window.matchMedia('(max-width: 639px)');
    const setExpanded = (expanded: boolean) => {
      bar.dataset.expanded = String(expanded);
      toggle.setAttribute('aria-expanded', String(expanded));
      if (!expanded) document.dispatchEvent(new CustomEvent('catalog-select-open', { detail: null }));
    };
    setExpanded(!mobileFilters.matches);
    mobileFilters.addEventListener('change', () => setExpanded(!mobileFilters.matches));
    toggle.addEventListener('click', () => setExpanded(bar.dataset.expanded !== 'true'));
    let activeStory = '';

    const apply = () => {
      const q = searchInput.value.trim().toLowerCase();
      const brand = brandSelect.value;
      const year = yearSelect.value;
      const form = formSelect.value;
      const story = stories.find((item) => item.id === activeStory);
      let visible = 0;

      for (const card of cards) {
        const matches =
          (!q || card.dataset.search!.includes(q)) &&
          (!brand || card.dataset.brand === brand) &&
          (!year || card.dataset.year === year) && (!form || card.dataset.form === form) &&
          (!story || story.slugs.includes(card.dataset.slug!));
        card.closest('li')!.hidden = !matches;
        if (matches) visible++;
      }

      for (const group of groups) {
        const visibleCards = Array.from(group.querySelectorAll<HTMLElement>('[data-phone-card]')).filter(
          (c) => !c.closest('li')!.hidden,
        );
        group.hidden = visibleCards.length === 0;
        group.querySelector<HTMLElement>('[data-year-count]')!.textContent = String(visibleCards.length);
      }

      empty.classList.toggle('hidden', visible > 0);
      list.hidden = visible === 0;
      count.textContent = `${visible} ${count.dataset.countLabel}`;
      resetBtn!.hidden = !q && !brand && !year && !story && !form;
      const conditions = [
        { key: 'q', value: searchInput.value.trim(), label: searchInput.labels?.[0]?.textContent ?? '' },
        ...[brandSelect, yearSelect, formSelect].map((select) => ({ key: select.name, value: select.value ? select.selectedOptions[0].textContent! : '', label: select.getAttribute('aria-label') ?? '' })),
        { key: 'story', value: story ? storyLinks.find((link) => link.dataset.storyFilter === story.id)?.textContent?.replace(/\d+\s*$/, '').trim() ?? '' : '', label: '' },
      ].filter((condition) => condition.value);
      activeFilters.replaceChildren(...conditions.map((condition) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.clearFilter = condition.key;
        button.textContent = `${condition.label ? condition.label + ': ' : ''}${condition.value}`;
        button.setAttribute('aria-label', `${activeFilters.dataset.removeLabel}: ${button.textContent}`);
        const cross = document.createElement('span');
        cross.setAttribute('aria-hidden', 'true'); cross.textContent = '×'; button.append(cross);
        return button;
      }));
      activeFilters.hidden = conditions.length === 0;
      toggle.querySelector('[data-active-count]')!.textContent = conditions.length ? `(${conditions.length})` : '';
      description.hidden = !story;
      description.textContent = story?.text ?? '';
      storyLinks.forEach((link) => {
        if (link.dataset.storyFilter === activeStory) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
      list.querySelectorAll<HTMLElement>('[data-era-heading]').forEach((heading) => { heading.hidden = Boolean(q || brand || year || story || form); });
      const url = new URL(window.location.href);
      for (const [key, value] of [['q', searchInput.value.trim()], ['brand', brand], ['year', year], ['story', activeStory], ['form', form]]) {
        if (value) url.searchParams.set(key, value);
        else url.searchParams.delete(key);
      }
      window.history.replaceState(null, '', url.pathname + url.search + url.hash);
      position?.refresh();
    };

    bar.addEventListener('input', apply);
    bar.addEventListener('change', apply);
    activeFilters.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-clear-filter]');
      if (!button) return;
      const index = Array.from(activeFilters.children).indexOf(button);
      const key = button.dataset.clearFilter;
      if (key === 'q') searchInput.value = '';
      else if (key === 'story') activeStory = '';
      else {
        const select = [brandSelect, yearSelect, formSelect].find((select) => select.name === key);
        if (select) { select.value = ''; select.dispatchEvent(new Event('change', { bubbles: true })); }
      }
      apply();
      (activeFilters.querySelectorAll<HTMLButtonElement>('button')[Math.min(index, activeFilters.children.length - 1)] ?? searchInput).focus();
    });
    storyLinks.forEach((link) => link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      activeStory = link.dataset.storyFilter!;
      apply();
    }));
    const clearAll = () => {
      searchInput.value = '';
      brandSelect.value = '';
      yearSelect.value = '';
      formSelect.value = '';
      activeStory = '';
      brandSelect.dispatchEvent(new Event('change', { bubbles: true }));
      yearSelect.dispatchEvent(new Event('change', { bubbles: true }));
      formSelect.dispatchEvent(new Event('change', { bubbles: true }));
      apply();
      searchInput.focus();
    };
    resetBtn?.addEventListener('click', clearAll);
    empty.querySelector('[data-empty-reset]')?.addEventListener('click', clearAll);

    const restore = () => {
      const params = new URLSearchParams(window.location.search);
      searchInput.value = params.get('q') ?? '';
      brandSelect.value = params.get('brand') ?? '';
      yearSelect.value = params.get('year') ?? '';
      formSelect.value = params.get('form') ?? '';
      activeStory = stories.some((story) => story.id === params.get('story')) ? params.get('story')! : '';
      brandSelect.dispatchEvent(new Event('change', { bubbles: true }));
      yearSelect.dispatchEvent(new Event('change', { bubbles: true }));
      formSelect.dispatchEvent(new Event('change', { bubbles: true }));
      apply();
    };
    window.addEventListener('popstate', restore);
    window.addEventListener('pageshow', (event) => { if (event.persisted) restore(); });
    restore();
  }
</script>
