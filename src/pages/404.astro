---
import Layout from '../layouts/Layout.astro';
import PlaceholderArt from '../components/PlaceholderArt.astro';
import { t } from '../lib/ui-strings';

const locale = 'uk' as const;
const strings = t(locale);
---

<Layout locale={locale} path="/404/" title={`${strings.notFound.title} — ${strings.siteName}`} description={strings.notFound.body}>
  <div class="flex flex-col items-center py-16 text-center">
    <PlaceholderArt class="h-32 w-full max-w-xs text-neutral-700" />
    <h1 class="page-title mt-6">404</h1>
    <p class="mt-2 text-neutral-400">{strings.notFound.body}</p>
    <a
      href="/"
      class="mt-6 inline-block rounded-sm bg-orange-500 px-5 py-2.5 text-sm font-semibold text-neutral-950 transition-all duration-200 hover-desktop:-translate-y-0.5 hover-desktop:bg-orange-400 hover-desktop:shadow-lg hover-desktop:shadow-orange-500/20"
    >
      {strings.notFound.link}
    </a>
  </div>
</Layout>
