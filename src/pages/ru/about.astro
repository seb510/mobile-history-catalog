---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../lib/ui-strings';

const locale = 'ru' as const;
const strings = t(locale);
---

<Layout locale={locale} path="/about/" title={`${strings.about.title} — ${strings.siteName}`} description={strings.footer.about}>
  <h1 class="text-3xl font-bold">{strings.about.title}</h1>
  <div class="prose prose-invert mt-6 max-w-2xl prose-p:text-neutral-300">
    {strings.about.paragraphs.map((p) => <p>{p}</p>)}
  </div>
</Layout>
