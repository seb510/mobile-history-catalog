---
import Layout from '../../../layouts/Layout.astro';
import PhoneDetail from '../../../components/PhoneDetail.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getAllSlugs, getPhone } from '../../../lib/phones';
import { slugifyBrandName } from '../../../lib/brands';
import { t } from '../../../lib/ui-strings';

const locale = 'ru' as const;

export async function getStaticPaths() {
  const slugs = await getAllSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const phone = await getPhone(locale, slug);
if (!phone) return Astro.redirect('/404');

const { data } = phone;
const strings = t(locale);
const title = `${data.brand} ${data.model} (${data.year}) — ${strings.siteName}`;
const description = data.milestone
  ? `${data.brand} ${data.model} (${data.year}): ${data.milestone}`
  : `${data.brand} ${data.model} (${data.year}) — ${strings.tagline}`;
---

<Layout locale={locale} path={`/phones/${slug}/`} title={title} description={description} ogImage={data.image} type="article">
  <Breadcrumbs locale={locale} items={[
    { label: strings.breadcrumbs.home, path: '/' },
    { label: strings.nav.catalog, path: '/catalog/' },
    { label: data.brand, path: `/brands/${slugifyBrandName(data.brand)}/` },
    { label: data.model },
  ]} />
  <PhoneDetail phone={phone} locale={locale} />
</Layout>
