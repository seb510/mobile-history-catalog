---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../lib/ui-strings';

const locale = 'en' as const;
const strings = t(locale);
---

<Layout locale={locale} path="/about/" title={`${strings.about.title} — ${strings.siteName}`} description={strings.footer.about}>
  <p class="inline-block rounded-full border border-orange-500/30 bg-orange-500/10 px-3 py-1 text-xs font-medium text-orange-400">
    {strings.siteName}
  </p>
  <h1 class="mt-4 border-l-2 border-orange-500 pl-3 text-3xl font-bold">{strings.about.title}</h1>
  <div class="prose prose-invert mt-6 max-w-2xl rounded-lg border border-neutral-800 p-6 prose-p:text-neutral-300 prose-p:first:text-lg prose-p:first:text-neutral-100">
    {strings.about.paragraphs.map((p) => <p>{p}</p>)}
  </div>
</Layout>
