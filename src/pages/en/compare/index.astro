---
import Layout from '../../../layouts/Layout.astro';
import Compare from '../../../components/Compare.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { t } from '../../../lib/ui-strings';

const locale = 'en' as const;
const strings = t(locale);
---

<Layout locale={locale} path="/compare/" title={`${strings.nav.compare} — ${strings.siteName}`} description={strings.compare.subtitle}>
  <Breadcrumbs locale={locale} items={[{ label: strings.breadcrumbs.home, path: '/' }, { label: strings.nav.compare }]} />
  <h1 class="page-title mb-2">{strings.nav.compare}</h1>
  <p class="mb-6 text-neutral-400">{strings.compare.subtitle}</p>
  <Compare locale={locale} />
</Layout>
