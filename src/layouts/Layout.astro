---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrivacyNotice from '../components/PrivacyNotice.astro';
import ClockWeather from '../components/ClockWeather.astro';
import { canonicalUrl, ogLocaleOf } from '../lib/seo';
import type { Locale } from '../lib/locales';
import { searchIdentity, searchEnabled } from '../lib/search-index';
import { searchCopy } from '../lib/search-copy';
import { getPhone } from '../lib/phones';
import { getBrand } from '../lib/brands';
import { t } from '../lib/ui-strings';
import StructuredData from '../components/StructuredData.astro';

interface Props {
  locale: Locale;
  /** Unprefixed path, e.g. "/", "/phones/nokia-3310/", "/about/" — same across all 3 locales. */
  path: string;
  title: string;
  description: string;
  /** Absolute or site-relative image URL; defaults to the site-wide share image. */
  ogImage?: string;
  type?: 'website' | 'article';
}
const { locale, path, title, description, ogImage = '/og-image.png', type = 'website' } = Astro.props;

const identity = await searchIdentity(Astro.site!, locale, path);
const canonical = canonicalUrl(Astro.site!, identity.canonicalLocale, path);
const alternates = path === '/404/' ? [] : identity.alternates;
const absoluteOgImage = new URL(ogImage, Astro.site).toString();
const strings = t(locale);
const copy = searchCopy[locale];
const staticCopy = copy[path as keyof typeof copy];
let searchTitle = Array.isArray(staticCopy) ? `${staticCopy[0]} — ${strings.siteName}` : title;
let searchDescription = Array.isArray(staticCopy) ? staticCopy[1] : description;
const phoneMatch = path.match(/^\/phones\/([^/]+)\/$/);
const brandMatch = path.match(/^\/brands\/([^/]+)\/$/);
let subject: Record<string, unknown> | undefined;
if (phoneMatch) {
  const phone = await getPhone(locale, phoneMatch[1]);
  if (phone) {
    const name = `${phone.data.brand} ${phone.data.model}`;
    searchTitle = `${name} (${phone.data.year}): ${copy.specs} — ${strings.siteName}`;
    subject = { '@type': 'Thing', name, description: phone.data.milestone, image: phone.data.image };
  }
}
if (brandMatch) {
  const brand = await getBrand(locale, brandMatch[1]);
  if (brand) {
    searchTitle = `${brand.data.name}: ${copy.brand} — ${strings.siteName}`;
    searchDescription = `${brand.data.name} — ${copy.brand}. ${strings.brands.indexSubtitle}`;
  }
}
const noindex = !searchEnabled || path === '/404/' || path === '/favorites/' || path === '/search/';
const pageType = path === '/about/' ? 'AboutPage' : path === '/catalog/' || path.startsWith('/brands/') ? 'CollectionPage' : 'WebPage';
const siteId = new URL('/#website', Astro.site).toString();
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': siteId, url: new URL('/', Astro.site).toString(), name: t('uk').siteName, alternateName: ['Mobile History', t('ru').siteName], inLanguage: ['uk', 'ru', 'en'] },
    { '@type': pageType, '@id': `${canonical}#webpage`, url: canonical, name: searchTitle, description: searchDescription, inLanguage: identity.canonicalLocale, isPartOf: { '@id': siteId }, ...(subject ? { about: subject } : {}) },
  ],
};
---

<html lang={locale}>
  <head>
    <script is:inline>
      // Apply a stored theme choice before first paint, so there's no flash of the wrong theme.
      // No stored choice = no attribute set = CSS falls through to the prefers-color-scheme rule.
      try {
        var choice = JSON.parse(localStorage.getItem('mobile-history:privacy') || 'null');
        var valid = choice?.version === 1 && choice.theme === true && typeof choice.at === 'number' && choice.at <= Date.now() && Date.now() - choice.at < 15552000000;
        var stored = valid ? localStorage.getItem('theme') : null;
        if (stored === 'light' || stored === 'dark') document.documentElement.dataset.theme = stored;
      } catch (e) {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{searchTitle}</title>
    <meta name="description" content={searchDescription} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {path !== '/404/' && <StructuredData data={schema} />}

    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.locale} href={alt.href} />
    ))}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={searchTitle} />
    <meta property="og:description" content={searchDescription} />
    <meta property="og:site_name" content={strings.siteName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={subject ? String(subject.name) : strings.siteName} />
    <meta property="og:locale" content={ogLocaleOf(locale)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={searchTitle} />
    <meta name="twitter:description" content={searchDescription} />
    <meta name="twitter:image" content={absoluteOgImage} />
  </head>
  <body class="flex min-h-screen flex-col bg-neutral-950 text-neutral-100 antialiased">
    <Header locale={locale} path={path} />
    <ClockWeather locale={locale} />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 sm:py-10">
      <slot />
    </main>
    <Footer locale={locale} />
    <PrivacyNotice locale={locale} path={path} />
    <script is:inline>
      document.querySelectorAll('a[href]').forEach((link) => {
        try {
          const url = new URL(link.href, window.location.href);
          if (url.origin !== window.location.origin && ['http:', 'https:'].includes(url.protocol)) {
            link.target = '_blank';
            link.relList.add('noopener', 'noreferrer');
          }
        } catch {}
      });
    </script>
    <script>
      import '../scripts/image-fallback';
      import '../scripts/favorites';
    </script>
  </body>
</html>
