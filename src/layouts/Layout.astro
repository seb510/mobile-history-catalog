---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { alternateLinks, canonicalUrl, ogLocaleOf } from '../lib/seo';
import type { Locale } from '../lib/locales';

interface Props {
  locale: Locale;
  /** Unprefixed path, e.g. "/", "/phones/nokia-3310/", "/about/" — same across all 3 locales. */
  path: string;
  title: string;
  description: string;
  /** Absolute or site-relative image URL; defaults to the site-wide share image. */
  ogImage?: string;
  type?: 'website' | 'article';
}
const { locale, path, title, description, ogImage = '/og-image.png', type = 'website' } = Astro.props;

const canonical = canonicalUrl(Astro.site!, locale, path);
const alternates = alternateLinks({ site: Astro.site!, path });
const absoluteOgImage = new URL(ogImage, Astro.site).toString();
---

<html lang={locale}>
  <head>
    <script is:inline>
      // Apply a stored theme choice before first paint, so there's no flash of the wrong theme.
      // No stored choice = no attribute set = CSS falls through to the prefers-color-scheme rule.
      try {
        var stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') document.documentElement.dataset.theme = stored;
      } catch (e) {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.locale} href={alt.href} />
    ))}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:locale" content={ogLocaleOf(locale)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
  </head>
  <body class="flex min-h-screen flex-col bg-neutral-950 text-neutral-100 antialiased">
    <Header locale={locale} path={path} />
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
